import { Theme, Icons } from "theme.slint";

// The pieces the window is built from. Everything here draws itself rather
// than wrapping a std-widget, so that hover, press and disabled states behave
// the same way in every corner of the app.

// A Lucide glyph, recolored.
export component Icon inherits Image {
    in property <image> glyph;
    in property <brush> tint: Theme.text;

    // Decoration, not content. Slint gives anything that is an Image a role of
    // its own, so left alone every glyph in the app is a nameless graphic —
    // seventy of them, measured — and inside a button it is a second node
    // beside the name the button already carries. Suppressed on the base, so
    // one line covers every use.
    accessible-role: none;

    source: root.glyph;
    // colorize treats the SVG as an alpha mask and paints it in `tint`, so one
    // copy of each glyph serves every color the theme has.
    colorize: root.tint;
    image-fit: contain;
    width: 18px;
    height: 18px;
}

// A round button with a glyph in it. The transport controls, and every small
// affordance that would otherwise need a word.
export component IconButton inherits Rectangle {
    in property <image> glyph;
    in property <bool> enabled: true;
    // Filled with the accent rather than drawn on the surface. One per screen:
    // the thing you press without looking.
    in property <bool> primary: false;
    in property <bool> active: false;
    in property <length> size: 34px;
    in property <length> glyph-size: 17px;
    in property <brush> tint: Theme.dim;
    // What the button is called, for anything that cannot see the glyph.
    //
    // A property rather than something derived, because a glyph is not a name:
    // the same waste basket clears a queue in one place and a list of recent
    // stations in another, and `Icons.close` is "Stop editing" on one screen
    // and "Clear the search box" on the next. Only the call site knows.
    //
    // Defaulted to empty so an unnamed button is silent rather than wrong, and
    // so this stays additive.
    in property <string> label;
    callback clicked();

    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    // Guarded, and the guard is the only thing here that actually refuses the
    // press. Two separate reasons, both measured on the running app:
    //
    // The winit bridge decides "disabled" and "has a click action" from two
    // independent tests, so a disabled node is still sent the click — and this
    // action calls the callback directly, reaching past the TouchArea whose
    // `enabled` would otherwise have stopped it.
    //
    // And `accessible-enabled` does not reach AT-SPI here at all: hardcoded to
    // false on this component, all twenty-seven buttons still reported
    // themselves enabled. It is declared because it is the right thing to say
    // and costs nothing if a later Slint carries it; nothing is relying on it.
    //
    // Without the guard, the transport — disabled exactly when the player
    // cannot answer — would take a press and ask an unreachable player anyway.
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }

    width: root.size;
    height: root.size;
    border-radius: self.height / 2;

    // A disabled *primary* keeps its shape. Dropping every disabled button to
    // transparent left the play control as an empty space in the middle of the
    // transport on every cold start — the app's most important button, missing
    // rather than unavailable, at the moment a stranger is deciding whether the
    // app works. Secondary buttons have no fill to lose and still fade out.
    background: !root.enabled
        ? (root.primary ? Theme.raised : transparent)
        : (root.primary
            ? (touch.pressed ? Theme.accent-hover : Theme.accent)
            : (root.active
                ? Theme.accent-soft
                : (touch.pressed ? Theme.pressed : (touch.has-hover ? Theme.hover : transparent))));

    // Short enough not to lag the pointer, long enough not to flicker on a
    // list where the pointer crosses several rows at once.
    animate background { duration: Theme.quick; easing: ease-out; }

    opacity: root.enabled ? 1.0 : (root.primary ? 0.72 : 0.35);
    animate opacity { duration: Theme.quick; }

    Icon {
        glyph: root.glyph;
        width: root.glyph-size;
        height: root.glyph-size;
        tint: root.primary
            ? (root.enabled ? Theme.accent-ink : Theme.faint)
            : (root.active ? Theme.accent : (touch.has-hover ? Theme.text : root.tint));
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// A text button, optionally with a glyph before the label.
// Rounded rectangle rather than a pill, matching the panels, rows and tiles
// it sits among. The name is left as it was: renaming it would touch every
// call site for nothing.
export component PillButton inherits Rectangle {
    in property <string> label;
    in property <image> glyph;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    callback clicked();

    // Which answer of a set this is, and which of the set the keyboard is on.
    //
    // Only a `Modal` sets them, and it sets the second on every button of its
    // card at once: the one whose seat is named takes the caret. Two numbers
    // rather than a flag because a question opens on the same button every
    // time, and a flag that is already true fires nothing. The defaults
    // cannot match, so every other button in the window is a plain tab stop
    // and nothing reaches for the caret on its own.
    in property <int> seat: -1;
    in property <int> seated: -2;

    function claim() {
        if (root.seat == root.seated && root.enabled) {
            keys.focus();
        }
    }

    // On creation as well as on the change: the card is built when its
    // question opens, so the seat it opens on never changes afterwards and
    // `changed` alone would leave the first question of the session with no
    // button focused at all.
    init => { root.claim(); }
    changed seated => { root.claim(); }

    // The label it already draws is the name it already has.
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }

    height: 30px;
    width: content.preferred-width + 26px;
    border-radius: Theme.radius-small;

    background: root.primary
        ? (touch.pressed ? Theme.accent-hover : Theme.accent)
        : (touch.pressed ? Theme.pressed : (touch.has-hover ? Theme.hover : transparent));
    // The ring says where the keyboard is. On a plain button the accent reads
    // against the card it sits on; on a primary one that would be the accent
    // drawn on the accent, so the ring there is the button's own ink. Slint
    // draws a border inside the shape, so neither of them moves the label.
    border-width: keys.has-focus ? 2px : (root.primary ? 0px : 1px);
    border-color: keys.has-focus
        ? (root.primary ? Theme.accent-ink : Theme.accent)
        : Theme.border;
    animate background { duration: Theme.quick; easing: ease-out; }
    opacity: root.enabled ? 1.0 : 0.35;

    // What makes a button answerable without a mouse.
    //
    // Without one, nothing on a dialog could take the caret: the window's own
    // key handler passed everything but Escape on to a focused button and
    // there was never a focused button to pass it to, so the firmware
    // question — which ignores Escape on purpose — had no keyboard answer at
    // all.
    //
    // Enter and the space bar, which is what every toolkit's buttons answer
    // to. The space bar pauses the player everywhere else in the window; a
    // focused button is the one place it must not, and it does not reach the
    // window's handler while this holds the caret.
    //
    // `focus-on-click` stays off: a press already does what the button is
    // for, and moving the caret onto a button that is about to close the
    // question it is on leaves the card's own idea of which seat is taken
    // pointing at the wrong one.
    keys := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;

        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                // Guarded for the reason the default action is: `enabled` on
                // the scope keeps the caret away, but a button disabled while
                // it already held it is still the focused item.
                if (root.enabled) {
                    root.clicked();
                }
                return EventResult.accept;
            }
            return EventResult.reject;
        }
    }

    content := HorizontalLayout {
        alignment: center;
        spacing: 6px;
        padding-left: 13px;
        padding-right: 13px;

        // Centered by its own layout: a fixed-size child of a row is not
        // centered against the taller text beside it, which left every glyph on
        // the queue's buttons riding above its label.
        if root.glyph.width > 0: VerticalLayout {
            alignment: center;

            Icon {
                glyph: root.glyph;
                width: 14px;
                height: 14px;
                tint: root.primary ? Theme.accent-ink : Theme.dim;
            }
        }

        Text {
            // The button above is already named after this string; left as a
            // text node it is read out a second time as the button's contents.
            // Slint's own Button silences its caption for the same reason.
            accessible-role: none;
            text: root.label;
            font-size: Theme.body-size;
            color: root.primary ? Theme.accent-ink : Theme.text;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Everything a question laid over the window has to do besides ask it.
//
// The card in the middle stays with each question — the firmware warning is
// wider than the input one, the player's own dialog stretches its buttons
// across the card instead of centering a pair — but being modal is the same
// job every time and was written out four times over. They drifted, as four
// copies do: not one of them stopped the wheel, so the list underneath went
// on scrolling and asking the player for more pages behind a question nobody
// could see past, and not one of them held the keyboard, so Tab walked out of
// the card into the controls under the scrim.
//
// Put the card inside one of these and it gets the veil, the pointer, the
// wheel, Escape where Escape is wanted, and a Tab that goes round the
// answers rather than out of them.
export component Modal inherits Rectangle {
    // The veil itself. The queue's menu passes `transparent`: it is anchored
    // to the row it came from and dimming the window for it would say
    // something much larger than "here are six things you can do to this
    // track".
    in property <brush> shade: Theme.scrim;
    // Whether clicking past the card, or pressing Escape, answers it. The
    // firmware question says no on purpose: answering that one by clicking
    // away is not a thing to make easy.
    in property <bool> dismissable: true;
    // What the way out is called, for anyone reading the window rather than
    // looking at it.
    in property <string> dismiss-label: "Dismiss";
    // How many answers the card carries, so Tab can go round them instead of
    // walking off into the window behind. Zero is a card with nothing to
    // press — the queue's menu, whose rows are its own — and Tab then simply
    // stays put.
    in property <int> buttons: 0;
    // Which answer opens with the caret: the one that changes nothing, so
    // Enter on a question that has only just appeared never installs
    // firmware or stops the music.
    in property <int> safe: 0;
    // Which of them has it now. The card binds every button's `seated` to
    // this and gives each one its `seat`.
    out property <int> at: root.safe;
    callback dismissed();

    background: root.shade;

    // Two of these rather than one with a conditional role: `accessible-role`
    // has to be a constant, and a scrim that cannot be clicked through must
    // not announce itself as the way out.
    //
    // The wheel is handled either way, and separately from the presses: a
    // `TouchArea` alone does not stop a wheel, which is how scrolling over a
    // question went on paging the list beneath it.
    if root.dismissable: TouchArea {
        accessible-role: button;
        accessible-label: root.dismiss-label;
        accessible-action-default => { root.dismissed(); }
        clicked => { root.dismissed(); }
        scroll-event(e) => { return accept; }
    }
    if !root.dismissable: TouchArea {
        scroll-event(e) => { return accept; }
    }

    trap := FocusScope {
        // Never by clicking. This scope is declared last, so it is in front of
        // the dismissing area above and covers the same whole veil — and a
        // scope that takes the caret on click *accepts* the press that gave it
        // to it: Slint walks the children front to back and stops at the first
        // one to accept. So the first click on the dimmed area landed here
        // rather than on the area behind it, and the question stayed up. Worse,
        // the caret had moved off the safe button onto this, which answers
        // every key but Escape and Tab with `accept`, so Enter no longer
        // answered the question either: clicking away from "Playing replaces
        // Play Queue" did nothing at all until it was clicked a second time.
        //
        // It still takes the caret below, where there is no button to hand it
        // to. That is the only way it should ever get it.
        focus-on-click: false;

        // The keyboard, for as long as the question is up. It sits above the
        // card rather than beside it so that whatever the focused button
        // rejects arrives here — Slint offers a key to the focused item and
        // then to each of its parents in turn.
        //
        // Only where no button will take the caret. A card with answers on it
        // hands the keyboard to its safe one as it is built, and this taking
        // the focus as well would be a race between two `init`s.
        init => {
            if (root.buttons <= 0) {
                self.focus();
            }
        }

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (root.dismissable) {
                    root.dismissed();
                }
                // Swallowed either way. The screen behind the question is not
                // the thing Escape is nearest to, and the one question that
                // refuses to be dismissed refuses it silently rather than by
                // walking back through the browse trail.
                return EventResult.accept;
            }
            if (event.text == Key.Tab || event.text == Key.Backtab) {
                if (root.buttons > 0) {
                    // Backwards without going negative, since the step is
                    // taken modulo the count.
                    let step = event.text == Key.Backtab || event.modifiers.shift
                        ? root.buttons - 1
                        : 1;
                    root.at = Math.mod(root.at + step, root.buttons);
                }
                return EventResult.accept;
            }
            // And nothing else reaches past the scrim either: the space bar
            // must not pause the player through a question, and a letter must
            // not page a list nobody can see.
            return EventResult.accept;
        }

        @children
    }
}

// Two mutually exclusive views sharing one panel. A pair of buttons would say
// "two actions"; this says "one thing, seen two ways".
export component Segmented inherits Rectangle {
    in property <string> first;
    in property <string> second;
    in property <image> first-glyph;
    in property <image> second-glyph;
    in-out property <int> index: 0;
    callback changed(int);

    height: 30px;
    border-radius: Theme.radius-small;
    background: Theme.sunken;

    HorizontalLayout {
        padding: 2px;
        spacing: 2px;

        for entry[i] in [
            { label: root.first, glyph: root.first-glyph },
            { label: root.second, glyph: root.second-glyph },
        ]: Rectangle {
            border-radius: Theme.radius-small;
            background: root.index == i
                ? Theme.raised
                : (segment.has-hover ? Theme.hover : transparent);
            animate background { duration: Theme.quick; easing: ease-out; }

            HorizontalLayout {
                alignment: center;
                spacing: 6px;
                padding-left: 12px;
                padding-right: 12px;

                Icon {
                    glyph: entry.glyph;
                    width: 14px;
                    height: 14px;
                    tint: root.index == i ? Theme.accent : Theme.faint;
                }

                Text {
                    text: entry.label;
                    font-size: Theme.small-size;
                    font-weight: root.index == i ? 600 : 400;
                    color: root.index == i ? Theme.text : Theme.dim;
                    vertical-alignment: center;
                }
            }

            segment := TouchArea {
                clicked => {
                    root.index = i;
                    root.changed(i);
                }
            }
        }
    }
}

// What a pane says when it has nothing to show.
//
// Extracted because the app had exactly one of these and it only ever appeared
// when the *player* volunteered an info panel — so every place the app itself
// had nothing (no speakers yet, an empty queue, a search that found nothing)
// was blank space. Blank space reads as broken; a sentence reads as an answer.
//
// Three sizes of type, because an empty state is a small piece of writing and
// not a label: the headline says what is true, the line under it says what to
// do about it, and the glyph is there so the eye has somewhere to land first.
export component EmptyState inherits VerticalLayout {
    in property <image> glyph: Icons.info;
    in property <string> headline;
    in property <string> detail;
    // Draws the glyph as a soft pulse rather than a static tile, for the states
    // that are waiting on something rather than reporting a conclusion.
    in property <bool> working: false;

    alignment: center;
    spacing: Theme.pad;
    padding-left: 48px;
    padding-right: 48px;

    HorizontalLayout {
        alignment: center;

        Rectangle {
            width: 58px;
            height: 58px;
            border-radius: Theme.radius;
            background: Theme.raised;

            Icon {
                glyph: root.glyph;
                tint: root.working ? Theme.accent : Theme.faint;
                width: 26px;
                height: 26px;

                // Slow enough to read as breathing rather than blinking. Only
                // while something is actually happening — a state that has
                // finished should hold still.
                opacity: root.working ? 0.45 : 1.0;
                animate opacity {
                    duration: 1100ms;
                    easing: ease-in-out;
                    iteration-count: root.working ? -1 : 1;
                    direction: alternate;
                }
            }
        }
    }

    Text {
        text: root.headline;
        // The headline of an empty state is the thing being said, so it is
        // said at the weight of a title in the app's ordinary ink — not, as
        // this was, one pixel above body size in the dim gray used for
        // captions.
        font-size: Theme.title-size;
        font-weight: 600;
        color: Theme.text;
        horizontal-alignment: center;
        wrap: word-wrap;
    }

    if root.detail != "": HorizontalLayout {
        alignment: center;

        Text {
            text: root.detail;
            font-size: Theme.body-size;
            color: Theme.dim;
            horizontal-alignment: center;
            wrap: word-wrap;
            // A measure, so a long sentence sets as a paragraph rather than
            // running the width of the pane.
            max-width: 360px;
        }
    }
}

// A seek bar. Drawn rather than borrowed from std-widgets, because a slider
// with a knob on it looks like a setting, and this is a position.
export component Scrubber inherits Rectangle {
    // 0 to 1.
    in property <float> value;
    in property <bool> enabled: true;
    // How long the fill takes to reach a new value.
    //
    // Off by default, because most of these answer a press and should look
    // instant — the volume must not lag the button that set it. The transport
    // asks for a second, which is exactly the interval its position arrives
    // on, so a value that steps once a second is drawn as continuous motion.
    in property <duration> glide: 0ms;
    // Whether a press anywhere on the track jumps straight to that point.
    //
    // Right for the transport, where clicking a third of the way along a song
    // means "go there". Wrong for volume, where the bar sits under the pointer
    // on the way to the buttons beside it and a stray click is a room suddenly
    // at full volume. With this off the bar still drags, but only deliberately.
    in property <bool> jump-to-click: true;
    // What this one is a scrubber for. Two of them exist and they are not
    // interchangeable — one is a position in a song and the other is a room's
    // volume — so the name comes from the call site.
    in property <string> label;
    // How much one increment or decrement is worth, as a fraction. A twentieth
    // is the useful step for both: five percent of a volume, and about fifteen
    // seconds of a five-minute song.
    in property <float> keyboard-step: 0.05;
    callback seek(float);

    // A slider rather than a progress bar, because it is one: it takes a value
    // as well as reporting one. The increment and decrement actions are how it
    // is set without a pointer, which is the whole of seeking for anyone who
    // cannot drag a 4px track.
    accessible-role: slider;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-value: Math.round(root.shown * 100);
    accessible-value-minimum: 0;
    accessible-value-maximum: 100;
    accessible-value-step: Math.round(root.keyboard-step * 100);
    accessible-action-increment => {
        if (root.enabled) {
            root.seek(Math.clamp(root.shown + root.keyboard-step, 0, 1));
        }
    }
    accessible-action-decrement => {
        if (root.enabled) {
            root.seek(Math.clamp(root.shown - root.keyboard-step, 0, 1));
        }
    }

    height: 18px;
    // While a drag is in progress the bar follows the pointer, not the player:
    // the player is a second behind and would drag the handle back.
    property <bool> dragging: false;
    property <float> preview: 0;
    property <float> shown: root.dragging ? root.preview : Math.clamp(root.value, 0, 1);

    track := Rectangle {
        y: (parent.height - 4px) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.track;

        Rectangle {
            x: 0;
            width: parent.width * root.shown;
            height: parent.height;
            border-radius: 2px;
            background: root.enabled ? Theme.accent : Theme.faint;

            // Never while dragging: the bar is following the pointer then, and
            // easing towards it would feel like a lag rather than a glide.
            animate width {
                duration: root.dragging ? 0ms : root.glide;
                easing: linear;
            }
        }
    }

    // The handle appears on hover or while dragging. At rest the bar is a
    // line, which is all it needs to be.
    Rectangle {
        x: track.width * root.shown - self.width / 2;
        y: (parent.height - self.height) / 2;
        width: 11px;
        height: 11px;
        border-radius: self.height / 2;
        background: Theme.accent;
        opacity: root.enabled && (touch.has-hover || root.dragging) ? 1.0 : 0.0;
        animate opacity { duration: Theme.quick; }

        // The same glide the fill has. Without it the handle stepped once a
        // second while the line beside it slid, so hovering a playing track
        // showed the two coming apart and catching up over and over.
        animate x {
            duration: root.dragging ? 0ms : root.glide;
            easing: linear;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        moved => {
            if (self.pressed) {
                // A press that has traveled is a drag whatever the mode, so
                // the handle can always be taken hold of and moved.
                if (root.jump-to-click || Math.abs(self.mouse-x - self.pressed-x) > 3px) {
                    root.dragging = true;
                }
                if (root.dragging) {
                    root.preview = Math.clamp(self.mouse-x / root.width, 0, 1);
                }
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up) {
                // A tap that never became a drag is only committed where a tap
                // is meant to mean something.
                if (root.dragging || root.jump-to-click) {
                    root.seek(Math.clamp(self.mouse-x / root.width, 0, 1));
                }
                root.dragging = false;
            }
        }
    }
}

// Volume: an icon that doubles as the mute button, and a level.
export component Level inherits HorizontalLayout {
    in property <int> value;
    in property <bool> muted: false;
    // False while the player cannot answer — upgrading its firmware, or simply
    // not there. The controls are drawn faded and take no presses, because a
    // volume that silently does nothing reads as the app being broken.
    in property <bool> enabled: true;
    // What one press of the buttons is worth. Volume is 0-100 on every BluOS
    // player, and single steps are too fine to hear.
    in property <int> step: 2;
    callback changed(int);
    callback toggle-mute();

    spacing: Theme.tight;

    // Every child here is a different height, and a row does not center what
    // it does not have to. Each one carries its own centering layout.
    VerticalLayout {
        alignment: center;

        IconButton {
            glyph: root.muted ? Icons.muted : Icons.volume;
            label: root.muted ? "Unmute" : "Mute";
            size: 26px;
            glyph-size: 15px;
            tint: root.muted ? Theme.faint : Theme.dim;
            enabled: root.enabled;
            clicked => { root.toggle-mute(); }
        }
    }

    // A step either side of the bar. Dragging is quick but imprecise, and the
    // one adjustment anyone makes twice in a row is "slightly quieter".
    VerticalLayout {
        alignment: center;

        IconButton {
            glyph: Icons.less;
            label: "Quieter";
            size: 22px;
            glyph-size: 12px;
            enabled: root.enabled && !root.muted;
            clicked => { root.changed(Math.max(0, root.value - root.step)); }
        }
    }

    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;

        // The reading rides on the middle of the bar rather than trailing it.
        // Off to one side it was a loose number with nothing to belong to; on
        // the bar it reads as the bar's own label. It carries no touch area of
        // its own, so a drag straight through the middle still reaches the
        // scrubber underneath.
        Rectangle {
            height: 18px;

            bar := Scrubber {
                width: 100%;
                y: (parent.height - self.height) / 2;
                // The buttons either side are how this is meant to be set; the
                // bar is for a deliberate drag, not for a passing click.
                jump-to-click: false;
                label: "Volume";
                enabled: root.enabled && !root.muted;
                value: root.value / 100;
                seek(fraction) => { root.changed(Math.round(fraction * 100)); }
            }

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                // Fixed, not measured. This pill is centered on its own width,
                // so sizing it to the number made it grow from both edges and
                // re-center on every step — a 13px pulse under the pointer
                // through the whole of a drag, which is the second-most-used
                // interaction in the app. 32px holds "100" at this size.
                width: 32px;
                height: 17px;
                border-radius: self.height / 2;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.border;

                reading := Text {
                    text: root.muted ? "\u{2014}" : root.value;
                    font-size: Theme.micro-size;
                    font-weight: 600;
                    color: root.muted ? Theme.faint : Theme.dim;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
        }
    }

    VerticalLayout {
        alignment: center;

        IconButton {
            glyph: Icons.add;
            label: "Louder";
            size: 22px;
            glyph-size: 12px;
            enabled: root.enabled && !root.muted;
            clicked => { root.changed(Math.min(100, root.value + root.step)); }
        }
    }

}

// A card. The one place the panel treatment is decided.
//
// Translucent, with a lit hairline along the top edge — the trick that reads
// as glass without a blur behind it, because a real pane of glass is brightest
// where it catches the light at its edge.
export component Panel inherits Rectangle {
    background: Theme.glass;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;

    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.rim;
        opacity: 0.5;
    }
}

// Cover art, with something to show before it arrives.
export component Artwork inherits Rectangle {
    in property <image> source;
    in property <image> fallback: Icons.track;
    in property <length> corner: Theme.radius;
    // Cover art is square and wants cropping to fill; a service's logo is
    // whatever shape its designer chose, and cropping one cuts the name in
    // half. Rows that may show either ask for `contain`.
    in property <bool> crop: true;
    // The well behind the art, for the moment before it arrives.
    //
    // A parameter because Home puts inputs and albums on one shelf: the input
    // tiles draw a glyph on `raised`, and an album whose art had not landed
    // drew its placeholder on `sunken` beside them, so two tiles in a row were
    // two different grays for the same reason.
    in property <brush> well: Theme.sunken;

    border-radius: root.corner;
    background: root.well;
    clip: true;

    Icon {
        glyph: root.fallback;
        tint: Theme.faint;
        // Proportional up to a point. 0.42 is right at 36px, where the glyph
        // reads as "nothing here"; at the now-playing sleeve it was a 235px
        // gray music note, which reads as a picture of a note. Past about
        // 64px a placeholder stops standing in for the thing and starts
        // being a thing.
        width: Math.min(Math.min(parent.width, parent.height) * 0.42, 64px);
        height: self.width;
        visible: root.source.width == 0;
    }

    Image {
        source: root.source;
        image-fit: root.crop ? ImageFit.cover : ImageFit.contain;
        width: 100%;
        height: 100%;

        // Art arrives over the network, so every cover in the app appears at
        // a moment nobody chose. Cutting to it makes a list of them flicker as
        // it fills; fading lets them settle. Short enough that nothing feels
        // withheld — this is the difference between a picture appearing and a
        // picture being switched on.
        opacity: root.source.width > 0 ? 1.0 : 0.0;
        animate opacity { duration: Theme.settle; easing: ease-out; }
    }
}

// A small label that carries state — "Leading 2 players", "unreachable".
export component Badge inherits Rectangle {
    in property <string> label;
    in property <brush> tint: Theme.dim;
    in property <image> glyph;

    height: 18px;
    width: row.preferred-width + 14px;
    border-radius: self.height / 2;
    background: Theme.raised;

    row := HorizontalLayout {
        alignment: center;
        spacing: 4px;
        padding-left: 7px;
        padding-right: 7px;

        if root.glyph.width > 0: Icon {
            glyph: root.glyph;
            width: 11px;
            height: 11px;
            tint: root.tint;
        }

        Text {
            text: root.label;
            font-size: Theme.micro-size;
            color: root.tint;
            vertical-alignment: center;
        }
    }
}

// A labeled button that shares the row it is in, for the pair of them that
// act on every player at once. Wider than an IconButton and captioned, because
// "group all" is not a thing you want to guess at from a glyph.
export component WideButton inherits Rectangle {
    in property <image> glyph;
    in property <string> label;
    callback clicked();

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    horizontal-stretch: 1;
    height: 46px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;
    background: touch.pressed
        ? Theme.pressed
        : (touch.has-hover ? Theme.hover : Theme.raised);

    HorizontalLayout {
        alignment: center;
        spacing: Theme.tight;

        VerticalLayout {
            alignment: center;
            Icon {
                glyph: root.glyph;
                tint: Theme.dim;
                width: 16px;
                height: 16px;
            }
        }

        VerticalLayout {
            alignment: center;
            Text {
                // Silenced for the reason PillButton's caption is.
                accessible-role: none;
                text: root.label;
                font-size: Theme.micro-size;
                font-weight: 600;
                letter-spacing: 0.6px;
                color: Theme.dim;
                vertical-alignment: center;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A time, set three ways.
//
// The official controller spins two drums under a thumb. The gesture a drum
// exists for is changing a number without having to hit a target, and on a
// desktop that gesture is the wheel, which is already under the hand — so the
// drums go and the wheel stays. What a drum cannot do at all is typed entry,
// which is how anyone with a keyboard sets 07:05, so that is here too. Three
// ways in, one `step`: the wheel over a group, the chevrons, and the keys.
export component TimeField inherits Rectangle {
    in property <int> hour;
    in property <int> minute;
    in property <bool> enabled: true;
    // Both together. A minute can carry into an hour, and a change that
    // applied one without the other would show a time nobody asked for.
    callback changed(int, int);

    // Which group the keys and the chevrons act on: 0 hours, 1 minutes.
    property <int> group: 0;
    // The first of two typed digits, or -1 when nothing is half-entered.
    property <int> half: -1;

    height: 52px;
    width: 168px;
    border-radius: Theme.radius-small;
    background: Theme.sunken;
    border-width: 1px;
    border-color: keys.has-focus ? Theme.accent : Theme.border;
    opacity: root.enabled ? 1.0 : 0.45;

    function step(by: int) {
        root.half = -1;
        if (root.group == 0) {
            // Wraps rather than clamping: a clock has no ends, and stopping
            // at 23 makes getting to 00 a twenty-three step journey.
            root.changed(Math.mod(root.hour + by + 24, 24), root.minute);
        } else {
            root.changed(root.hour, Math.mod(root.minute + by + 60, 60));
        }
    }

    // A digit at a time, the way a clock is read out loud. The first sets the
    // value, the second completes it where the pair is a legal time and
    // starts again where it is not — so 9 then 9 on the hours lands on 9,
    // not on nothing.
    function digit(d: int) {
        if (root.group == 0) {
            if (root.half < 0) {
                root.half = d;
                root.changed(d, root.minute);
            } else {
                // Read the first digit out before clearing it: the reset used
                // to run first, so the expression below read -1 and every
                // typed pair came out as `d - 10` — always negative, always
                // inside the `<= 23` guard, and clamped back to 0 by the Rust
                // side. Typing 07 set midnight.
                let tens = root.half;
                root.half = -1;
                root.changed(tens * 10 + d <= 23 ? tens * 10 + d : d, root.minute);
            }
        } else {
            if (root.half < 0) {
                root.half = d;
                root.changed(root.hour, d);
            } else {
                let tens = root.half;
                root.half = -1;
                root.changed(root.hour, tens * 10 + d <= 59 ? tens * 10 + d : d);
            }
        }
    }

    keys := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.UpArrow) { root.step(1); return accept; }
            if (event.text == Key.DownArrow) { root.step(-1); return accept; }
            if (event.text == Key.LeftArrow || event.text == Key.RightArrow) {
                root.group = root.group == 0 ? 1 : 0;
                root.half = -1;
                return accept;
            }
            if (event.text == Key.Tab) { return reject; }
            if (event.text >= "0" && event.text <= "9") {
                // Slint gives the character; the arithmetic wants the number.
                root.digit(
                    event.text == "0" ? 0 : event.text == "1" ? 1 : event.text == "2" ? 2
                    : event.text == "3" ? 3 : event.text == "4" ? 4 : event.text == "5" ? 5
                    : event.text == "6" ? 6 : event.text == "7" ? 7 : event.text == "8" ? 8 : 9);
                return accept;
            }
            return reject;
        }

        HorizontalLayout {
            padding-left: Theme.pad;
            padding-right: Theme.tight;
            spacing: 0px;

            // Each group is a fixed box with the text centered in it. Slint has
            // no tabular figures, so without one 09 → 10 shifts the colon
            // sideways on every turn of the wheel.
            hours := Rectangle {
                width: 52px;
                border-radius: Theme.radius-small - 2px;
                background: root.group == 0 && keys.has-focus ? Theme.selected : transparent;

                Text {
                    text: (root.hour < 10 ? "0" : "") + root.hour;
                    font-size: Theme.display-size;
                    font-weight: 600;
                    color: Theme.text;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    enabled: root.enabled;
                    clicked => { root.group = 0; root.half = -1; keys.focus(); }
                    scroll-event(e) => {
                        root.group = 0;
                        root.step(e.delta-y > 0 ? 1 : -1);
                        return accept;
                    }
                }
            }

            Text {
                text: ":";
                font-size: Theme.display-size;
                font-weight: 600;
                color: Theme.faint;
                vertical-alignment: center;
            }

            minutes := Rectangle {
                width: 52px;
                border-radius: Theme.radius-small - 2px;
                background: root.group == 1 && keys.has-focus ? Theme.selected : transparent;

                Text {
                    text: (root.minute < 10 ? "0" : "") + root.minute;
                    font-size: Theme.display-size;
                    font-weight: 600;
                    color: Theme.text;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                TouchArea {
                    enabled: root.enabled;
                    clicked => { root.group = 1; root.half = -1; keys.focus(); }
                    scroll-event(e) => {
                        root.group = 1;
                        root.step(e.delta-y > 0 ? 1 : -1);
                        return accept;
                    }
                }
            }

            // So the field says out loud that it is a spinner, rather than
            // waiting for the wheel to be discovered.
            VerticalLayout {
                alignment: center;
                spacing: 1px;

                // Named for what they do to the field, not for which way
                // they point: a chevron is only "up" to somebody who can see
                // it. Which of the two groups they act on is the field's
                // state, so the names follow it — "Later" alone would be a
                // pair of buttons that do two different things under one
                // name, depending on where the caret happens to be.
                IconButton {
                    glyph: Icons.expand;
                    label: root.group == 0 ? "An hour later" : "A minute later";
                    size: 22px;
                    glyph-size: 12px;
                    enabled: root.enabled;
                    clicked => { root.step(1); keys.focus(); }
                }

                IconButton {
                    glyph: Icons.collapse;
                    label: root.group == 0 ? "An hour earlier" : "A minute earlier";
                    size: 22px;
                    glyph-size: 12px;
                    enabled: root.enabled;
                    clicked => { root.step(-1); keys.focus(); }
                }
            }
        }
    }
}

// Which days a thing repeats on.
//
// Seven round chips is what the official controller draws, and it is a touch
// idiom that needs no translating: it is already seven targets a mouse can
// hit. Round rather than the squared-off `PillButton` because they are a set
// of seven equals rather than separate labeled actions.
//
// The letters and their order arrive from Rust with the data, so nothing here
// has to know what a week is or which end of it the player writes first.
export component DayPicker inherits FocusScope {
    in property <[string]> letters;
    // The same seven days written out, for anything that cannot see the
    // chips. The letters cannot do that job as well as their own: a week has
    // two days beginning with S and two with T, so read aloud they name four
    // chips ambiguously and two of those wrongly. They arrive from Rust
    // beside the letters for the reason the letters do — nothing here knows
    // what a week is — and an empty list simply leaves the chips unnamed.
    in property <[string]> names;
    in property <[bool]> days;
    callback toggled(int);

    // `enabled` is the FocusScope's own and needs no declaring here: off, it
    // already keeps the caret away, which is half of what the chips want from
    // it. The other half is below, on each chip.

    // Which chip the keys act on.
    //
    // One tab stop with the arrows moving inside it, rather than seven stops
    // of their own: these are a set of seven equals, and walking past every
    // day to reach the field below is not what Tab is for. It is the bargain
    // `TimeField` makes between its two groups, for the same reason.
    property <int> at: 0;

    key-pressed(event) => {
        // Nothing to move between until the days have arrived, and the
        // arithmetic below divides by this.
        if (root.letters.length == 0) {
            return EventResult.reject;
        }
        if (event.text == Key.LeftArrow) {
            root.at = Math.mod(root.at - 1 + root.letters.length, root.letters.length);
            return EventResult.accept;
        }
        if (event.text == Key.RightArrow) {
            root.at = Math.mod(root.at + 1, root.letters.length);
            return EventResult.accept;
        }
        // The space bar pauses the player everywhere else in the window; here
        // it sets a day, and does not reach the window's handler while this
        // holds the caret.
        if (event.text == Key.Return || event.text == " ") {
            if (root.enabled) {
                root.toggled(root.at);
            }
            return EventResult.accept;
        }
        return EventResult.reject;
    }

    HorizontalLayout {
        spacing: Theme.gap;
        alignment: start;

        for letter[i] in root.letters: Rectangle {
            // A day is on or off, which is what a checkbox is; the role has
            // to be a constant expression, and this one is the same for all
            // seven. The chip draws its state as a fill, so without
            // `accessible-checked` there is nothing left of it to read.
            accessible-role: checkbox;
            accessible-label: root.names[i];
            accessible-checkable: true;
            accessible-checked: root.days[i];
            accessible-enabled: root.enabled;
            // Guarded on `enabled` for the reason spelled out on
            // `IconButton`: a node marked disabled is still sent the click,
            // and this reaches past the TouchArea that would have refused it.
            accessible-action-default => {
                if (root.enabled) {
                    root.toggled(i);
                }
            }

            width: 32px;
            height: 32px;
            border-radius: self.height / 2;
            background: root.days[i]
                ? (day.pressed ? Theme.accent-hover : Theme.accent)
                : (day.pressed ? Theme.pressed : (day.has-hover ? Theme.hover : Theme.raised));
            // The ring says which chip the arrows and the space bar act on.
            // Drawn in the chip's own ink where it is set, because the accent
            // on the accent is not a ring at all — the same choice
            // `PillButton` makes over its primary.
            border-width: root.has-focus && root.at == i ? 2px : 1px;
            border-color: root.has-focus && root.at == i
                ? (root.days[i] ? Theme.accent-ink : Theme.accent)
                : (root.days[i] ? transparent : Theme.border);
            opacity: root.enabled ? 1.0 : 0.45;
            animate background { duration: Theme.quick; easing: ease-out; }

            Text {
                // Named by the chip above already, and named better: left as
                // a text node the letter is read out after the day's name.
                accessible-role: none;
                text: letter;
                font-size: Theme.small-size;
                font-weight: 600;
                color: root.days[i] ? Theme.accent-ink : Theme.dim;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            day := TouchArea {
                enabled: root.enabled;
                mouse-cursor: pointer;
                // The keyboard follows the mouse, so the arrows carry on from
                // wherever the last press landed rather than from Sunday.
                clicked => { root.at = i; root.focus(); root.toggled(i); }
            }
        }
    }
}
