import { ListView, Slider, ScrollView, ComboBox, LineEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";

// One player, flattened for display. The backend owns the real state; this is
// only what has to cross into the UI thread.
export struct Device {
    id: string,
    name: string,
    model: string,
    volume: int,
    muted: bool,
    playing: bool,
    now-playing: string,
    service: string,
    reachable: bool,
    // "Leading 2 players", "Following Kitchen", "Reconnecting…" or empty.
    role: string,
    // Whether this player is currently in the selected player's group.
    in-group: bool,
    // Whether grouping it with the selected player is even a question.
    groupable: bool,
}

// One row of the play queue.
export struct Track {
    id: int,
    title: string,
    artist: string,
    duration: string,
    // Where the player sits in the queue.
    cursor: bool,
    // ...and whether that position is what you are actually hearing.
    live: bool,
    // Empty until the art has been fetched and decoded; `cover.width == 0`
    // is what distinguishes "not loaded" from "loaded".
    cover: image,
}

// One row of a server-driven screen.
export struct BrowseRow {
    index: int,
    title: string,
    subtitle: string,
    cover: image,
    // A section heading rather than something to click.
    heading: bool,
    // Whether activating it does anything.
    actionable: bool,
    // The player says this is what is playing.
    playing: bool,
    // Whether there is a context menu to open on it.
    has-menu: bool,
}

component TextButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 30px;
    width: text.preferred-width + 24px;
    border-radius: Theme.radius;
    background: root.primary
        ? Theme.accent
        : (touch.pressed ? Theme.pressed : (touch.has-hover ? Theme.hover : transparent));
    border-width: root.primary ? 0px : 1px;
    border-color: Theme.border;
    opacity: root.enabled ? 1.0 : 0.4;

    text := Text {
        text: root.label;
        font-size: Theme.body-size;
        color: root.primary ? Theme.accent-ink : Theme.text;
        vertical-alignment: center;
        horizontal-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component TrackRow inherits Rectangle {
    in property <Track> track;
    callback play();
    callback open-menu();

    height: 46px;
    border-radius: 6px;
    background: touch.has-hover
        ? Theme.hover
        : (root.track.cursor ? Theme.selected : transparent);

    touch := TouchArea {
        clicked => { root.play(); }
    }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 8px;
        spacing: 6px;

        // The marker leads, so every thumbnail below it lines up whether or
        // not its row is the one the player is sitting on.
        Text {
            // Playing, versus merely where playback would resume.
            text: root.track.cursor ? (root.track.live ? "▶" : "◇") : "";
            font-size: Theme.small-size;
            color: root.track.live ? Theme.accent : Theme.dim;
            vertical-alignment: center;
            horizontal-alignment: center;
            width: 12px;
        }

        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 34px;
                height: 34px;
                border-radius: 4px;
                background: Theme.sunken;
                clip: true;

                Image {
                    source: root.track.cover;
                    image-fit: cover;
                    width: 100%;
                    height: 100%;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 1px;
            // Takes the slack, so the duration column below stays put instead
            // of drifting with the length of each title.
            horizontal-stretch: 1;

            Text {
                text: root.track.title;
                font-size: Theme.body-size;
                color: Theme.text;
                overflow: elide;
            }

            Text {
                text: root.track.artist;
                font-size: Theme.small-size;
                color: Theme.dim;
                overflow: elide;
            }
        }

        Rectangle {
            width: 22px;
            border-radius: 4px;
            background: menu-touch.has-hover ? Theme.pressed : transparent;
            opacity: touch.has-hover || menu-touch.has-hover ? 1.0 : 0.0;

            Text {
                text: "⋯";
                font-size: Theme.body-size;
                color: Theme.dim;
                vertical-alignment: center;
                horizontal-alignment: center;
            }

            menu-touch := TouchArea {
                clicked => { root.open-menu(); }
            }
        }

        Text {
            text: root.track.duration;
            font-size: Theme.small-size;
            color: Theme.dim;
            vertical-alignment: center;
            horizontal-alignment: right;
            width: 38px;
        }
    }
}

component BrowseRowView inherits Rectangle {
    in property <BrowseRow> entry;
    callback activate();
    callback open-menu();

    height: root.entry.heading ? 28px : 46px;
    border-radius: 6px;
    background: (root.entry.heading || !root.entry.actionable)
        ? transparent
        : (touch.has-hover ? Theme.hover : transparent);

    touch := TouchArea {
        enabled: root.entry.actionable && !root.entry.heading;
        clicked => { root.activate(); }
    }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 8px;
        spacing: 6px;

        if root.entry.heading: Text {
            text: root.entry.title;
            font-size: Theme.small-size;
            font-weight: 600;
            color: Theme.dim;
            vertical-alignment: bottom;
        }

        if !root.entry.heading: VerticalLayout {
            alignment: center;

            Rectangle {
                width: 34px;
                height: 34px;
                border-radius: 4px;
                background: Theme.sunken;
                clip: true;

                Image {
                    source: root.entry.cover;
                    image-fit: contain;
                    width: 100%;
                    height: 100%;
                }
            }
        }

        if !root.entry.heading: VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;

            Text {
                text: root.entry.title;
                font-size: Theme.body-size;
                color: root.entry.actionable ? Theme.text : Theme.dim;
                overflow: elide;
            }

            if root.entry.subtitle != "": Text {
                text: root.entry.subtitle;
                font-size: Theme.small-size;
                color: Theme.dim;
                overflow: elide;
            }
        }

        if !root.entry.heading && root.entry.has-menu: Rectangle {
            width: 22px;
            border-radius: 4px;
            background: menu-touch.has-hover ? Theme.pressed : transparent;
            // Kept out of the way until the row is under the pointer, so a
            // list of forty rows is not forty pieces of furniture.
            opacity: touch.has-hover || menu-touch.has-hover ? 1.0 : 0.0;

            Text {
                text: "⋯";
                font-size: Theme.body-size;
                color: Theme.dim;
                vertical-alignment: center;
                horizontal-alignment: center;
            }

            menu-touch := TouchArea {
                clicked => { root.open-menu(); }
            }
        }

        if !root.entry.heading: Text {
            text: root.entry.playing ? "▶" : (root.entry.actionable ? "›" : "");
            font-size: Theme.body-size;
            color: root.entry.playing ? Theme.accent : Theme.faint;
            vertical-alignment: center;
            horizontal-alignment: right;
            width: 14px;
        }
    }
}

component DeviceRow inherits Rectangle {
    in property <Device> device;
    in property <bool> selected;
    callback picked();
    callback volume-changed(int);
    callback toggle-group();

    height: root.device.role == "" ? 74px : 92px;
    border-radius: Theme.radius;
    background: root.selected
        ? Theme.selected
        : (touch.has-hover ? Theme.hover : transparent);

    touch := TouchArea {
        clicked => { root.picked(); }
    }

    VerticalLayout {
        padding: Theme.gap;
        spacing: 2px;

        HorizontalLayout {
            spacing: Theme.gap;

            Text {
                text: root.device.name;
                font-size: Theme.title-size;
                font-weight: 600;
                color: Theme.text;
                overflow: elide;
            }

            Rectangle { horizontal-stretch: 1; }

            Text {
                text: root.device.reachable ? root.device.model : "unreachable";
                font-size: Theme.small-size;
                color: Theme.dim;
                vertical-alignment: center;
            }
        }

        if root.device.role != "" || root.device.groupable: HorizontalLayout {
            spacing: Theme.gap;

            Text {
                text: root.device.role;
                font-size: Theme.small-size;
                color: Theme.accent;
                vertical-alignment: center;
                overflow: elide;
            }

            Rectangle { horizontal-stretch: 1; }

            if root.device.groupable: TextButton {
                label: root.device.in-group ? "Ungroup" : "Group";
                clicked => { root.toggle-group(); }
            }
        }

        Text {
            text: root.device.now-playing == "" ? "—" : root.device.now-playing;
            font-size: Theme.small-size;
            color: Theme.dim;
            overflow: elide;
        }

        HorizontalLayout {
            spacing: Theme.gap;

            Slider {
                minimum: 0;
                maximum: 100;
                value: root.device.volume;
                // `released`, not `changed`: a drag fires continuously, and
                // every intermediate value would be one HTTP request to the
                // player and one long-poll wakeup on every other controller.
                released(v) => { root.volume-changed(Math.round(v)); }
            }

            Text {
                text: root.device.muted ? "muted" : root.device.volume;
                font-size: Theme.small-size;
                color: Theme.dim;
                vertical-alignment: center;
                width: 40px;
                horizontal-alignment: right;
            }
        }
    }
}

export component AppWindow inherits Window {
    in property <[Device]> devices;
    in property <[Track]> queue;
    in property <image> cover;
    in property <string> queue-line: "";
    in property <string> status-line: "starting";
    in property <[BrowseRow]> browse;
    in property <string> browse-title: "Browse";
    in property <bool> browse-can-go-back: false;
    // The screens this player offers, by name, straight from the player.
    in property <[string]> screens;
    in property <bool> browse-has-search: false;
    in property <string> browse-search-prompt: "Search";
    in-out property <int> selected: 0;
    // 0 shows the queue, 1 shows the browser.
    in-out property <int> pane: 0;

    callback toggle(string);
    callback skip(string);
    callback back(string);
    callback set-volume(string, int);
    callback select(string);
    callback toggle-group(string);
    callback play-track(string, int);
    callback browse-activate(int);
    callback browse-menu(int);
    callback browse-back();
    callback browse-home();
    callback browse-screen(int);
    callback browse-search(string);
    callback queue-menu(int);
    callback rescan();

    title: "Azzurro";
    preferred-width: 1060px;
    preferred-height: 560px;
    min-width: 720px;
    min-height: 380px;
    background: Theme.bg;

    property <bool> has-selection: root.devices.length > 0
        && root.selected >= 0
        && root.selected < root.devices.length;
    property <Device> current: root.has-selection
        ? root.devices[root.selected]
        : { name: "", now-playing: "", service: "" };

    VerticalLayout {
        padding: Theme.pad;
        spacing: Theme.pad;

        HorizontalLayout {
            spacing: Theme.pad;

            // Players.
            Rectangle {
                width: 320px;
                background: Theme.surface;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border;

                VerticalLayout {
                    padding: Theme.gap;
                    spacing: Theme.gap;

                    Text {
                        text: "Players";
                        font-size: Theme.small-size;
                        font-weight: 600;
                        color: Theme.dim;
                    }

                    ListView {
                        for device[i] in root.devices: DeviceRow {
                            device: device;
                            selected: i == root.selected;
                            picked => {
                                root.selected = i;
                                root.select(device.id);
                            }
                            volume-changed(v) => { root.set-volume(device.id, v); }
                            toggle-group => { root.toggle-group(device.id); }
                        }
                    }
                }
            }

            // Now playing.
            Rectangle {
                background: Theme.surface;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border;

                VerticalLayout {
                    padding: Theme.pad * 2;
                    spacing: Theme.pad;
                    alignment: center;

                    // Artwork goes here once the image pipeline lands: fetch,
                    // decode, downscale and cache, all of which this crate has
                    // to do itself because Slint has no URL-loading image.
                    HorizontalLayout {
                        alignment: center;

                        Rectangle {
                            height: 180px;
                            width: 180px;
                            background: Theme.sunken;
                            border-radius: Theme.radius;
                            clip: true;

                            Image {
                                source: root.cover;
                                image-fit: contain;
                                width: 100%;
                                height: 100%;
                            }

                            // Stands in until there is art, and stays for the
                            // sources that never have any.
                            Text {
                                visible: root.cover.width == 0;
                                text: root.current.service == "" ? "—" : root.current.service;
                                font-size: Theme.small-size;
                                color: Theme.dim;
                            }
                        }
                    }

                    Text {
                        text: root.has-selection ? root.current.name : "No player selected";
                        font-size: Theme.title-size + 3px;
                        font-weight: 600;
                        color: Theme.text;
                        horizontal-alignment: center;
                        overflow: elide;
                    }

                    Text {
                        text: root.current.now-playing == "" ? "Nothing playing" : root.current.now-playing;
                        font-size: Theme.body-size;
                        color: Theme.dim;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: Theme.gap;
                        alignment: center;

                        TextButton {
                            label: "Previous";
                            enabled: root.has-selection;
                            clicked => { root.back(root.current.id); }
                        }

                        TextButton {
                            label: root.current.playing ? "Pause" : "Play";
                            primary: true;
                            enabled: root.has-selection;
                            clicked => { root.toggle(root.current.id); }
                        }

                        TextButton {
                            label: "Next";
                            enabled: root.has-selection;
                            clicked => { root.skip(root.current.id); }
                        }
                    }
                }
            }

            // Queue and browser share the right-hand panel.
            Rectangle {
                width: 340px;
                background: Theme.surface;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: Theme.border;

                VerticalLayout {
                    padding: Theme.gap;
                    spacing: Theme.gap;

                    HorizontalLayout {
                        spacing: 4px;

                        TextButton {
                            label: "Queue";
                            primary: root.pane == 0;
                            clicked => { root.pane = 0; }
                        }

                        TextButton {
                            label: "Browse";
                            primary: root.pane == 1;
                            clicked => {
                                root.pane = 1;
                                root.browse-home();
                            }
                        }

                        Rectangle { horizontal-stretch: 1; }

                        if root.pane == 1 && root.browse-can-go-back: TextButton {
                            label: "Back";
                            clicked => { root.browse-back(); }
                        }
                    }

                    if root.pane == 1 && root.screens.length > 0: ComboBox {
                        model: root.screens;
                        selected => { root.browse-screen(self.current-index); }
                    }

                    Text {
                        text: root.pane == 0
                            ? (root.queue-line == "" ? "Queue" : root.queue-line)
                            : root.browse-title;
                        font-size: Theme.small-size;
                        font-weight: 600;
                        color: Theme.dim;
                        overflow: elide;
                    }

                    if root.pane == 1 && root.browse-has-search: LineEdit {
                        placeholder-text: root.browse-search-prompt;
                        accepted(text) => { root.browse-search(text); }
                    }

                    if root.pane == 0: ListView {
                        for track in root.queue: TrackRow {
                            track: track;
                            play => { root.play-track(root.current.id, track.id); }
                            open-menu => { root.queue-menu(track.id); }
                        }
                    }

                    if root.pane == 1: ListView {
                        for entry in root.browse: BrowseRowView {
                            entry: entry;
                            activate => { root.browse-activate(entry.index); }
                            open-menu => { root.browse-menu(entry.index); }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: Theme.gap;

            Text {
                text: root.status-line;
                font-size: Theme.small-size;
                color: Theme.dim;
                vertical-alignment: center;
            }

            Rectangle { horizontal-stretch: 1; }

            TextButton {
                label: "Rescan";
                clicked => { root.rescan(); }
            }
        }
    }
}
