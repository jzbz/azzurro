import { ListView, ComboBox, LineEdit, Slider, Switch } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";
import { Icon, IconButton, PillButton, Segmented, Scrubber, Level, Panel, Artwork, Badge, WideButton, TimeField, DayPicker, EmptyState } from "widgets.slint";

// A bare file import is how Slint registers a custom font: the family the
// file declares becomes usable as a font-family anywhere, and the file is
// embedded in the binary. Naming the family in `default-font-family` without
// this does nothing at all — it silently falls back to whatever the system
// has, which is Noto Sans on this machine and DejaVu inside a Flatpak.
//
// Slint accepts only ttf/ttc/otf. See ui/fonts/LICENSE for the OFL text and
// the Reserved Font Name notices.
import "fonts/geist-regular.ttf";
import "fonts/geist-semibold.ttf";
import "fonts/geist-bold.ttf";
import "fonts/geo.ttf";

// Re-exported so Rust can reach the glyph set: only globals exported from the
// entry file get generated bindings, and the browse rows pick their icon on
// the Rust side.
export { Icons }

// One player, flattened for display. The backend owns the real state; this is
// only what has to cross into the UI thread.
export struct Device {
    id: string,
    name: string,
    model: string,
    volume: int,
    muted: bool,
    playing: bool,
    now-playing: string,
    title: string,
    artist: string,
    album: string,
    service: string,
    reachable: bool,
    // "Leading 2 players", "Following Kitchen", "Reconnecting…" or empty.
    //
    // Recomputed from the grouping state on every publish, so nothing else can
    // borrow it to say something — an upgrade tried, and was overwritten on
    // the same tick by the publish that carried it.
    role: string,
    in-group: bool,
    groupable: bool,
    // Set for as long as the player is rewriting its own firmware, with the
    // stage and any percentage it reports. Its own field precisely because
    // `role` is not one it can share.
    upgrading: bool,
    upgrade-line: string,
}

/// One thing the service offers for what is playing — Love, Ban, Shop.
///
/// `name` is the player's own identifier and is what gets sent back, rather
/// than a position in this list: the list is rebuilt from every status that
/// arrives, so an index could name a different action by the time it is
/// pressed.
export struct TrackAction {
    name: string,
    label: string,
    on: bool,
}

/// One hand-typed radio station.
export struct MyStation {
    name: string,
    url: string,
}

// One row of the play queue.
export struct Track {
    id: int,
    title: string,
    artist: string,
    duration: string,
    // The player's own word for the format — "cd", "hd", "mqa" — or empty
    // where it does not say.
    quality: string,
    // Where the player sits in the queue.
    cursor: bool,
    // ...and whether that position is what you are actually hearing.
    live: bool,
    cover: image,
}

// A button the player puts on the block at the top of a screen: "Play all" and
// "Shuffle" on an album.
export struct ActionButton {
    index: int,
    label: string,
    glyph: image,
    primary: bool,
}

// One of the buttons the player puts under the play queue.
//
// Save, Edit, Clear, and — to a client declaring a new enough schema — Queue
// Builder Mode. Which of them exist is the player's business, not this app's:
// the row is drawn from whatever it sends.
// One answer to a question the player asked. See `bluos::dialog`.
export struct DialogButton {
    index: int,
    label: string,
    // The player colored this one, which is how it marks the answer that
    // discards something. Drawn as the emphasized button.
    destructive: bool,
}

export struct QueueButton {
    index: int,
    label: string,
    glyph: image,
    // The player's own recommendation of which one to press. Save carries it
    // once the queue has been changed.
    highlight: bool,
    // What pressing it does here. 0 = send it to the player, which is the
    // ordinary case; 1 = turn on Edit, which never leaves the app; 2 = ask
    // first, then send; 3 = ask for a name, then save under it.
    mode: int,
    // The question to ask, for mode 2. The player writes it.
    question: string,
}

// One row of a server-driven screen.
export struct BrowseRow {
    index: int,
    title: string,
    subtitle: string,
    // Its place on the record, and what the player says it is encoded as.
    // Both empty except on a screen about one album.
    track: string,
    quality: string,
    cover: image,
    heading: bool,
    actionable: bool,
    playing: bool,
    // Distinct from `playing`: a selector menu marks which service you are
    // looking at, which is not the same as which one is making noise.
    selected: bool,
    has-menu: bool,
    // Whether `cover` is one of our own glyphs rather than a picture: a line
    // icon has to be centered and tinted, not cropped to fill a tile.
    is-glyph: bool,
    // Whether pressing this starts music, as opposed to opening a screen. An
    // album and the track on it look alike on a shelf and do opposite things,
    // so the one that plays says so under the pointer.
    plays: bool,
}

// One section of a screen, with the rows it holds.
//
// The player says how each section wants to be drawn and the official
// controller obeys: a shelf of covers for "Recently Played", a strip of
// service chips at the top of Favorites, a plain list for an album. A flat
// list of everything is legible but it is not what the player asked for.
export struct BrowseBlock {
    // 0 = a plain list, 1 = a shelf of tiles, 2 = a strip of service chips,
    // 3 = a heading that is a way in and holds nothing itself.
    kind: int,
    title: string,
    // The button the player puts on this section's heading — "View All" beside
    // a shelf that is showing ten of a hundred, "Clear" beside the recents.
    // Empty when the section has none.
    action: string,
    // Which section of the screen it belongs to, which is not the block's own
    // position: empty sections and the service picker never become blocks.
    section: int,
    rows: [BrowseRow],
}

// One row of the navigation sidebar: a heading, a screen, or an entry from
// the player's own Sources screen.
export struct SidebarRow {
    label: string,
    cover: image,
    is-glyph: bool,
    header: bool,
    selected: bool,
    // 0 = a screen from /ui/Configuration, 1 = an item on the Sources screen,
    // 2 = the button on a section heading — "Customize" on Inputs, "Manage" on
    // Music Services. The player names those; they are not ours to invent.
    kind: int,
    index: int,
    // What that button says, empty on a heading that has no button.
    action: string,
}

// One row of a settings page. The controls differ, so unlike a browse row
// this cannot be one shape with a label swapped in.
export struct SettingItem {
    index: int,
    label: string,
    detail: string,
    cover: image,
    is-glyph: bool,
    heading: bool,
    // boolean | range | list | text | button | link | none
    control: string,
    on: bool,
    value: string,
    number: float,
    minimum: float,
    maximum: float,
    step: float,
    units: string,
    options: [string],
    option-index: int,
    available: bool,
    // Whether the row is a door as well as a control. A settings row is
    // normally one or the other; an alarm is both, because arming it is the
    // commonest thing anyone does to one and having to open it first would put
    // a page in the way. `touch` is declared before `body`, so the control in
    // the body takes its own press and the rest of the row opens.
    opens: bool,
}

component SectionLabel inherits Text {
    // Whether this heading is the player's words rather than the app's.
    //
    // The treatment below is built for uppercase: at 10.5px, weight 700 and
    // +0.8px of tracking say "label" only when there are no lowercase letters
    // to be spaced apart. Four of these carry prose off the wire — "Network",
    // "Playlists", a service's own section names — and letterspaced Title Case
    // reads as a mistake rather than as a label. Uppercasing it here was the
    // other option and is the wrong one: the app does not put words in the
    // player's mouth, and a section called "BBC Sounds" is not called
    // "BBC SOUNDS".
    in property <bool> prose: false;

    font-size: Theme.micro-size;
    font-weight: root.prose ? 600 : 700;
    color: Theme.faint;
    // Small caps are not available, so the spacing does the work of saying
    // "this is a label, not content".
    letter-spacing: root.prose ? 0px : 0.8px;
}

component SettingRow inherits Rectangle {
    in property <SettingItem> item;
    callback toggled();
    callback chose(int);
    callback numbered(float);
    callback typed(string);
    callback opened();

    // One role for nine kinds of row, which is not the compromise it looks.
    //
    // `accessible-role` has to be a constant expression, so it cannot follow
    // `item.control` the way the height and the hover below both do. That
    // turns out to be the right shape anyway: the controls this row carries in
    // its body — the Switch, the Slider, the LineEdit, the ComboBox — are
    // std-widgets and bring their own roles and values with them, so naming
    // the row a second time as a switch or a slider would say it twice and
    // disagree with itself when the two drifted.
    //
    // What is left for the row to answer for is the three kinds that have no
    // control of their own — `link`, `cycle` and `button` — plus any row that
    // `opens`. Those press the row itself, which is exactly what the default
    // action does, and its `enabled` here is the same test the TouchArea below
    // makes. The rest are named containers, and their contents speak.
    //
    // `available` is the player's word for a setting it will not accept right
    // now; a row it has dimmed is reported unavailable rather than pressable.
    accessible-role: list-item;
    accessible-label: root.item.label;
    accessible-description: root.item.detail;
    accessible-enabled: root.item.available
        && !root.item.heading
        && (root.item.control == "link"
            || root.item.control == "cycle"
            || root.item.control == "button"
            || root.item.opens);
    // Guarded on the same test as `accessible-enabled` above: a node marked
    // disabled is still sent the click, so the row has to refuse it here
    // rather than trust the marking. Otherwise a setting the player has said
    // it will not take right now could be pressed anyway.
    accessible-action-default => {
        if (root.item.available
            && !root.item.heading
            && (root.item.control == "link"
                || root.item.control == "cycle"
                || root.item.control == "button"
                || root.item.opens)) {
            root.opened();
        }
    }

    // Tall enough for the contents, and never shorter than a row.
    //
    // A plain `min-height` is not enough: a ListView asks each item how tall
    // it is, and these carry their contents in `if` blocks that answer zero —
    // so every row collapsed onto the one above it. Measuring the block that
    // is actually there and taking the larger of the two gives an ordinary row
    // exactly its 60px, and a wrapped file path however many lines it needs.
    height: root.item.heading
        ? 34px
        : Math.max(60px, body.preferred-height);
    border-radius: Theme.radius-small;
    background: (root.item.control == "link"
            || root.item.control == "button"
            || root.item.control == "cycle"
            || root.item.opens)
            && touch.has-hover
        ? Theme.hover
        : transparent;
    animate background { duration: Theme.quick; easing: ease-out; }
    // Dimmed rather than hidden: the player put it there, and a gap where a
    // setting should be is more confusing than a grayed one.
    opacity: root.item.available ? 1.0 : 0.45;

    touch := TouchArea {
        // A button row too, where the pill has been left off: the row is then
        // the control, and it has to be pressable for that to mean anything.
        enabled: root.item.control == "link"
            || root.item.control == "cycle"
            || root.item.control == "button"
            || root.item.opens;
        clicked => { root.opened(); }
    }

    if root.item.heading: HorizontalLayout {
        padding-left: Theme.pad;
        alignment: start;

        SectionLabel {
            prose: true;
            text: root.item.label;
            vertical-alignment: bottom;
        }
    }

    body := HorizontalLayout {
        visible: !root.item.heading;
        padding-left: Theme.gap;
        padding-right: Theme.gap;
        // Vertical padding so a wrapped value has margin above and below
        // rather than sitting against the row's edges.
        padding-top: Theme.tight;
        padding-bottom: Theme.tight;
        spacing: Theme.pad;

        // Only where there is one to draw. A row that is nothing but a button
        // — the submit at the end of one of the player's forms — would
        // otherwise carry an empty tile where every other row has its icon.
        if root.item.is-glyph: VerticalLayout {
            alignment: center;

            Rectangle {
                width: 34px;
                height: 34px;
                border-radius: 5px;
                background: Theme.raised;

                Icon {
                    glyph: root.item.cover;
                    tint: Theme.dim;
                    width: 18px;
                    height: 18px;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            min-width: 0px;

            Text {
                text: root.item.label;
                font-size: Theme.body-size;
                color: Theme.text;
                overflow: elide;
            }

            if root.item.detail != "": Text {
                text: root.item.detail;
                font-size: Theme.small-size;
                color: Theme.dim;
                // Wrapped, not elided. This is where a technical-info page
                // puts the file name, and half a path tells you nothing.
                wrap: word-wrap;
            }
        }

        if root.item.control == "boolean": VerticalLayout {
            alignment: center;

            Switch {
                checked: root.item.on;
                enabled: root.item.available;
                toggled => { root.toggled(); }
            }
        }

        if root.item.control == "range": HorizontalLayout {
            spacing: Theme.gap;
            width: 210px;

            Slider {
                enabled: root.item.available;
                minimum: root.item.minimum;
                maximum: root.item.maximum;
                value: root.item.number;
                // On release: a drag writes to the player, and every
                // intermediate value would be a POST.
                released(v) => { root.numbered(v); }
            }

            Text {
                text: root.item.value + root.item.units;
                font-size: Theme.small-size;
                color: Theme.faint;
                vertical-alignment: center;
                width: 46px;
                horizontal-alignment: right;
            }
        }

        if root.item.control == "list": VerticalLayout {
            alignment: center;
            width: 176px;

            ComboBox {
                model: root.item.options;
                current-index: root.item.option-index;
                enabled: root.item.available;
                selected => { root.chose(self.current-index); }
            }
        }

        if root.item.control == "text": VerticalLayout {
            alignment: center;
            width: 196px;

            LineEdit {
                text: root.item.value;
                enabled: root.item.available;
                font-size: Theme.small-size;
                accepted(t) => { root.typed(t); }
            }
        }

        // The player's own settings never ask for one; its web pages do, for a
        // wireless key and for signing into a music service. Never seeded with
        // what is held and never drawn back, so what is on screen is only ever
        // what was typed here.
        if root.item.control == "password": VerticalLayout {
            alignment: center;
            width: 196px;

            LineEdit {
                input-type: password;
                placeholder-text: root.item.on ? "••••••••" : "";
                enabled: root.item.available;
                font-size: Theme.small-size;
                edited(t) => { root.typed(t); }
                accepted(t) => { root.typed(t); }
            }
        }

        // Only where the player gave the button words of its own. Reindex
        // gives none, so the pill fell back to the row's title and stood there
        // saying "Reindex music collection" beside "Reindex music collection".
        // With no pill the row itself is the button, which is what a row with
        // exactly one thing to do should be.
        if root.item.control == "button" && root.item.value != "": VerticalLayout {
            alignment: center;

            PillButton {
                label: root.item.value;
                enabled: root.item.available;
                clicked => { root.opened(); }
            }
        }

        // A setting with no values to choose from, only a next state: the
        // sleep timer walks its own ladder and the player decides what comes
        // after what, so the row shows where it is and asks for one more step.
        if root.item.control == "cycle": VerticalLayout {
            alignment: center;

            Rectangle {
                height: 28px;
                width: state.preferred-width + 26px;
                border-radius: self.height / 2;
                background: root.item.on ? Theme.accent-soft : Theme.raised;
                border-width: 1px;
                border-color: root.item.on ? Theme.accent : Theme.border;

                state := Text {
                    text: root.item.value;
                    font-size: Theme.small-size;
                    font-weight: root.item.on ? 600 : 400;
                    color: root.item.on ? Theme.accent : Theme.dim;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
        }

        if root.item.control == "link": VerticalLayout {
            alignment: center;

            Icon {
                glyph: Icons.forward;
                tint: Theme.faint;
                width: 15px;
                height: 15px;
            }
        }
    }
}

component NavRow inherits Rectangle {
    in property <SidebarRow> entry;
    callback activate();

    // A list item rather than a button: this is the sidebar, and which entry
    // you are on is as much of the answer as what pressing it would do.
    //
    // One role for both kinds of row, because `accessible-role` has to be a
    // constant expression — it cannot be chosen per row the way the height
    // above is. A heading is reported unavailable instead, which is what its
    // TouchArea's `enabled` already tells the pointer.
    accessible-role: list-item;
    accessible-label: root.entry.label;
    accessible-enabled: !root.entry.header;
    accessible-item-selectable: !root.entry.header;
    accessible-item-selected: root.entry.selected;
    accessible-action-default => {
        if (!root.entry.header) {
            root.activate();
        }
    }

    height: root.entry.header ? 34px : 40px;
    background: root.entry.selected
        ? Theme.selected
        : (touch.has-hover && !root.entry.header ? Theme.hover : transparent);
    animate background { duration: Theme.quick; easing: ease-out; }

    touch := TouchArea {
        enabled: !root.entry.header;
        clicked => { root.activate(); }
    }

    // The selected entry carries a rule down its left edge, the way the
    // official controller marks the service you are looking at.
    Rectangle {
        x: 0;
        width: 3px;
        height: parent.height - 12px;
        y: 6px;
        background: Theme.accent;
        opacity: root.entry.selected ? 1.0 : 0.0;
        animate opacity { duration: Theme.quick; }
    }

    if root.entry.header: HorizontalLayout {
        padding-left: Theme.room;
        padding-right: Theme.gap;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;

            SectionLabel { prose: true; text: root.entry.label; }
        }

        if root.entry.action != "": VerticalLayout {
            alignment: center;

            Rectangle {
                height: 22px;
                width: caption.preferred-width + 20px;
                border-radius: self.height / 2;
                background: menu.pressed
                    ? Theme.pressed
                    : (menu.has-hover ? Theme.hover : transparent);
                border-width: 1px;
                border-color: Theme.border;
                animate background { duration: Theme.quick; easing: ease-out; }

                caption := Text {
                    // The pill below carries this string as its name.
                    accessible-role: none;
                    text: root.entry.action;
                    font-size: Theme.micro-size;
                    font-weight: 600;
                    letter-spacing: 0.6px;
                    color: menu.has-hover ? Theme.text : Theme.dim;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }

                menu := TouchArea {
                    // The button a section heading carries — "Customize" on
                    // Inputs, "Manage" on Music Services. The player names
                    // these, so the name comes from the row rather than from
                    // anything invented here.
                    accessible-role: button;
                    accessible-label: root.entry.action;
                    accessible-action-default => { root.activate(); }
                    clicked => { root.activate(); }
                }
            }
        }
    }

    if !root.entry.header: HorizontalLayout {
        padding-left: Theme.room;
        padding-right: Theme.pad;
        spacing: Theme.pad;

        VerticalLayout {
            alignment: center;

            if root.entry.is-glyph: Icon {
                glyph: root.entry.cover;
                tint: root.entry.selected ? Theme.accent : Theme.dim;
                width: 19px;
                height: 19px;
            }

            if !root.entry.is-glyph: Image {
                source: root.entry.cover;
                image-fit: contain;
                width: 19px;
                height: 19px;
            }
        }

        Text {
            text: root.entry.label;
            font-size: Theme.title-size;
            color: root.entry.selected ? Theme.text : Theme.dim;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            min-width: 0px;
        }
    }
}

component DeviceCard inherits Rectangle {
    // What this player is playing, at 40px. Empty until the art arrives, and
    // empty forever for a source that has none — an input, a stream with no
    // logo — which is why the speaker glyph it replaces is still drawn
    // underneath rather than removed.
    in property <image> cover;
    in property <Device> device;
    in property <bool> selected;
    callback picked();
    callback volume-changed(int);
    callback toggle-mute();
    callback toggle-group();

    // The card names the player and says whether it is the one being
    // controlled; the volume and group controls inside it carry their own
    // names. What it is playing goes in the description rather than the label,
    // so choosing a player is not read out as a track title.
    accessible-role: list-item;
    accessible-label: root.device.name;
    accessible-description: root.device.now-playing;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.picked(); }

    border-radius: Theme.radius-small;
    background: root.selected
        ? Theme.selected
        : (touch.has-hover ? Theme.hover : transparent);
    animate background { duration: Theme.quick; easing: ease-out; }

    touch := TouchArea {
        clicked => { root.picked(); }
    }

    // A rule down the left edge rather than a heavier fill: the selected card
    // has to be obvious at a glance without becoming the loudest thing on the
    // screen, which is the artwork's job.
    Rectangle {
        x: 0;
        width: 3px;
        height: parent.height - 16px;
        y: 8px;
        border-radius: 1.5px;
        background: Theme.accent;
        opacity: root.selected ? 1.0 : 0.0;
        animate opacity { duration: Theme.quick; }
    }

    VerticalLayout {
        padding: Theme.pad;
        padding-left: Theme.pad + 4px;
        spacing: 6px;

        HorizontalLayout {
            spacing: Theme.gap;

            // A tile that is a cover when there is one and a glyph when there
            // is not. Same size either way, so a row does not change shape as
            // its art arrives.
            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: Theme.radius-art;
                background: Theme.raised;
                clip: true;
                y: 1px;

                Icon {
                    glyph: root.device.in-group ? Icons.grouped : Icons.player;
                    tint: root.selected ? Theme.accent : Theme.faint;
                    width: 17px;
                    height: 17px;
                    // Hidden rather than removed: it is the ground the cover
                    // sits on, and a cover that fades in over nothing fades in
                    // over the panel behind the row.
                    opacity: root.cover.width > 0 ? 0.0 : 1.0;
                    animate opacity { duration: Theme.settle; easing: ease-out; }
                }

                Image {
                    source: root.cover;
                    image-fit: ImageFit.cover;
                    width: 100%;
                    height: 100%;
                    opacity: root.cover.width > 0 ? 1.0 : 0.0;
                    animate opacity { duration: Theme.settle; easing: ease-out; }
                }
            }

            VerticalLayout {
                spacing: 1px;
                horizontal-stretch: 1;
                min-width: 0px;

                Text {
                    text: root.device.name;
                    font-size: Theme.title-size;
                    font-weight: 600;
                    color: Theme.text;
                    overflow: elide;
                }

                Text {
                    text: root.device.reachable
                        ? (root.device.now-playing == "" ? root.device.model : root.device.now-playing)
                        : "Not responding";
                    font-size: Theme.small-size;
                    color: root.device.reachable ? Theme.dim : Theme.faint;
                    overflow: elide;
                }
            }

            if root.device.playing: Icon {
                glyph: Icons.play;
                tint: Theme.accent;
                width: 13px;
                height: 13px;
                y: 4px;
            }
        }

        Level {
            value: root.device.volume;
            muted: root.device.muted;
            // A player that is not answering — upgrading, or simply gone —
            // takes no presses. Faded rather than absent, so the row does not
            // reshuffle itself the moment a speaker drops off.
            enabled: root.device.reachable;
            changed(v) => { root.volume-changed(v); }
            toggle-mute => { root.toggle-mute(); }
        }

        if root.device.upgrading || root.device.role != "" || root.device.groupable: HorizontalLayout {
            spacing: Theme.gap;
            padding-top: 2px;

            // An upgrade displaces the grouping badge rather than sitting
            // beside it. Both are "what this player is doing"; while it is
            // rewriting its own firmware, that is the answer, and the row is
            // too narrow to carry two badges without one wrapping.
            if root.device.upgrading: Badge {
                label: root.device.upgrade-line;
                tint: Theme.accent;
                glyph: Icons.upgrade;
            }

            if !root.device.upgrading && root.device.role != "": Badge {
                label: root.device.role;
                tint: Theme.accent;
                glyph: Icons.grouped;
            }

            Rectangle { horizontal-stretch: 1; }

            if root.device.groupable: IconButton {
                glyph: root.device.in-group ? Icons.ungroup : Icons.group;
                // The name follows the glyph, so it says what the press will
                // do rather than what the player currently is.
                label: root.device.in-group ? "Ungroup" : "Group with the selected player";
                size: 26px;
                glyph-size: 14px;
                active: root.device.in-group;
                clicked => { root.toggle-group(); }
            }
        }
    }
}

/// One hand-typed station.
///
/// Two rows in one, because a station is two different things depending on
/// what you came here to do. Ordinarily it is a thing to play, so the whole
/// row is the target and nothing else competes for the press. Under Edit it
/// stops being pressable at all and becomes a handle, a name you can retype
/// and a bin — the same three the queue's rows offer, wearing the same icons,
/// because it is the same gesture.
component StationRow inherits Rectangle {
    in property <MyStation> station;
    in property <bool> editing: false;
    in property <bool> lifted: false;
    in property <length> lift: 0px;
    callback play();
    callback renamed(string);
    callback remove();
    callback drag-moved(length);
    callback drag-done();
    callback drag-cancelled();

    // Pressing the row plays the station, which is what it is for — but only
    // outside edit mode, where the row stops being a target and becomes a
    // handle with a rename field and a bin. Reported unavailable there, since
    // the default action would do nothing.
    accessible-role: list-item;
    accessible-label: root.station.name != "" ? root.station.name : root.station.url;
    accessible-description: root.station.url;
    accessible-enabled: !root.editing;
    accessible-action-default => {
        if (!root.editing) {
            root.play();
        }
    }

    property <bool> held: false;
    // A station saved without a name is shown by its address: an empty row
    // would be unpressable and unidentifiable at once.
    property <string> shown: root.station.name == "" ? root.station.url : root.station.name;

    height: 56px;
    border-radius: Theme.radius-small;
    background: root.lifted
        ? Theme.raised
        : (touch.has-hover || play-touch.has-hover ? Theme.hover : Theme.glass);
    border-width: 1px;
    border-color: root.lifted ? Theme.accent : Theme.border;
    drop-shadow-blur: root.lifted ? 16px : 0px;
    drop-shadow-color: #00000066;
    animate background { duration: Theme.quick; easing: ease-out; }

    // Playing, when that is what a press means. Declared before the drag area
    // so the drag wins while editing; two touch areas over one row would
    // otherwise both take the press.
    play-touch := TouchArea {
        enabled: !root.editing;
        mouse-cursor: pointer;
        clicked => { root.play(); }
    }

    touch := TouchArea {
        enabled: root.editing;
        mouse-cursor: grab;
        moved => {
            if (self.pressed && (root.held || Math.abs(self.mouse-y - self.pressed-y) > 4px)) {
                root.held = true;
                root.drag-moved(self.mouse-y - self.pressed-y + root.lift);
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up) {
                if (root.held) {
                    root.drag-done();
                }
                root.held = false;
            }
            if (event.kind == PointerEventKind.cancel) {
                root.drag-cancelled();
                root.held = false;
            }
        }
    }

    HorizontalLayout {
        padding-left: Theme.gap;
        padding-right: Theme.gap;
        spacing: Theme.gap;

        VerticalLayout {
            alignment: center;
            Icon {
                glyph: root.editing ? Icons.grip : Icons.station;
                tint: Theme.faint;
                width: 16px;
                height: 16px;
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;

            // Retyped in place while editing. Seeded once from the station and
            // reported on every keystroke — it is this app's own list, so a
            // rename costs a write to a small file and nothing on the network.
            if root.editing: LineEdit {
                text: root.station.name;
                placeholder-text: root.station.url;
                font-size: Theme.body-size;
                edited(t) => { root.renamed(t); }
                accepted(t) => { root.renamed(t); }
            }

            if !root.editing: Text {
                text: root.shown;
                font-size: Theme.body-size;
                color: Theme.text;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        if root.editing: VerticalLayout {
            alignment: center;
            IconButton {
                glyph: Icons.clear;
                label: "Remove this station";
                size: 30px;
                glyph-size: 15px;
                clicked => { root.remove(); }
            }
        }
    }
}

// One movable section on the Customize screen.
//
// The same drag as TrackRow and for the same reason — see the note there about
// `lift`. Simpler in every other respect: there is nothing to play, nothing to
// remove, and no state but its own position.
component CustomiseRow inherits Rectangle {
    in property <string> label;
    in property <bool> lifted: false;
    in property <length> lift: 0px;
    callback drag-moved(length);
    callback drag-done();
    callback drag-cancelled();

    // Named, but with no default action: the only thing this row does is move,
    // and a drag is not something an action can stand in for. Saying so as a
    // plain list item is honest; claiming a press would do something is not.
    accessible-role: list-item;
    accessible-label: root.label;

    property <bool> held: false;

    height: 52px;
    border-radius: Theme.radius-small;
    background: root.lifted
        ? Theme.raised
        : (touch.has-hover ? Theme.hover : Theme.glass);
    border-width: 1px;
    border-color: root.lifted ? Theme.accent : Theme.border;
    drop-shadow-blur: root.lifted ? 16px : 0px;
    drop-shadow-color: #00000066;
    animate background { duration: Theme.quick; easing: ease-out; }

    touch := TouchArea {
        mouse-cursor: grab;
        moved => {
            if (self.pressed && (root.held || Math.abs(self.mouse-y - self.pressed-y) > 4px)) {
                root.held = true;
                root.drag-moved(self.mouse-y - self.pressed-y + root.lift);
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up) {
                if (root.held) {
                    root.drag-done();
                }
                root.held = false;
            }
            if (event.kind == PointerEventKind.cancel) {
                root.drag-cancelled();
                root.held = false;
            }
        }
    }

    HorizontalLayout {
        padding-left: Theme.gap;
        padding-right: Theme.gap;
        spacing: Theme.gap;

        VerticalLayout {
            alignment: center;
            Icon {
                glyph: Icons.grip;
                tint: Theme.faint;
                width: 16px;
                height: 16px;
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;

            Text {
                text: root.label;
                font-size: Theme.body-size;
                color: Theme.text;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

component TrackRow inherits Rectangle {
    in property <Track> track;
    // Already played: the official controller dims everything above the cursor.
    in property <bool> spent: false;
    in property <bool> editing: false;
    // Being dragged. The row under the pointer is lifted out of the list rather
    // than moved, because the list is the player's order until the drop lands.
    in property <bool> lifted: false;
    // How far the row has already been moved from its slot. The pointer offset
    // is measured inside this row, and the row moves with the pointer, so the
    // offset comes back short by exactly this much — it has to be added back or
    // a drag converges instead of tracking.
    in property <length> lift: 0px;
    callback play();
    // Where the row is: its top, and its right edge. The menu opens against
    // both, so it lands beside the row that asked for it rather than always in
    // the same corner.
    callback open-menu(length, length);
    callback remove();
    callback drag-moved(length);
    callback drag-done();
    callback drag-cancelled();

    // Title as the name, artist and length as the detail, so a queue read
    // aloud is a list of songs rather than a list of sentences. Whether this
    // is the one playing is worth saying and is not visible in either.
    accessible-role: list-item;
    accessible-label: root.track.title;
    accessible-description: root.track.artist + ", " + root.track.duration
        + (root.track.cursor ? ", playing" : "");
    accessible-enabled: !root.editing;
    accessible-action-default => {
        if (!root.editing) {
            root.play();
        }
    }

    // True once a press has traveled far enough to be a drag rather than a
    // click. Queue rows are narrow and reordering by a twitch is worse than
    // needing a firmer gesture.
    property <bool> held: false;

    height: 52px;
    border-radius: Theme.radius-small;
    background: root.lifted
        ? Theme.raised
        : (root.track.live
            ? Theme.selected
            : (touch.has-hover ? Theme.hover : transparent));
    border-width: root.lifted ? 1px : 0px;
    border-color: Theme.accent;
    opacity: root.spent && !root.editing ? 0.5 : 1.0;
    drop-shadow-blur: root.lifted ? 16px : 0px;
    drop-shadow-color: #00000066;
    animate background { duration: Theme.quick; easing: ease-out; }
    animate opacity { duration: Theme.quick; }

    touch := TouchArea {
        moved => {
            // The scroll view's Flickable is built non-interactive, so it hands
            // every pointer event down rather than claiming the drag.
            if (self.pressed && (root.held || Math.abs(self.mouse-y - self.pressed-y) > 6px)) {
                root.held = true;
                root.drag-moved(self.mouse-y - self.pressed-y + root.lift);
            }
        }
        pointer-event(event) => {
            // Committed on release rather than on `clicked`, for the reason the
            // scrubber does the same: `clicked` cannot tell a tap from the end
            // of a drag.
            if (event.kind == PointerEventKind.up) {
                // The right button asks what can be done with the row, which
                // is what a right button means everywhere else. Anywhere on
                // the row, so it does not need the dots to be hit.
                if (event.button == PointerEventButton.right) {
                    root.open-menu(
                        root.absolute-position.y,
                        root.absolute-position.x + root.width);
                } else if (root.held) {
                    root.drag-done();
                // Not while editing. The row is a target for a bin and a grip
                // then, and a finger that misses both should not start the
                // track playing.
                } else if (!root.editing) {
                    root.play();
                }
                root.held = false;
            }
            if (event.kind == PointerEventKind.cancel) {
                root.drag-cancelled();
                root.held = false;
            }
        }
    }

    HorizontalLayout {
        padding-left: Theme.gap;
        padding-right: Theme.gap;
        spacing: Theme.gap;

        VerticalLayout {
            alignment: center;

            Artwork {
                source: root.track.cover;
                corner: Theme.radius-art;
                width: 36px;
                height: 36px;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            // Without this the row's minimum width is the full untruncated
            // title, and a fixed-width panel gets painted straight through.
            min-width: 0px;

            Text {
                text: root.track.title;
                font-size: Theme.body-size;
                font-weight: root.track.cursor ? 600 : 400;
                color: root.track.cursor ? Theme.accent : Theme.text;
                overflow: elide;
            }

            Text {
                text: root.track.artist;
                font-size: Theme.small-size;
                color: Theme.dim;
                overflow: elide;
            }
        }

        // What the player says the format is, in its own words.
        if root.track.quality != "" && !root.editing: VerticalLayout {
            alignment: center;

            Rectangle {
                height: 18px;
                width: format.preferred-width + 12px;
                border-radius: 4px;
                background: Theme.raised;
                border-width: 1px;
                border-color: Theme.border;

                format := Text {
                    text: root.track.quality;
                    font-size: Theme.micro-size;
                    font-weight: 700;
                    letter-spacing: 0.4px;
                    color: Theme.faint;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
        }

        // Centered by its own layout, like the badge beside it. Left as a
        // direct child of the row it filled the row's height instead, which
        // put the dots above the middle of everything they sit next to.
        if !root.editing && !root.lifted: VerticalLayout {
            alignment: center;

            IconButton {
                glyph: Icons.menu;
                // Named after the track, not the control: fourteen buttons all
                // called "Actions for this track" name nothing at all to
                // anyone stepping through them one at a time.
                label: "Actions for " + root.track.title;
                size: 30px;
                glyph-size: 15px;
                opacity: touch.has-hover ? 1.0 : 0.45;
                animate opacity { duration: Theme.quick; }
                clicked => {
                    root.open-menu(
                        root.absolute-position.y,
                        root.absolute-position.x + root.width);
                }
            }
        }

        if !root.editing: Text {
            text: root.track.duration;
            font-size: Theme.small-size;
            color: Theme.faint;
            vertical-alignment: center;
            horizontal-alignment: right;
            width: 36px;
        }

        // In Edit mode the row trades what it says for what can be done to it,
        // which is what the official controller does too: the menu and the
        // running time give way to a delete and a grip.
        // Centered by its own layout, like the grip beside it. As a direct
        // child it filled the row's height instead and sat above the middle of
        // everything next to it — the same thing the menu button used to do.
        if root.editing: VerticalLayout {
            alignment: center;

            IconButton {
                glyph: Icons.clear;
                label: "Remove from the queue";
                size: 26px;
                glyph-size: 15px;
                tint: Theme.dim;
                clicked => { root.remove(); }
            }
        }

        // The grip: always there while editing, and while a row is actually
        // being dragged outside it. Shown in the menu button's place rather
        // than beside it, and at the same width, so picking a row up does not
        // shuffle everything on that end of it.
        if root.editing || root.lifted: VerticalLayout {
            alignment: center;
            width: root.editing ? 15px : 30px;

            Icon {
                glyph: Icons.grip;
                tint: Theme.faint;
                width: 15px;
                height: 15px;
            }
        }
    }
}

// The caption over the playing row, and over the one after it.
//
// Two captions rather than two lists: everything below "Up Next" is still the
// same queue, and the official controller marks exactly these two rows.
component QueueBand inherits HorizontalLayout {
    in property <string> label;

    height: 26px;
    padding-left: Theme.gap;

    Text {
        text: root.label;
        font-size: Theme.micro-size;
        font-weight: 700;
        letter-spacing: 0.8px;
        color: Theme.faint;
        vertical-alignment: bottom;
    }
}

component BrowseRowView inherits Rectangle {
    in property <BrowseRow> entry;
    callback activate();
    callback open-menu(length, length);

    // A heading is a row that is not a result, and a row the player marked
    // unactionable cannot be opened — both are reported unavailable rather
    // than given a press that would do nothing. `actionable` is the player's
    // own word for it, so this follows the screen rather than guessing.
    accessible-role: list-item;
    accessible-label: root.entry.title;
    accessible-description: root.entry.subtitle;
    accessible-enabled: root.entry.actionable && !root.entry.heading;
    accessible-action-default => {
        if (root.entry.actionable) {
            root.activate();
        }
    }

    height: root.entry.heading ? 30px : 52px;
    border-radius: Theme.radius-small;
    background: (root.entry.heading || !root.entry.actionable)
        ? transparent
        : (touch.has-hover ? Theme.hover : transparent);
    animate background { duration: Theme.quick; easing: ease-out; }

    touch := TouchArea {
        // Also where the row only has a menu. A row that leads nowhere but
        // offers one — an album you can queue without opening — would
        // otherwise be a dead surface with a live pair of dots on it.
        enabled: (root.entry.actionable || root.entry.has-menu) && !root.entry.heading;
        clicked => {
            if (root.entry.actionable) {
                root.activate();
            }
        }
        pointer-event(event) => {
            // The right button asks what can be done with the row, anywhere
            // along it, wherever there are dots to have pressed instead.
            if (event.kind == PointerEventKind.up
                && event.button == PointerEventButton.right
                && root.entry.has-menu) {
                root.open-menu(
                    root.absolute-position.y,
                    root.absolute-position.x + root.width);
            }
        }
    }

    if root.entry.heading: HorizontalLayout {
        padding-left: Theme.gap;
        alignment: start;

        SectionLabel {
            prose: true;
            text: root.entry.title;
            vertical-alignment: bottom;
        }
    }

    if !root.entry.heading: HorizontalLayout {
        padding-left: Theme.gap;
        padding-right: Theme.gap;
        spacing: Theme.gap;

        // Its place on the record, where the screen is about one record.
        if root.entry.track != "": VerticalLayout {
            alignment: center;

            Text {
                text: root.entry.track;
                font-size: Theme.small-size;
                color: Theme.faint;
                horizontal-alignment: right;
                vertical-alignment: center;
                width: 20px;
            }
        }

        VerticalLayout {
            alignment: center;

            // A box of a fixed size holding whichever of the two the row has,
            // so the play badge can sit on top of either. Sized here rather
            // than by its contents: the box is what keeps the row's height
            // steady whichever branch is taken.
            Rectangle {
                width: 36px;
                height: 36px;

                // `if`, not `visible`: a hidden element still takes its space
                // in a layout, so using visibility here gave every glyph row a
                // second 36px of invisible artwork and pushed the rows below
                // it down.
                if root.entry.is-glyph: Rectangle {
                    width: 36px;
                    height: 36px;
                    // The same shape and ground as the Artwork below, which is
                    // its alternative in this slot. They were 5px on `raised`
                    // against 6px on `sunken`, so a shelf mixing inputs with
                    // albums drew two different tiles for the same thing —
                    // most visible on Home, where they sit side by side.
                    border-radius: Theme.radius-art;
                    background: Theme.raised;

                    Icon {
                        glyph: root.entry.cover;
                        tint: root.entry.playing ? Theme.accent : Theme.dim;
                        width: 19px;
                        height: 19px;
                    }
                }

                if !root.entry.is-glyph: Artwork {
                    well: Theme.raised;
                    source: root.entry.cover;
                    // A note rather than a radio: most of what reaches this
                    // fallback is a library row whose art has not arrived, and
                    // an artist with a radio beside their name reads as a
                    // station.
                    fallback: Icons.track;
                    corner: Theme.radius-art;
                    width: 36px;
                    height: 36px;
                    // A browse row shows covers and service logos alike.
                    crop: false;
                }

                // What pressing the row will do, said before it is pressed.
                // The cover is too small here for a disc the way a tile has
                // one, so the whole of it dims and the glyph sits on that.
                if root.entry.plays && !root.entry.playing: Rectangle {
                    border-radius: 5px;
                    background: #000000b8;
                    opacity: touch.has-hover ? 1.0 : 0.0;
                    animate opacity { duration: Theme.quick; easing: ease-out; }

                    Icon {
                        // See the tile: a triangle looks off in a centered box.
                        x: (parent.width - self.width) / 2 + 1px;
                        glyph: Icons.play;
                        tint: Theme.text;
                        width: 15px;
                        height: 15px;
                    }
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            min-width: 0px;

            Text {
                text: root.entry.title;
                font-size: Theme.body-size;
                color: root.entry.actionable ? Theme.text : Theme.dim;
                overflow: elide;
            }

            if root.entry.subtitle != "": Text {
                text: root.entry.subtitle;
                font-size: Theme.small-size;
                color: Theme.dim;
                overflow: elide;
            }
        }

        // What the player says the file is. Only an album's own page says.
        if root.entry.quality != "": VerticalLayout {
            alignment: center;

            Rectangle {
                height: 18px;
                width: grade.preferred-width + 12px;
                border-radius: 4px;
                background: Theme.raised;
                border-width: 1px;
                border-color: Theme.border;

                grade := Text {
                    text: root.entry.quality;
                    font-size: Theme.micro-size;
                    font-weight: 700;
                    letter-spacing: 0.4px;
                    color: Theme.faint;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
        }

        // Always there, not only under the pointer. It is how a whole album
        // gets played, and hunting for a control that appears when you are
        // already on top of it is a poor way to find one.
        if root.entry.has-menu: VerticalLayout {
            alignment: center;

            IconButton {
                glyph: Icons.menu;
                label: "Actions for " + root.entry.title;
                size: 34px;
                glyph-size: 16px;
                opacity: touch.has-hover ? 1.0 : 0.5;
                animate opacity { duration: Theme.quick; }
                clicked => {
                    root.open-menu(
                        root.absolute-position.y,
                        root.absolute-position.x + root.width);
                }
            }
        }

        // The chevron says "this opens something" and the dots say "this has a
        // menu". A row with both said the same thing twice over, so the menu
        // wins where there is one.
        if !root.entry.has-menu: VerticalLayout {
            alignment: center;

            Icon {
                glyph: root.entry.playing ? Icons.play : Icons.forward;
                tint: root.entry.playing ? Theme.accent : Theme.faint;
                width: 15px;
                height: 15px;
                visible: root.entry.playing || root.entry.actionable;
            }
        }
    }
}


// A cover on a shelf. The screens that use shelves — Home, and any service's
// front page — are made of artwork, and a list of them a row high wastes the
// only thing they have to say.
component BrowseTile inherits Rectangle {
    in property <BrowseRow> entry;
    callback activate();
    // Where the tile is, so its menu opens against it — the same pair the
    // rows send.
    callback open-menu(length, length);

    // The other shape a browse result takes, named the same way as the row so
    // that a shelf and a list read alike.
    accessible-role: list-item;
    accessible-label: root.entry.title;
    accessible-description: root.entry.subtitle;
    accessible-enabled: root.entry.actionable || root.entry.has-menu;
    accessible-action-default => {
        if (root.entry.actionable) {
            root.activate();
        }
    }

    width: 128px;
    // Sized from the caption rather than fixed. At a fixed height the caption
    // was stretched to swallow whatever was left over — measured at 41px for a
    // caption that wanted 30 — so a tile with no subtitle carried the gap
    // twice: once for the line it did not need and once for the slack.
    height: 6px + 116px + 7px + caption.preferred-height + 6px;
    border-radius: Theme.radius-small;
    background: touch.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.quick; easing: ease-out; }

    // Declared before the contents on purpose. A later sibling sits
    // above an earlier one for hit-testing as well as drawing, so with
    // this last the dots over the artwork were covered by it and a
    // left-click on them opened the album instead of its menu.
    touch := TouchArea {
        // A tile with a menu but nowhere to go is still worth pressing.
        enabled: root.entry.actionable || root.entry.has-menu;
        clicked => {
            if (root.entry.actionable) {
                root.activate();
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up
                && event.button == PointerEventButton.right
                && root.entry.has-menu) {
                root.open-menu(
                    root.absolute-position.y,
                    root.absolute-position.x + root.width);
            }
        }
    }

    VerticalLayout {
        padding: 6px;
        spacing: 7px;

        Rectangle {
            height: 116px;
            // Matched to the artwork it clips. At 7px against the cover's 8px
            // the parent was the rounder of the two, so it shaved the corners
            // off every sleeve on a shelf.
            border-radius: 8px;
            background: Theme.raised;
            clip: true;

            if root.entry.is-glyph: Icon {
                glyph: root.entry.cover;
                tint: root.entry.playing ? Theme.accent : Theme.dim;
                width: 38px;
                height: 38px;
            }

            if !root.entry.is-glyph: Artwork {
                well: Theme.raised;
                source: root.entry.cover;
                fallback: Icons.track;
                corner: 8px;
                width: parent.width;
                height: parent.height;
                crop: false;
            }

            // Over the corner of the art, because a tile has no margin to put
            // it in. On its own dark disc so it stays legible against a sleeve
            // of any color, and only once the tile is under the pointer — a
            // shelf of these with a permanent dot on every one would read as
            // clutter where a list of rows does not.
            if root.entry.has-menu: Rectangle {
                x: parent.width - self.width - 4px;
                y: 4px;
                width: 26px;
                height: 26px;
                border-radius: self.height / 2;
                background: #000000a6;
                opacity: touch.has-hover || dots.has-hover ? 1.0 : 0.0;
                animate opacity { duration: Theme.quick; }

                Icon {
                    glyph: Icons.menu;
                    tint: Theme.text;
                    width: 15px;
                    height: 15px;
                }

                dots := TouchArea {
                    accessible-role: button;
                    accessible-label: "Actions for " + root.entry.title;
                    accessible-action-default => {
                        root.open-menu(
                            root.absolute-position.y,
                            root.absolute-position.x + root.width);
                    }
                    mouse-cursor: pointer;
                    clicked => {
                        root.open-menu(
                            root.absolute-position.y,
                            root.absolute-position.x + root.width);
                    }
                }
            }

            // What pressing the tile will do, said before it is pressed.
            //
            // An album and a track look identical on a shelf and do opposite
            // things — one opens, one starts playing — and the only way to
            // find out was to press. Shown on hover for the same reason the
            // dots are: a play badge on every tile at rest would read as a
            // shelf of buttons rather than a shelf of records.
            //
            // Not on the one already playing: the accent marker below says
            // that, and two discs on one sleeve is noise.
            if root.entry.plays && !root.entry.playing: Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 42px;
                height: 42px;
                border-radius: self.height / 2;
                background: #000000b8;
                opacity: touch.has-hover ? 1.0 : 0.0;
                animate opacity { duration: Theme.quick; easing: ease-out; }

                Icon {
                    // Nudged right by an eighth of its width: a triangle's
                    // visual center is left of its bounding box, so centering
                    // the box leaves it looking off.
                    x: (parent.width - self.width) / 2 + 1px;
                    glyph: Icons.play;
                    tint: Theme.text;
                    width: 18px;
                    height: 18px;
                }
            }

            // Marked in the corner rather than across the middle: the cover is
            // the point of the tile. Not a play triangle — that is what the
            // hover badge above uses to say "press this and it will start",
            // and the same shape cannot also mean "this is already playing".
            if root.entry.playing: Rectangle {
                x: parent.width - self.width - 6px;
                y: parent.height - self.height - 6px;
                width: 22px;
                height: 22px;
                border-radius: self.height / 2;
                background: Theme.accent;

                Icon {
                    glyph: Icons.sounding;
                    tint: Theme.accent-ink;
                    width: 11px;
                    height: 11px;
                }
            }
        }

        caption := VerticalLayout {
            spacing: 1px;



            Text {
                text: root.entry.title;
                font-size: Theme.small-size;
                font-weight: 600;
                color: root.entry.playing ? Theme.accent : Theme.text;
                overflow: elide;
            }

            // `if`, not an empty Text: an empty one still occupies its line
            // height, which on a shelf of inputs — none of which carry a
            // subtitle — left a band of nothing under every caption.
            if root.entry.subtitle != "": Text {
                text: root.entry.subtitle;
                font-size: Theme.micro-size;
                color: Theme.faint;
                overflow: elide;
            }
        }
    }

}

// One service in a selector menu. Favorites and Search are per-service on a
// BluOS player, and this strip is how you say which service you mean.
component ServiceChip inherits Rectangle {
    in property <BrowseRow> entry;
    callback activate();

    // Which service you are looking at is the whole point of the row of these,
    // so the selected one says so rather than leaving it to the accent color.
    accessible-role: list-item;
    accessible-label: root.entry.title;
    accessible-item-selectable: true;
    accessible-item-selected: root.entry.selected;
    accessible-action-default => { root.activate(); }

    height: 32px;
    width: caption.preferred-width + 50px;
    border-radius: Theme.radius-small;
    background: root.entry.selected
        ? Theme.accent-soft
        : (touch.pressed ? Theme.pressed : (touch.has-hover ? Theme.hover : Theme.raised));
    border-width: 1px;
    border-color: root.entry.selected ? Theme.accent : Theme.border;
    animate background { duration: Theme.quick; easing: ease-out; }

    HorizontalLayout {
        alignment: center;
        spacing: 7px;
        padding-left: 12px;
        padding-right: 14px;

        VerticalLayout {
            alignment: center;

            if root.entry.is-glyph: Icon {
                glyph: root.entry.cover;
                tint: root.entry.selected ? Theme.accent : Theme.dim;
                width: 16px;
                height: 16px;
            }

            if !root.entry.is-glyph: Image {
                source: root.entry.cover;
                image-fit: contain;
                width: 16px;
                height: 16px;
            }
        }

        caption := Text {
            text: root.entry.title;
            font-size: Theme.small-size;
            font-weight: root.entry.selected ? 600 : 400;
            color: root.entry.selected ? Theme.text : Theme.dim;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.activate(); }
    }
}

// A search box.
//
// Drawn rather than a `LineEdit` because the official controller puts a
// magnifier inside the field, and a std-widget will not have anything else in
// its frame.
component SearchField inherits Rectangle {
    in property <string> prompt: "Search";
    in-out property <string> text;
    callback edited(string);
    callback accepted(string);
    /// Escape was pressed with the caret in here. The owner decides what to
    /// hand the caret to next; this only says the box is done with it.
    callback escaped();
    /// Whether the caret is in here. Read by anything that would otherwise
    /// take focus away from someone mid-word.
    out property <bool> typing: input.has-focus;
    /// Put the caret in here, and select what is already there.
    ///
    /// For the keyboard, which cannot reach inside an `if` to find this element
    /// and has to be handed a way in. Selecting matters on the way back to a
    /// screen that kept its query: the next keystroke replaces it, and Delete
    /// clears it, without reaching for the mouse or holding backspace down.
    /// Clicking in is left alone — a click is a request to edit in place.
    public function take-focus() {
        input.focus();
        input.select-all();
    }

    height: 38px;
    border-radius: Theme.radius-small;
    background: Theme.sunken;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    animate border-color { duration: Theme.quick; easing: ease-out; }

    HorizontalLayout {
        padding-left: Theme.pad;
        padding-right: Theme.pad;
        spacing: Theme.gap;

        VerticalLayout {
            alignment: center;

            Icon {
                glyph: Icons.search;
                tint: input.has-focus ? Theme.accent : Theme.faint;
                width: 15px;
                height: 15px;
            }
        }

        Rectangle {
            horizontal-stretch: 1;

            if root.text == "": Text {
                x: 0;
                width: parent.width;
                height: parent.height;
                text: root.prompt;
                font-size: Theme.body-size;
                color: Theme.faint;
                vertical-alignment: center;
                overflow: elide;
            }

            input := TextInput {
                width: parent.width;
                height: parent.height;
                text <=> root.text;
                font-size: Theme.body-size;
                color: Theme.text;
                selection-background-color: Theme.accent-soft;
                selection-foreground-color: Theme.text;
                vertical-alignment: center;
                single-line: true;
                edited => { root.edited(self.text); }
                accepted => { root.accepted(self.text); }
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        root.escaped();
                        return EventResult.accept;
                    }
                    return EventResult.reject;
                }
            }
        }

        // Only with something to clear, so the box is not carrying a dead
        // button the rest of the time.
        if root.text != "": VerticalLayout {
            alignment: center;

            IconButton {
                // `close`, not `clear`: the latter is a waste basket, which
                // says the query is being thrown away rather than the box
                // being emptied.
                glyph: Icons.close;
                label: "Clear the search box";
                size: 26px;
                glyph-size: 13px;
                clicked => {
                    root.text = "";
                    // The results follow the keys, so emptying it by hand has
                    // to say so exactly as a backspace would.
                    root.edited("");
                    input.focus();
                }
            }
        }
    }
}

// A bar for work with no end in sight.
//
// The player reports how many songs it has indexed and never how many there
// are, so there is no percentage to draw and pretending otherwise would be
// inventing one. This says "still going" honestly; the count beside it says
// how far.
component Indeterminate inherits Rectangle {
    height: 4px;
    border-radius: 2px;
    background: Theme.sunken;
    clip: true;

    property <bool> swung: false;

    // The bar it lives in is always built — it animates its own collapse, so
    // it cannot be an `if` — which left this timer waking the whole event loop
    // every 1.1 seconds for the life of the process, to slide a rectangle
    // nobody could see. The owner says when there is something to show.
    in property <bool> sweeping: true;

    Rectangle {
        width: parent.width * 0.32;
        height: parent.height;
        border-radius: 2px;
        background: Theme.accent;
        x: root.swung ? parent.width - self.width : 0px;
        animate x { duration: 1100ms; easing: ease-in-out; }
    }

    Timer {
        interval: 1100ms;
        running: root.sweeping;
        triggered => { root.swung = !root.swung; }
    }
}

// One section, drawn the way it asked to be.
component BrowseBlockView inherits VerticalLayout {
    in property <BrowseBlock> block;
    callback activate(int);
    callback open-menu(int, length, length);
    callback section-action(int);

    if root.block.kind == 2: HorizontalLayout {
        padding-left: Theme.pad;
        padding-right: Theme.pad;
        padding-bottom: Theme.pad;
        spacing: Theme.gap;
        alignment: start;

        accessible-role: list;
        accessible-item-count: root.block.rows.length;

        for entry[i] in root.block.rows: ServiceChip {
            entry: entry;
            accessible-item-index: i;
            activate => { root.activate(entry.index); }
        }
    }

    // A section that leads somewhere and holds nothing. Drawn as a row rather
    // than as an empty shelf with a caption over it.
    if root.block.kind == 3: Rectangle {
        height: 52px;
        border-radius: Theme.radius-small;
        background: into.has-hover ? Theme.hover : transparent;
        animate background { duration: Theme.quick; easing: ease-out; }

        HorizontalLayout {
            padding-left: Theme.pad;
            padding-right: Theme.pad;

            Text {
                text: root.block.title;
                font-size: Theme.body-size;
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }

            VerticalLayout {
                alignment: center;

                Icon {
                    glyph: Icons.forward;
                    tint: Theme.faint;
                    width: 15px;
                    height: 15px;
                }
            }
        }

        into := TouchArea {
            clicked => { root.section-action(root.block.section); }
        }
    }

    if root.block.kind != 2 && root.block.kind != 3 && root.block.title != "": HorizontalLayout {
        padding-left: Theme.pad;
        padding-right: Theme.pad;
        padding-top: Theme.tight;
        padding-bottom: Theme.tight;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;

            SectionLabel { prose: true; text: root.block.title; }
        }

        if root.block.action != "": VerticalLayout {
            alignment: center;

            Rectangle {
                height: 22px;
                width: more.preferred-width + 20px;
                border-radius: Theme.radius-small;
                background: shelf.pressed
                    ? Theme.pressed
                    : (shelf.has-hover ? Theme.hover : transparent);
                border-width: 1px;
                border-color: Theme.border;
                animate background { duration: Theme.quick; easing: ease-out; }

                more := Text {
                    accessible-role: none;
                    text: root.block.action;
                    font-size: Theme.micro-size;
                    font-weight: 600;
                    letter-spacing: 0.6px;
                    color: shelf.has-hover ? Theme.text : Theme.dim;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }

                shelf := TouchArea {
                    accessible-role: button;
                    accessible-label: root.block.action;
                    accessible-action-default => {
                        root.section-action(root.block.section);
                    }
                    clicked => { root.section-action(root.block.section); }
                }
            }
        }
    }

    // A shelf runs off the side of the pane, as it does in the official
    // controller: the alternative is a wall of covers that pushes everything
    // below it off the screen.
    if root.block.kind == 1: Flickable {
        // As tall as the tiles need, not a fixed figure. A shelf of inputs has
        // no subtitles and so wants less than one of records; asking the tiles
        // is how the two stay right without the number being written twice.
        height: tiles.preferred-height;
        viewport-width: root.block.rows.length * 128px + 2 * Theme.pad;
        viewport-height: self.height;

        tiles := HorizontalLayout {
            accessible-role: list;
            accessible-item-count: root.block.rows.length;
            x: Theme.pad;
            width: root.block.rows.length * 128px;
            height: self.preferred-height;
            alignment: start;

            // Top-aligned rather than left to the layout's own cross-axis
            // placement. A shelf can mix a tile that has a subtitle with one
            // that has not — Recently Played holds both records and artists —
            // and those are now different heights, so without this the shorter
            // one could sit centered and its cover would ride below its
            // neighbors'.
            for entry[i] in root.block.rows: VerticalLayout {
                alignment: start;

                BrowseTile {
                    entry: entry;
                    accessible-item-index: i;
                    activate => { root.activate(entry.index); }
                    open-menu(y, right) => { root.open-menu(entry.index, y, right); }
                }
            }
        }
    }

    if root.block.kind == 0: VerticalLayout {
        // A block is one shelf or list on a browse screen, so the set is this
        // block's rows rather than everything on the screen — which is what a
        // reader stepping through it is actually inside.
        accessible-role: list;
        accessible-item-count: root.block.rows.length;

        for entry[i] in root.block.rows: BrowseRowView {
            entry: entry;
            accessible-item-index: i;
            activate => { root.activate(entry.index); }
            open-menu(y, right) => { root.open-menu(entry.index, y, right); }
        }
    }
}

export component AppWindow inherits Window {

    in property <[Device]> devices;
    in property <[Track]> queue;
    in property <image> cover;
    // A color taken from the artwork, washed behind the now-playing panel.
    in property <color> cover-tint;
    in property <bool> has-tint: false;
    in property <string> queue-line: "";
    // How many players have answered. Shown where the players are.
    in property <string> players-line: "";
    // Which row of the queue the player is sitting on, or -1. Worked out in
    // Rust because it needs the status, which the row model does not carry.
    in property <int> queue-cursor: -1;
    in property <[QueueButton]> queue-buttons;
    // Whatever did not fit on the line above.
    in property <[QueueButton]> queue-buttons-below;
    // The last thing worth telling the user, cleared a few seconds later by
    // the toast that shows it. In-out because the clearing happens in the
    // window rather than back in the backend.
    in-out property <string> status-line: "";
    // "Indexing — 1204 songs processed", or empty when it is not.
    in property <string> indexing: "";
    // What the player says it is decoding: "cd", "hd", "mqa".
    in property <string> quality: "";
    // The player's own phrase for what it is decoding — "MP3 128 kb/s",
    // "FLAC 24/44.1". Says what the badge beside it cannot: the codec, and the
    // depth and rate behind a tier. Shown only where there is room for it.
    in property <string> stream-format: "";
    in property <[TrackAction]> track-actions;
    callback track-action(string);
    // Whether the middle pane is showing the record rather than a screen.
    in property <bool> now-playing: false;
    in property <[BrowseBlock]> browse-blocks;
    // What a screen about one thing says about it, straight from the player:
    // an album's cover, who made it, when, and what to do with the whole of it.
    in property <image> browse-header-cover;
    in property <string> browse-header-title: "";
    in property <string> browse-header-subtitle: "";
    in property <string> browse-header-detail: "";
    in property <[ActionButton]> browse-header-buttons;
    // A screen that is about one music service at a time — Favorites and
    // Search both are — names the others so you can switch.
    in property <[BrowseRow]> browse-selector;
    in property <string> browse-service: "";
    in property <image> browse-service-icon;
    // The app's own list. The player keeps no search history.
    in property <[string]> browse-recent;
    // What is in the search box. On the window rather than inside the field
    // because the recent list has to be able to fill it in, and the two sit in
    // separate conditional blocks that cannot see each other.
    in-out property <string> browse-query: "";
    // What the player says to draw where the rows would be, when there are
    // none. It writes both lines itself — "You don't have any Favourites on
    // Library" is its sentence, and it knows which service it means.
    // Whether the first discovery sweep is still running. Distinguishes "no
    // speakers here" from "no speakers yet", which are different sentences and
    // want different words.
    // One per row of `devices`, in the same order. Beside the model rather
    // than inside it because `Device` is held on the backend across threads
    // and an image cannot travel with it; both are set in one place so the
    // indices cannot drift.
    in property <[image]> device-covers;
    in property <bool> looking-for-players: false;
    in property <string> browse-empty: "";
    in property <string> browse-empty-detail: "";
    in property <image> browse-empty-icon;
    in property <string> browse-title: "Browse";
    in property <bool> browse-can-go-back: false;
    in property <bool> browse-has-search: false;
    in property <string> browse-search-prompt: "Search";
    in property <int> position;
    in property <int> duration;
    in property <string> position-text;
    in property <string> duration-text;
    in property <bool> seekable: false;
    in property <bool> shuffle: false;
    // 0 all, 1 one, 2 off — BluOS's numbering, not a guess.
    in property <int> repeat: 2;
    in property <[SidebarRow]> sidebar;
    in property <[SettingItem]> settings;
    in property <bool> in-settings: false;
    // Whether the middle pane is showing the player's screens rather than one
    // of the app's own.
    //
    // Every piece of browse chrome — the selector, the search field, the
    // header, the list, its empty state — used to test `!in-settings` for
    // itself, in seven places. Adding a pane then meant remembering all seven,
    // and the stations pane was drawn over a Home screen still showing its
    // shelves because it was not. One property, so the next pane is one line.
    property <bool> browse-pane: !root.in-settings && !root.in-stations;
    // Whether a search box is actually on screen, which is not what
    // `browse-has-search` answers: that one is set by `publish_browse` alone
    // and so describes the last browse screen visited, however long ago you
    // left it. The two places that drew the box tested the pane as well; the
    // two that read the key did not, and a `/` on Settings after one visit to
    // Search went to a box that was not there. Worse, `claim` refused the
    // caret for the same reason, which left the whole window without a
    // keyboard on every pane but Browse.
    property <bool> searchable: root.browse-pane && root.browse-has-search;
    in-out property <int> selected: 0;

    callback toggle(string);
    callback skip(string);
    callback back(string);
    callback set-volume(string, int);
    callback toggle-mute(string);
    callback select(string);
    callback toggle-group(string);
    callback play-track(string, int);
    callback browse-activate(int);
    callback browse-menu(int);
    callback browse-back();
    callback browse-home();
    callback browse-search(string);
    callback browse-search-done(string);
    callback browse-section(int);
    callback browse-header(int);
    callback toggle-now-playing();
    callback browse-more();
    callback queue-more();
    // The letters a long list can be jumped to — "#", "A", "B", and whatever
    // else a collection turns up. The player works out where each one starts;
    // the window only ever sends back which was chosen.
    in property <[string]> browse-index;
    // Whether the search box holds the caret. Only the search box writes it,
    // and only the jump bar reads it — to keep out of the way.
    in-out property <bool> browse-typing: false;
    // Counters the keyboard bumps, for the three things it cannot reach
    // directly: the search box and the list both live inside `if` blocks, and
    // an element inside one cannot be named from outside it.
    in-out property <int> focus-search: 0;
    // Set when the keyboard asked for search on a screen that has no box, so
    // the box focuses itself as soon as the screen carrying it arrives.
    in-out property <bool> want-search: false;
    callback open-search();
    in-out property <int> browse-to-top: 0;
    in-out property <int> browse-to-end: 0;
    in-out property <int> browse-page: 0;
    // Which way that page goes. Read only when the counter moves.
    in-out property <bool> browse-page-down: true;
    // Whether the list is a window on something longer, in which case its ends
    // are a fetch rather than a scroll.
    in property <bool> browse-paged: false;
    callback browse-ends(bool);
    callback browse-jump(string);
    // Bumped by the backend each time a jump lands, because replacing a
    // model does not move a Flickable and the new rows would otherwise appear
    // under whatever scroll position the old ones had.
    in-out property <int> browse-jumped: 0;
    // Where that jump landed, in pixels down the list. Zero for a jump that
    // fetched its rows, since those replaced what was there; a real offset for
    // a list held whole, where the letter is already on screen somewhere.
    in property <float> browse-jump-y: 0;
    callback clear-recent();
    // The cover reduced to a wash. Slint has no blur, so the softening is
    // done in the pixels before they arrive — see artwork::frosted.
    in property <image> cover-blur;
    in-out property <bool> queue-shown: true;
    callback now-playing-info();
    // Rearranging a screen's sections. The titles only — the ids they map to
    // stay in the backend, because nothing here needs to name them.
    in property <bool> customising;
    in property <string> customise-title;
    in property <[string]> customise-rows;
    callback customise-move(int, int);
    callback customise-save();
    callback group-all();
    callback pause-all();
    callback queue-reorder(int, int);
    callback queue-remove(int);
    callback queue-save(string);
    callback queue-button(int);
    // The context menu for one queue row: what the player offers for that
    // track, drawn against the row rather than in place of the screen.
    in property <[ActionButton]> queue-menu-rows;
    in property <string> queue-menu-title;
    in property <string> queue-menu-subtitle;
    in property <image> queue-menu-cover;
    in-out property <bool> queue-menu-open: false;
    // Where the row that opened it sits, in window coordinates: its top, and
    // its right edge. The queue's rows sit against the window's right side and
    // a browse row's dots are further in, so the panel follows rather than
    // always opening in the same corner.
    in-out property <length> queue-menu-y: 0px;
    in-out property <length> queue-menu-right: 0px;
    callback queue-menu(int, length);
    callback queue-menu-activate(int);
    // The input waiting to be confirmed, by name. Empty when nothing is.
    // The alarms editor's own strip, which is the part settings rows cannot
    // draw: a time, a finishing time where the player supports one, and seven
    // days. Everything else on the page is an ordinary settings row.
    in property <bool> alarm-editing: false;
    in property <bool> alarm-schedule: false;
    in property <int> alarm-hour;
    in property <int> alarm-minute;
    in property <int> alarm-end-hour;
    in property <int> alarm-end-minute;
    in property <[bool]> alarm-days;
    // Sunday first, because that is the end of the week the player writes
    // `days` from. Sent with the data so the two cannot disagree.
    in property <[string]> alarm-letters;
    in property <string> alarm-repeat;
    callback alarm-start-changed(int, int);
    callback alarm-end-changed(int, int);
    callback alarm-day-toggled(int);

    in-out property <string> confirm-input: "";

    // The firmware question. Named separately from `confirm-input` because the
    // two are not the same kind of question: one stops the music, the other
    // rewrites the player and cannot be taken back.
    in-out property <string> confirm-upgrade: "";
    callback answer-upgrade(bool);

    // A player that has new firmware waiting, said once when it turns up.
    // Not the same question as `confirm-upgrade`: this one only offers to
    // show the page, and installs nothing.
    in-out property <string> update-notice: "";
    callback answer-update-notice(bool);

    // What a player is doing while it upgrades itself. Empty when none is.
    in property <string> upgrading-player: "";
    in property <string> upgrading-stage: "";
    in property <float> upgrading-percent: 0;

    // The player's own question — "Playing replaces Play Queue" and its like.
    // Its wording and its buttons are the player's; this only draws them.
    in property <bool> dialog-open: false;
    in property <string> dialog-title;
    in property <string> dialog-body;
    in property <[DialogButton]> dialog-buttons;
    callback dialog-press(int);
    callback answer-input(bool);
    callback sidebar-activate(int, int);
    callback open-settings();
    callback setting-toggle(int);
    callback setting-choose(int, int);
    callback setting-number(int, float);
    callback setting-text(int, string);
    callback setting-open(int);
    callback open-help();
    callback open-stations();
    // The stations typed in by hand. `in-stations` is the pane's own "I am
    // showing" flag, answered by publish_pane like every other one.
    in property <bool> in-stations: false;
    in property <[MyStation]> stations;
    in property <bool> stations-editing: false;
    callback stations-edit();
    callback station-add(string, string);
    callback station-play(int);
    callback station-rename(int, string);
    callback station-remove(int);
    callback station-move(int, int);
    callback seek(string, int);
    callback toggle-shuffle(string);
    callback cycle-repeat(string);
    callback rescan();
    callback add-player(string);

    title: "Azzurro";
    // The window's own icon, which is not the executable's.
    //
    // On Windows the .exe carries an icon resource and that is what the
    // taskbar and Explorer read — but the one in the title bar comes from the
    // window itself, and a window that never sets one shows nothing there. The
    // two are separate and both have to be answered.
    //
    // 256px because it is scaled to whatever each place wants: 16 in a title
    // bar at 100%, twice that at 200%, and larger again in a switcher.
    icon: @image-url("../desktop/blue.azzurro.Azzurro-256.png");
    // Geist, bundled — see ui/fonts/LICENSE. Bundled rather than asked of the
    // system so the app looks the same however it is installed, which matters
    // more once it ships as a Flatpak with only the runtime's fonts to hand.
    default-font-family: "Geist";
    default-font-size: Theme.body-size;
    // Three columns, and the middle one should be the widest. The sidebar is
    // 268 and the queue 330; at the 1100 this used to open at, the part being
    // read was barely wider than the two edges put together.
    preferred-width: 1440px;
    preferred-height: 920px;
    // No min-width. This said 900px, which the window could not honor: the
    // transport bar's own minimum measures 948px, so dragging down to 900 did
    // not shrink the bar, it pushed the last control in it — the button that
    // hides the queue — off the right edge where nothing could reach it.
    // Letting the layout state its own minimum keeps that from happening
    // again the next time something joins that row. Height still needs saying,
    // since nothing in the window is tall enough to insist on one.
    min-height: 560px;
    background: Theme.bg;

    property <bool> has-selection: root.devices.length > 0
        && root.selected >= 0
        && root.selected < root.devices.length;
    property <Device> current: root.has-selection
        ? root.devices[root.selected]
        : { name: "", now-playing: "", service: "" };

    // The ground everything else is translucent over.
    Rectangle {
        background: @linear-gradient(155deg,
            Theme.backdrop-top 0%,
            Theme.backdrop-bottom 68%);
    }

    // The record's own color, spread wide and soft. Behind the panels rather
    // than inside one, so it tints the whole window through them.
    Rectangle {
        background: @radial-gradient(circle,
            root.cover-tint.with-alpha(0.30) 0%,
            root.cover-tint.with-alpha(0.10) 38%,
            transparent 72%);
        opacity: root.has-tint ? 1.0 : 0.0;
        animate opacity { duration: Theme.ambient; easing: ease-out; }
    }

    VerticalLayout {
        // Every key the window answers that is not typing.
        //
        // A sibling rather than a wrapper: Slint offers a key only to the
        // focused element and its ancestors, so this holds the focus itself
        // whenever no field wants it. That is also the whole guard against
        // eating someone's typing — a focused TextInput takes the space bar and
        // the backspace before this is ever asked.
        //
        // `height` and not `width`: this sits in a VerticalLayout, where height
        // is the axis being divided and zero simply takes no share of it. A
        // fixed size on the *cross* axis is read as a maximum for the whole
        // row, which is how a zero-width sibling once collapsed the window.
        keys := FocusScope {
            height: 0px;

            // What the letters belong to, so walking to another screen — or
            // out to Settings and back — takes the focus again. A change
            // tracker never fires on creation, hence `init` as well.
            property <string> arrived:
                root.browse-title + "/" + root.browse-index.length
                + "/" + (root.browse-pane ? "browse" : "aside");

            // Search is one screen, not a box on every screen: the player
            // carries a `<search>` on `/ui/Search` and on nothing else —
            // measured, not assumed. So the key focuses the box when there is
            // one and otherwise goes and fetches the screen that has it.
            function reach-search() {
                if (root.searchable) {
                    root.focus-search += 1;
                } else {
                    root.want-search = true;
                    root.open-search();
                }
            }

            function claim() {
                // Never out from under the caret. Backspacing a query down to
                // empty pops the results screen, which changes the title, which
                // fires this — and the next letter went to the jump bar instead
                // of the box it was being typed into. `browse-typing` outlives
                // the box that sets it, so a screen with no box has nobody
                // typing in it.
                // Never on a screen carrying a search box. That box takes
                // the caret when it appears, and this fires on the same
                // publish — whichever ran second used to win. It is also the
                // older guard in stronger form: backspacing a query to empty
                // pops the results crumb back to the search screen, which
                // changed the title, which fired this, and the next letter went
                // to the jump bar instead of the box it was typed into.
                // The screen alone decides, and `browse-typing` deliberately
                // does not appear here. It is set by a box that is destroyed
                // while it still holds the caret, so it never fires false on
                // the way out and stays true for the life of the window —
                // which, when it was consulted, left every letter on the
                // Artists list dead after one visit to Search.
                if (!root.searchable) {
                    self.focus();
                }
            }

            init => {
                root.browse-typing = false;
                self.claim();
            }
            changed arrived => { self.claim(); }

            key-pressed(event) => {
                if (event.text == "") {
                    return EventResult.reject;
                }

                // The only chords. Ctrl with an arrow steps the queue, which
                // is what Spotify and the rest bind it to; the plain letters
                // that would read better are spoken for by the jump bar, and a
                // library where "n" means "next" instead of "N" would be worse
                // than no shortcut.
                if (event.modifiers.control || event.modifiers.meta) {
                    if (root.current.id != "" && event.text == Key.RightArrow) {
                        root.skip(root.current.id);
                        return EventResult.accept;
                    }
                    if (root.current.id != "" && event.text == Key.LeftArrow) {
                        root.back(root.current.id);
                        return EventResult.accept;
                    }
                    // Ctrl-F, for the hands that expect it. Some platforms send
                    // the letter and some the control character it stands for.
                    if (event.text == "f" || event.text == "F"
                        || event.text == "\u{6}") {
                        self.reach-search();
                        return EventResult.accept;
                    }
                    return EventResult.reject;
                }

                // Straight to the search box. `/` because it costs no modifier
                // and nothing else wants it; it is not a letter, so the jump
                // bar was going to refuse it anyway.
                if (event.text == "/") {
                    self.reach-search();
                    return EventResult.accept;
                }

                // The ends of the list. The bar stops at Z, and a library's
                // Songs has two thousand rows after it.
                if (root.browse-pane
                    && (event.text == Key.Home || event.text == Key.End)) {
                    if (root.browse-paged) {
                        // Thirty rows of two thousand are in hand, so the end
                        // of the list is not the end of what is loaded. The
                        // backend fetches the last window, exactly as a letter
                        // does.
                        root.browse-ends(event.text == Key.End);
                    } else if (event.text == Key.End) {
                        root.browse-to-end += 1;
                    } else {
                        root.browse-to-top += 1;
                    }
                    return EventResult.accept;
                }
                if (root.browse-pane
                    && (event.text == Key.PageUp || event.text == Key.PageDown)) {
                    root.browse-page-down = event.text == Key.PageDown;
                    root.browse-page += 1;
                    return EventResult.accept;
                }

                // Play and pause. Only with a player to say it to.
                if (event.text == " ") {
                    if (root.current.id == "") {
                        return EventResult.reject;
                    }
                    root.toggle(root.current.id);
                    return EventResult.accept;
                }

                // Back, the two keys people reach for. Passed on when there is
                // nowhere to go, so Escape still closes what it usually closes.
                if (event.text == Key.Escape
                    || event.text == Key.Backspace
                    || event.text == Key.LeftArrow) {
                    if (!root.browse-can-go-back || !root.browse-pane) {
                        return EventResult.reject;
                    }
                    root.browse-back();
                    return EventResult.accept;
                }

                // A cased letter, or one of the two keys the bar draws that are
                // not letters.
                //
                // Slint does not send an empty `text` for a named key: Tab
                // arrives as U+0009, the arrows as U+F700 and up. Taking those
                // swallowed them — Tab stopped moving focus at all, because the
                // traversal only runs once the focused element rejects the key.
                // Everything Slint sends for a named key has no case, and so do
                // digits, which is what this tests without naming each one.
                if (event.text.to-uppercase() == event.text.to-lowercase()
                    && event.text != "#" && event.text != "*") {
                    return EventResult.reject;
                }
                // And nothing to jump to is nothing to take.
                //
                // The pane as well as the bar, the way Home/End and the page
                // keys above already test it. `browse-index` belongs to the
                // last browse screen and outlives it, so a letter typed on
                // Settings or My Stations was paging a list nobody could see:
                // no feedback at all, a /Browse request on the wire, and the
                // trail sitting somewhere else when you pressed Back.
                if (!root.browse-pane || root.browse-index.length == 0) {
                    return EventResult.reject;
                }
                // Sent exactly as typed. Matching it to a letter is the
                // backend's job: it holds the offsets, it knows the bar may
                // carry both "C" and "c", and it ignores a key on neither.
                root.browse-jump(event.text);
                return EventResult.accept;
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;

            // Navigation. Everything in it above the players comes from the
            // player itself: the screens it says it has, then the inputs and
            // services off its own Sources screen.
            Rectangle {
                width: 268px;
                background: Theme.glass;
                clip: true;

                Rectangle { x: parent.width - 1px; width: 1px; background: Theme.border; }

                VerticalLayout {
                    padding-top: Theme.room;
                    spacing: Theme.gap;

                    HorizontalLayout {
                        padding-left: Theme.room;
                        padding-right: Theme.pad;
                        spacing: 10px;

                        VerticalLayout {
                            alignment: center;

                            Icon {
                                glyph: Icons.brand;
                                tint: Theme.accent;
                                width: 32px;
                                height: 32px;
                            }
                        }

                        // Geo for the wordmark alone — see ui/fonts/LICENSE.
                        // The interface is Geist; a wordmark is a picture of a
                        // name rather than text, and wants its own letterforms.
                        //
                        // Optically centered rather than centered: Geo's caps sit
                        // high in the line box, so centering the box leaves the
                        // letters riding above the mark beside them.
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            padding-top: 4px;

                            Text {
                                text: "AZZURRO";
                                font-family: "Geo";
                                font-size: 31px;
                                color: Theme.text;
                                letter-spacing: 3.2px;
                                vertical-alignment: center;
                            }
                        }

                    }

                    ListView {
                        vertical-stretch: 1;
                        // The count belongs here and the index on the row; see
                        // the note on the queue's list.
                        accessible-role: list;
                        accessible-item-count: root.sidebar.length;

                        for entry[i] in root.sidebar: NavRow {
                            entry: entry;
                            accessible-item-index: i;
                            activate => { root.sidebar-activate(entry.kind, entry.index); }
                        }
                    }

                    // Where the official controller keeps them: below
                    // everything the player describes, above nothing.
                    // Above Settings, because it is music rather than
                    // configuration: a station typed in by hand is the same
                    // kind of thing as the ones the player browses, and the
                    // only reason it is not up there with them is that the
                    // player does not know about it.
                    NavRow {
                        entry: {
                            label: "My Stations",
                            cover: Icons.station,
                            is-glyph: true,
                        };
                        activate => { root.open-stations(); }
                    }

                    NavRow {
                        entry: {
                            label: "Settings",
                            cover: Icons.settings,
                            is-glyph: true,
                        };
                        activate => { root.open-settings(); }
                    }

                    NavRow {
                        entry: {
                            label: "Help",
                            cover: Icons.help,
                            is-glyph: true,
                        };
                        activate => { root.open-help(); }
                    }

                }
            }

            // What you are browsing.
            Rectangle {
                // The column that grows. The sidebar and the queue are both a
                // fixed width, so without this the middle takes whatever it
                // happens to prefer and the rest of the window stays empty —
                // which is what a wider default window made obvious.
                horizontal-stretch: 1;
                background: transparent;
                clip: true;

                VerticalLayout {
                    padding-top: Theme.pad;

                    HorizontalLayout {
                        padding-left: Theme.pad;
                        padding-right: Theme.pad;
                        padding-bottom: Theme.pad;
                        spacing: Theme.gap;

                        IconButton {
                            glyph: Icons.back;
                            label: "Back";
                            size: 30px;
                            glyph-size: 17px;
                            enabled: root.browse-can-go-back;
                            opacity: root.browse-can-go-back ? 1.0 : 0.0;
                            clicked => { root.browse-back(); }
                        }

                        Text {
                            text: root.browse-title;
                            font-size: Theme.heading-size;
                            font-weight: 600;
                            color: Theme.text;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }

                        // Keeps the title centered against the back button
                        // when there is no picker to balance it.
                        if !root.browse-pane || root.browse-selector.length == 0: Rectangle {
                            width: 30px;
                        }

                        if root.browse-pane && root.browse-selector.length > 0: VerticalLayout {
                            alignment: center;

                            Rectangle {
                                height: 30px;
                                width: chosen.preferred-width + 54px;
                                border-radius: Theme.radius-small;
                                background: swap.pressed
                                    ? Theme.pressed
                                    : (swap.has-hover ? Theme.hover : transparent);
                                border-width: 1px;
                                border-color: Theme.border;
                                animate background { duration: Theme.quick; easing: ease-out; }

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 6px;
                                    padding-left: 11px;
                                    padding-right: 9px;

                                    VerticalLayout {
                                        alignment: center;

                                        Icon {
                                            glyph: root.browse-service-icon;
                                            tint: Theme.dim;
                                            width: 15px;
                                            height: 15px;
                                        }
                                    }

                                    chosen := Text {
                                        text: root.browse-service;
                                        font-size: Theme.small-size;
                                        color: Theme.text;
                                        vertical-alignment: center;
                                    }

                                    VerticalLayout {
                                        alignment: center;

                                        Icon {
                                            glyph: Icons.collapse;
                                            tint: Theme.faint;
                                            width: 13px;
                                            height: 13px;
                                        }
                                    }
                                }

                                swap := TouchArea {
                                    clicked => { services.show(); }
                                }

                                services := PopupWindow {
                                    x: parent.width - self.width;
                                    y: parent.height + 6px;
                                    width: 220px;
                                    height: root.browse-selector.length * 40px + 2 * Theme.gap;
                                    close-policy: PopupClosePolicy.close-on-click-outside;

                                    Rectangle {
                                        background: Theme.surface;
                                        border-radius: Theme.radius-small;
                                        border-width: 1px;
                                        border-color: Theme.border-strong;
                                        clip: true;

                                        VerticalLayout {
                                            padding: Theme.gap;

                                            for entry in root.browse-selector: Rectangle {
                                                height: 40px;
                                                border-radius: Theme.radius-small;
                                                background: entry.selected
                                                    ? Theme.selected
                                                    : (row.has-hover ? Theme.hover : transparent);

                                                HorizontalLayout {
                                                    padding-left: Theme.gap;
                                                    padding-right: Theme.gap;
                                                    spacing: Theme.gap;

                                                    VerticalLayout {
                                                        alignment: center;

                                                        Icon {
                                                            glyph: entry.cover;
                                                            tint: entry.selected
                                                                ? Theme.accent
                                                                : Theme.dim;
                                                            width: 16px;
                                                            height: 16px;
                                                        }
                                                    }

                                                    Text {
                                                        text: entry.title;
                                                        font-size: Theme.body-size;
                                                        color: entry.selected
                                                            ? Theme.text
                                                            : Theme.dim;
                                                        vertical-alignment: center;
                                                        horizontal-stretch: 1;
                                                    }
                                                }

                                                row := TouchArea {
                                                    clicked => {
                                                        // Asked for before the
                                                        // popup goes: closing it
                                                        // takes the row with it,
                                                        // and the index being
                                                        // read from it.
                                                        root.browse-activate(entry.index);
                                                        services.close();
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Settings and Help take the pane whole. Leaving the last
                    // screen's search box above them offers to search a screen
                    // that is no longer on show.
                    if root.searchable: HorizontalLayout {
                        padding-left: Theme.pad;
                        padding-right: Theme.pad;
                        padding-bottom: Theme.gap;

                        SearchField {
                            prompt: root.browse-search-prompt;
                            text <=> root.browse-query;
                            // Results follow the keys; Enter only says the
                            // search was one worth keeping.
                            edited(text) => { root.browse-search(text); }
                            accepted(text) => { root.browse-search-done(text); }
                            // Hoisted to the window because the jump bar has to
                            // read it and cannot see inside this `if`.
                            changed typing => { root.browse-typing = self.typing; }
                            // And the way back in. A counter rather than a flag
                            // because asking twice has to work twice.
                            property <int> asked: root.focus-search;
                            changed asked => { self.take-focus(); }
                            // Escape hands the caret back to the key scope, so
                            // the next Escape or Backspace navigates instead of
                            // being swallowed by the box. An inner element can
                            // name an outer one, which is the only reason this
                            // can reach `keys` from inside the `if`.
                            escaped => {
                                root.browse-typing = false;
                                keys.focus();
                            }
                            // Arriving on a screen with a search box means
                            // wanting to search: the caret goes in it and any
                            // query it kept is selected, so typing starts
                            // straight away and replaces what was there.
                            //
                            // Not only for the keyboard route. Pressing Search
                            // in the sidebar is the same intent, and the player
                            // puts a box on that one screen and nowhere else,
                            // so "a box exists" is the same statement as "this
                            // is the search screen".
                            init => {
                                root.want-search = false;
                                self.take-focus();
                            }
                        }
                    }

                    // What has been searched for before, offered where the
                    // results will appear.
                    if root.searchable
                        && root.browse-blocks.length == 0
                        && root.browse-recent.length > 0: VerticalLayout {
                        padding-left: Theme.pad;
                        padding-right: Theme.pad;

                        HorizontalLayout {
                            padding-top: Theme.tight;
                            padding-bottom: Theme.tight;

                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;

                                SectionLabel { text: "RECENT SEARCHES"; }
                            }

                            // The same shape the player's own section buttons
                            // have, because it does the same kind of thing.
                            VerticalLayout {
                                alignment: center;

                                Rectangle {
                                    height: 22px;
                                    width: wipe.preferred-width + 20px;
                                    border-radius: Theme.radius-small;
                                    background: forget.pressed
                                        ? Theme.pressed
                                        : (forget.has-hover ? Theme.hover : transparent);
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    animate background { duration: Theme.quick; easing: ease-out; }

                                    wipe := Text {
                                        text: "CLEAR";
                                        font-size: Theme.micro-size;
                                        font-weight: 600;
                                        letter-spacing: 0.6px;
                                        color: forget.has-hover ? Theme.text : Theme.dim;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                    }

                                    forget := TouchArea {
                                        clicked => { root.clear-recent(); }
                                    }
                                }
                            }
                        }

                        for entry in root.browse-recent: Rectangle {
                            height: 38px;
                            border-radius: Theme.radius-small;
                            background: again.has-hover ? Theme.hover : transparent;

                            HorizontalLayout {
                                padding-left: Theme.gap;
                                spacing: Theme.pad;

                                VerticalLayout {
                                    alignment: center;

                                    Icon {
                                        glyph: Icons.recent;
                                        tint: Theme.faint;
                                        width: 15px;
                                        height: 15px;
                                    }
                                }

                                Text {
                                    text: entry;
                                    font-size: Theme.body-size;
                                    color: Theme.dim;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                            }

                            again := TouchArea {
                                clicked => {
                                    root.browse-query = entry;
                                    root.browse-search(entry);
                                }
                            }
                        }
                    }

                    if root.browse-pane && root.browse-header-title != "": HorizontalLayout {
                        padding-left: Theme.pad;
                        padding-right: Theme.pad;
                        padding-bottom: Theme.pad;
                        spacing: Theme.room;
                        vertical-stretch: 0;

                        Artwork {
                            source: root.browse-header-cover;
                            fallback: Icons.album;
                            corner: 10px;
                            width: 160px;
                            height: 160px;
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: Theme.tight;
                            horizontal-stretch: 1;
                            min-width: 0px;

                            Text {
                                text: root.browse-header-title;
                                font-size: Theme.display-size;
                                font-weight: 600;
                                color: Theme.text;
                                overflow: elide;
                            }

                            if root.browse-header-subtitle != "": Text {
                                text: root.browse-header-subtitle;
                                font-size: Theme.title-size;
                                color: Theme.dim;
                                overflow: elide;
                            }

                            if root.browse-header-detail != "": Text {
                                text: root.browse-header-detail;
                                font-size: Theme.small-size;
                                color: Theme.faint;
                                overflow: elide;
                            }

                            if root.browse-header-buttons.length > 0: HorizontalLayout {
                                spacing: Theme.gap;
                                padding-top: Theme.gap;
                                alignment: start;

                                for button[b] in root.browse-header-buttons: PillButton {
                                    label: button.label;
                                    glyph: button.glyph;
                                    primary: button.primary;
                                    clicked => { root.browse-header(button.index); }
                                }
                            }
                        }
                    }

                    // Not while the empty state is showing: an empty list
                    // still stretches, and it took the room the message should
                    // have been centered in — which left it sitting near the
                    // bottom of the pane.
                    // The list, and the alphabet beside it.
                    //
                    // A row rather than the ListView alone, because a long
                    // list needs somewhere to put the letters. The bar is
                    // only there when the player sent an index, which it
                    // does for the lists long enough to need one and for no
                    // others.
                    if root.devices.length > 0 && root.browse-pane
                        && root.browse-empty == "": HorizontalLayout {
                        vertical-stretch: 1;

                        // Type a letter, land on it.
                        //
                        // A FocusScope so the keys are only ours when nothing
                        // else wants them: a LineEdit with focus keeps its own
                        // typing, which is what stops this stealing letters
                        // from the search box.
                        //
                        // Single characters only, and only ones the player put
                        // in the index — so Ctrl-anything, the arrow keys and a
                        // letter no artist starts with all fall through to
                        // whatever else would have had them.
                        browse-list := ListView {
                            horizontal-stretch: 1;

                            vertical-stretch: 1;
                            // A ListView is a Flickable, and a Flickable sizes its
                            // viewport to what the content would like to be — so
                            // rows stopped at their own preferred width and left
                            // the rest of the pane empty. Invisible while the
                            // window opened at 1100 and the pane was narrower than
                            // that preference; plain at 1440.
                            viewport-width: self.width;

                            // A library's Artists page answers thirty of four
                            // hundred and hands over the request for the next
                            // thirty. Asked for before the end arrives, so the
                            // list grows under the scroll rather than stopping at
                            // it. The backend ignores a second ask while one is
                            // already out.
                            // Whether the rows are still arriving at their
                            // final size, so the list should stay where it was
                            // put rather than follow them.
                            //
                            // A screen is published twice: once as it arrives
                            // and again when its artwork lands, and a tile is
                            // sized from its caption, so the second publish is
                            // taller. A ListView keeps the rows you are looking
                            // at where they are when that happens, which pushes
                            // everything above them off the top — measured at
                            // 38px on a genre screen, which is exactly its
                            // first heading. Nothing was scrolled: the heading
                            // was inserted above the view after the fact.
                            property <bool> settling: false;

                            changed viewport-y => {
                                if (self.viewport-height + self.viewport-y - self.height < 900px) {
                                    root.browse-more();
                                }
                            }

                            // And on the list's own height, the same as the queue.
                            // A page of thirty usually overflows the pane and there
                            // is something to scroll, which is why this was never
                            // missed — but a page that does not fill it leaves
                            // nothing to scroll, and a scroll-only trigger can then
                            // never fire again. The rest of the list is stranded
                            // with a cursor pointing straight at it.
                            //
                            // Safe to chain only because `next_after_page` now
                            // stops on a page that brought nothing and on a cursor
                            // that repeats itself. Scrolling hid both, a person
                            // being the thing that gets bored and stops.
                            changed viewport-height => {
                                if (self.settling) {
                                    self.viewport-y = -root.browse-jump-y * 1px;
                                }
                                if (self.viewport-height + self.viewport-y - self.height < 900px) {
                                    root.browse-more();
                                }
                            }

                            for block in root.browse-blocks: BrowseBlockView {
                                block: block;
                                activate(i) => { root.browse-activate(i); }
                                open-menu(i, y, right) => {
                                    root.queue-menu-y = y;
                                    root.queue-menu-right = right;
                                    root.browse-menu(i);
                                }
                                section-action(i) => { root.browse-section(i); }
                            }
                        }

                        // A jump replaces the rows; it does not move the
                        // Flickable. Without this the letter asked for appears
                        // under whatever scroll position the old list had,
                        // which on a list scrolled halfway is the middle of it.
                        //
                        // Beside the list rather than in it: a ListView takes a
                        // single `for` and nothing else.
                        Rectangle {
                            // Width only, for the reason given on the
                            // FocusScope above.
                            width: 0px;
                            horizontal-stretch: 0;
                            // Home and End. Here rather than in the key
                            // handler because `browse-list` cannot be named
                            // from outside the `if` that builds it.
                            //
                            // Both give up the settling pin: the reader has
                            // said where they want to be, and rows growing a
                            // moment later must not overrule them.
                            property <int> to-top: root.browse-to-top;
                            changed to-top => {
                                browse-list.settling = false;
                                browse-list.viewport-y = 0;
                            }

                            property <int> to-end: root.browse-to-end;
                            changed to-end => {
                                browse-list.settling = false;
                                browse-list.viewport-y = min(0px,
                                    browse-list.height - browse-list.viewport-height);
                            }

                            // A screenful at a time. Clamped at both ends so
                            // it stops rather than running past them, and it
                            // gives up the pin for the same reason Home does.
                            property <int> paged: root.browse-page;
                            changed paged => {
                                browse-list.settling = false;
                                browse-list.viewport-y = clamp(
                                    browse-list.viewport-y
                                        + (root.browse-page-down
                                            ? -browse-list.height
                                            : browse-list.height),
                                    min(0px, browse-list.height
                                        - browse-list.viewport-height),
                                    0px);
                            }

                            property <int> at: root.browse-jumped;
                            changed at => {
                                browse-list.viewport-y = -root.browse-jump-y * 1px;
                                // Held there until the rows stop changing size
                                // under it. See `settling` on the list.
                                browse-list.settling = true;
                            }

                            // The settling window is given up after half a
                            // second, so the list is the reader's from then on
                            // and rows growing later — which is how paging
                            // works — never yank it back.
                            //
                            // A timer rather than the scroll itself: a ListView
                            // exposes no `flicked`, and telling a reader's
                            // scroll from a re-layout by watching `viewport-y`
                            // means knowing which of two `changed` handlers ran
                            // first. The second publish lands well inside this.
                            //
                            // Out here because a ListView may hold a single
                            // `for` and nothing else.
                            Timer {
                                interval: 500ms;
                                running: browse-list.settling;
                                triggered => {
                                    browse-list.settling = false;
                                }
                            }
                        }

                        if root.browse-index.length > 0: VerticalLayout {
                            alignment: center;
                            padding-right: Theme.tight;
                            horizontal-stretch: 0;

                            for key in root.browse-index: Rectangle {
                                width: 22px;
                                height: 18px;
                                border-radius: 4px;
                                background: letter.has-hover
                                    ? Theme.hover
                                    : transparent;

                                Text {
                                    text: key;
                                    font-size: Theme.micro-size;
                                    font-weight: 600;
                                    // Brighter on hover: at this size the
                                    // background alone is not enough to say
                                    // which letter is under the pointer.
                                    color: letter.has-hover
                                        ? Theme.text
                                        : Theme.faint;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                letter := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.browse-jump(key); }
                                }
                            }
                        }
                    }

                    // Before anything else: no speakers at all. Ahead of the
                    // player's own info panels because until one has answered
                    // there is no player to have volunteered one, and a first
                    // run otherwise showed an empty pane for twelve seconds and
                    // then an empty pane for good.
                    if root.devices.length == 0: EmptyState {
                        vertical-stretch: 1;
                        working: root.looking-for-players;
                        glyph: root.looking-for-players ? Icons.rescan : Icons.player;
                        headline: root.looking-for-players
                            ? "Looking for players"
                            : "No players found";
                        detail: root.looking-for-players
                            ? "Listening for BluOS speakers on this network. This takes a few seconds."
                            : "Nothing answered on this network. Check the speaker is powered on and on the same Wi-Fi, then search again — or add one by address from the players list.";
                    }

                    if root.devices.length > 0 && root.browse-pane
                        && root.browse-empty != "": EmptyState {
                        vertical-stretch: 1;
                        glyph: root.browse-empty-icon;
                        headline: root.browse-empty;
                        detail: root.browse-empty-detail;
                    }

                    // Pinned above the list rather than scrolling inside it.
                    // Two reasons: a wheel over the time must not also scroll
                    // the page, and a virtualized row can carry the focused
                    // field away with it when it goes off screen.
                    if root.alarm-editing: Panel {
                        VerticalLayout {
                            padding: Theme.room;
                            spacing: Theme.pad;

                            HorizontalLayout {
                                spacing: Theme.room;
                                alignment: start;

                                VerticalLayout {
                                    spacing: Theme.tight;
                                    alignment: start;

                                    SectionLabel { text: "STARTS"; }

                                    TimeField {
                                        hour: root.alarm-hour;
                                        minute: root.alarm-minute;
                                        changed(h, m) => { root.alarm-start-changed(h, m); }
                                    }
                                }

                                // Only on a schedule, and only where the
                                // player said it can do them at all — the
                                // Stops row below is what turns one into the
                                // other.
                                if root.alarm-schedule: VerticalLayout {
                                    spacing: Theme.tight;
                                    alignment: start;

                                    SectionLabel { text: "STOPS"; }

                                    TimeField {
                                        hour: root.alarm-end-hour;
                                        minute: root.alarm-end-minute;
                                        changed(h, m) => { root.alarm-end-changed(h, m); }
                                    }
                                }
                            }

                            VerticalLayout {
                                spacing: Theme.gap;

                                HorizontalLayout {
                                    spacing: Theme.gap;
                                    alignment: start;

                                    SectionLabel { text: "REPEAT"; }

                                    // Read back in words. Seven dark chips do
                                    // not say "once", and that is what no day
                                    // set actually means to the player.
                                    Text {
                                        text: root.alarm-repeat;
                                        font-size: Theme.micro-size;
                                        color: Theme.dim;
                                        vertical-alignment: center;
                                    }
                                }

                                DayPicker {
                                    letters: root.alarm-letters;
                                    days: root.alarm-days;
                                    toggled(i) => { root.alarm-day-toggled(i); }
                                }
                            }
                        }
                    }

                    // The stations typed in by hand.
                    //
                    // Its own pane rather than settings rows, which is where
                    // it started: a settings row fires one callback whether
                    // its body or its control was pressed, so play and remove
                    // could not be told apart, and a row's text field reports
                    // only on Enter — a name typed before tabbing to the
                    // address beside it was silently thrown away. Reordering
                    // it could not express at all.
                    if root.in-stations: VerticalLayout {
                        vertical-stretch: 1;
                        padding: Theme.pad;
                        spacing: Theme.gap;

                        // Both fields live here rather than in the backend, so
                        // the address field can hand over the name beside it at
                        // the moment it commits. Nothing is reported until
                        // then, which is why neither has to be read as it is
                        // typed.
                        HorizontalLayout {
                            spacing: Theme.gap;

                            new-name := LineEdit {
                                placeholder-text: "Name (optional)";
                                font-size: Theme.small-size;
                                width: 200px;
                                accepted => { new-url.focus(); }
                            }

                            new-url := LineEdit {
                                placeholder-text: "Enter a http or https address.";
                                font-size: Theme.small-size;
                                horizontal-stretch: 1;
                                // A LineEdit asks to be as wide as what is in
                                // it, so in a stretchy row the box grew as the
                                // address was typed and the row rearranged
                                // itself around it. The stretch decides the
                                // width here, not the contents.
                                min-width: 0px;
                                accepted(url) => {
                                    root.station-add(new-name.text, url);
                                    new-name.text = "";
                                    self.text = "";
                                }
                            }

                            // The same commit as pressing Enter in the field,
                            // for anyone who has just pasted with the mouse and
                            // has no reason to reach for the keyboard.
                            //
                            // Not stretchy, and nor is the one below it. A
                            // layout in Slint stretches by default, so these
                            // two wrappers were quietly splitting the row's
                            // spare width with the address field — and since
                            // that field asks for nothing (see its min-width),
                            // it lost, collapsing to the width of its own
                            // clear button. The empty one is the greedier of
                            // the two: with no stations there is no Edit
                            // button in it and nothing but stretch left.
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 0;

                                IconButton {
                                    glyph: Icons.add;
                                    label: "Add this station";
                                    size: 34px;
                                    glyph-size: 17px;
                                    enabled: new-url.text != "";
                                    clicked => {
                                        root.station-add(new-name.text, new-url.text);
                                        new-name.text = "";
                                        new-url.text = "";
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 0;
                                // Only once there is something to edit.
                                if root.stations.length > 0: PillButton {
                                    label: root.stations-editing ? "Done" : "Edit";
                                    clicked => { root.stations-edit(); }
                                }
                            }
                        }

                        if root.stations.length == 0: EmptyState {
                            vertical-stretch: 1;
                            glyph: Icons.station;
                            headline: "No stations yet";
                            detail: "Paste a stream address above. It plays on whichever "
                                + "player is selected, and is kept on this computer — "
                                + "the player has nowhere to put it.";
                        }

                        if root.stations.length > 0: Text {
                            text: root.stations-editing
                                ? "Drag to reorder, retype a name to rename, or press the bin to remove."
                                : "Press a station to play it on the selected player.";
                            font-size: Theme.small-size;
                            color: Theme.dim;
                            wrap: word-wrap;
                        }

                        if root.stations.length > 0: station-list := ListView {
                            vertical-stretch: 1;
                            accessible-role: list;
                            accessible-item-count: root.stations.length;

                            property <length> row-height: 62px;
                            property <int> from-row: -1;
                            property <int> to-row: -1;
                            property <bool> dragging: self.from-row >= 0;

                            for station[i] in root.stations: VerticalLayout {
                                spot := Rectangle {
                                    height: station-list.row-height;

                                    // The same shuffle the queue and the
                                    // customize list do: the rows between the
                                    // grabbed one and the drop step aside so
                                    // the gap opens where it will land.
                                    property <length> lift: station-list.from-row == i
                                        ? (station-list.to-row - station-list.from-row) * station-list.row-height
                                        : (station-list.dragging
                                            && i > station-list.from-row
                                            && i <= station-list.to-row
                                            ? -station-list.row-height
                                            : (station-list.dragging
                                                && i < station-list.from-row
                                                && i >= station-list.to-row
                                                ? station-list.row-height
                                                : 0px));

                                    StationRow {
                                        station: station;
                                        accessible-item-index: i;
                                        editing: root.stations-editing;
                                        lifted: station-list.from-row == i;
                                        y: spot.lift;
                                        lift: spot.lift;
                                        play => { root.station-play(i); }
                                        renamed(name) => { root.station-rename(i, name); }
                                        remove => { root.station-remove(i); }
                                        drag-moved(offset) => {
                                            if (station-list.from-row < 0) {
                                                station-list.from-row = i;
                                            }
                                            station-list.to-row = Math.clamp(
                                                station-list.from-row
                                                    + Math.round(offset / station-list.row-height),
                                                0, root.stations.length - 1);
                                        }
                                        drag-done => {
                                            if (station-list.to-row != station-list.from-row) {
                                                root.station-move(station-list.from-row, station-list.to-row);
                                            }
                                            station-list.from-row = -1;
                                            station-list.to-row = -1;
                                        }
                                        drag-cancelled => {
                                            station-list.from-row = -1;
                                            station-list.to-row = -1;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if root.in-settings: ListView {
                        vertical-stretch: 1;
                        // As above: without this the settings, Help and
                        // technical-info rows are as wide as they would like
                        // rather than as wide as the pane.
                        viewport-width: self.width;
                        accessible-role: list;
                        accessible-item-count: root.settings.length;

                        for item[i] in root.settings: SettingRow {
                            item: item;
                            accessible-item-index: i;
                            toggled => { root.setting-toggle(item.index); }
                            chose(i) => { root.setting-choose(item.index, i); }
                            numbered(v) => { root.setting-number(item.index, v); }
                            typed(t) => { root.setting-text(item.index, t); }
                            opened => { root.setting-open(item.index); }
                        }
                    }

                    // Indexing outlives the page it was started from — you can
                    // walk away to Home and it is still running — so it is
                    // reported here rather than on the settings row.
                    //
                    // Last in this column on purpose. It arrives while you are
                    // reading something, and anything above the lists pushes
                    // them down the moment it appears — which is what it did
                    // on Settings, where it sat between the two lists and so
                    // landed above the one that was showing.
                    //
                    // Grown rather than inserted, for the same reason: a strip
                    // that simply exists on the next frame reads as the page
                    // having jumped.
                    //
                    // Clipped, so the contents are cut off by the shrinking
                    // edge instead of spilling past it, and the words are held
                    // past the moment indexing finishes — bound straight to
                    // `indexing`, the bar would empty itself and then collapse.
                    Rectangle {
                        height: root.indexing != "" ? 52px : 0px;
                        clip: true;
                        opacity: root.indexing != "" ? 1.0 : 0.0;

                        animate height, opacity {
                            duration: Theme.settle;
                            easing: ease-out;
                        }

                        Rectangle {
                            x: Theme.pad;
                            y: 0;
                            width: parent.width - 2 * Theme.pad;
                            height: parent.height - Theme.gap;
                            border-radius: Theme.radius-small;
                            background: Theme.accent-soft;
                            border-width: 1px;
                            border-color: Theme.border;

                            VerticalLayout {
                                padding: Theme.gap;
                                spacing: 7px;

                                HorizontalLayout {
                                    spacing: 7px;

                                    VerticalLayout {
                                        alignment: center;

                                        Icon {
                                            glyph: Icons.library;
                                            tint: Theme.accent;
                                            width: 14px;
                                            height: 14px;
                                        }
                                    }

                                    Text {
                                        text: root.indexed;
                                        font-size: Theme.small-size;
                                        color: Theme.text;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                }

                                Indeterminate { sweeping: root.indexing != ""; }
                            }
                        }
                    }

                    // The same strip for a firmware install, and the same
                    // reasons: it outlives the page it was started from — the
                    // Install row is three taps into Help and nobody watches
                    // it there for four minutes — and it must not shove the
                    // page down the instant it appears.
                    //
                    // Below indexing rather than above it. A reindex is
                    // routine and an upgrade is not, so the rarer one sits
                    // nearer the eye; and on the once-in-a-lifetime occasion
                    // both are up, the order stays fixed instead of depending
                    // on which started first.
                    Rectangle {
                        height: root.upgrading-player != "" ? 52px : 0px;
                        clip: true;
                        opacity: root.upgrading-player != "" ? 1.0 : 0.0;

                        animate height, opacity {
                            duration: Theme.settle;
                            easing: ease-out;
                        }

                        Rectangle {
                            x: Theme.pad;
                            y: 0;
                            width: parent.width - 2 * Theme.pad;
                            height: parent.height - Theme.gap;
                            border-radius: Theme.radius-small;
                            background: Theme.accent-soft;
                            border-width: 1px;
                            border-color: Theme.border;

                            VerticalLayout {
                                padding: Theme.gap;
                                spacing: 7px;

                                HorizontalLayout {
                                    spacing: 7px;

                                    VerticalLayout {
                                        alignment: center;

                                        Icon {
                                            glyph: Icons.upgrade;
                                            tint: Theme.accent;
                                            width: 14px;
                                            height: 14px;
                                        }
                                    }

                                    Text {
                                        text: root.upgrade-said;
                                        font-size: Theme.small-size;
                                        color: Theme.text;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }

                                    // Only when the player is actually
                                    // counting. A Powernode reports no step,
                                    // no total and no percentage at any point
                                    // in the install, so on that hardware this
                                    // never appears and the sweep below is the
                                    // whole signal.
                                    if root.upgrading-percent > 0: Text {
                                        text: Math.round(root.upgrading-percent) + "%";
                                        font-size: Theme.small-size;
                                        color: Theme.dim;
                                        vertical-alignment: center;
                                    }
                                }

                                // Determinate when there is a number to draw,
                                // and a sweep when there is not. A bar pinned
                                // at zero for four minutes says "stuck",
                                // which is the one thing it must not say about
                                // a player rewriting its own firmware.
                                if root.upgrading-percent > 0: Rectangle {
                                    height: 4px;
                                    border-radius: 2px;
                                    background: Theme.sunken;
                                    clip: true;

                                    Rectangle {
                                        x: 0;
                                        width: parent.width * (root.upgrading-percent / 100);
                                        height: parent.height;
                                        border-radius: 2px;
                                        background: Theme.accent;
                                        animate width {
                                            duration: Theme.settle;
                                            easing: ease-out;
                                        }
                                    }
                                }

                                if root.upgrading-percent <= 0: Indeterminate {
                                    sweeping: root.upgrading-player != "";
                                }
                            }
                        }
                    }
                }

                // The record, large.
                //
                // Drawn over the pane rather than instead of it, so the sidebar
                // and the queue stay where they are — the official controller
                // covers the middle and keeps the queue, and there is no reason
                // to lose the navigation as well.
                // Faded in rather than switched on. Two elements and not one:
                // the outer carries the animation and is always present, while
                // the contents are still behind an `if`, because the record is
                // sized from the window's width and a child that reads the
                // window's width while contributing to it is a binding loop —
                // one Slint now warns will eventually panic. Gating on the
                // wrapper's own visibility rather than on the flag keeps the
                // contents alive for the length of the fade out.
                fade := Rectangle {
                    opacity: root.now-playing ? 1.0 : 0.0;
                    visible: self.opacity > 0.0;

                    animate opacity {
                        duration: Theme.settle;
                        easing: ease-out;
                    }

                    // Takes the pointer while it is up. Neither fade declared
                    // an input item, so presses and the wheel went straight
                    // through to the browse rows underneath — a menu opening
                    // for a row nobody could see, and scrolling asking the
                    // player for more of a list that was not on screen. The
                    // scroll handler is separate from the touch area: a
                    // `TouchArea` alone does not stop a wheel.
                    TouchArea {
                        enabled: root.now-playing;
                        scroll-event(e) => { return accept; }
                    }

                    if fade.visible: Rectangle {
                    background: Theme.bg;
                    clip: true;

                    // The sleeve itself, frosted: blown up far past its own
                    // resolution so nothing in it is legible, which is the
                    // point — it is the color of the record, not the record.
                    Image {
                        source: root.cover-blur;
                        image-fit: ImageFit.cover;
                        width: 100%;
                        height: 100%;
                        opacity: 0.55;
                    }

                    // Held down to where text over it stays readable. The
                    // gradient does the work a blur alone cannot: an evenly
                    // frosted sheet is still bright enough to fight the
                    // controls drawn on it.
                    Rectangle {
                        background: @linear-gradient(180deg,
                            Theme.backdrop-bottom.with-alpha(0.62) 0%,
                            Theme.backdrop-bottom.with-alpha(0.88) 100%);
                    }

                    VerticalLayout {
                        padding: Theme.pad;
                        spacing: Theme.pad;

                        HorizontalLayout {
                            IconButton {
                                glyph: Icons.close;
                                label: "Close Now Playing";
                                size: 30px;
                                glyph-size: 16px;
                                clicked => { root.toggle-now-playing(); }
                            }

                            Text {
                                text: "Now Playing";
                                font-size: Theme.heading-size;
                                font-weight: 600;
                                color: Theme.text;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            Rectangle { width: 30px; }
                        }

                        HorizontalLayout {
                            alignment: center;
                            vertical-stretch: 1;

                            VerticalLayout {
                                alignment: center;

                                // Both the sleeve and the light it throws are
                                // sized from this, so the arithmetic is done
                                // once rather than twice with a chance to
                                // disagree.
                                //
                                // From the window's own numbers rather than
                                // from the room left over: asking the layout
                                // how much space there is, while being the
                                // thing that decides it, is a loop. The
                                // sidebar is 268 and the queue column is 330
                                // or nothing, both literals a few hundred
                                // lines up, so what is left for this pane is
                                // arithmetic. The `- 700px` that used to stand
                                // here was that arithmetic done once by hand
                                // and then left to rot: it took no notice of
                                // the queue being hidden, so the sleeve stayed
                                // 400px in a pane that had grown to 1172.
                                //
                                // Vertically: the pane less the title row and
                                // the block of text beneath. Whichever is
                                // smaller wins, which is what stops a short
                                // wide window pushing the sleeve off the
                                // bottom.
                                property <length> stage: Math.max(160px, Math.min(
                                    root.height - 278px,
                                    root.width - 268px
                                        - (root.queue-shown ? 330px : 0px)
                                        - 96px));

                                Rectangle {
                                    width: parent.stage;
                                    height: self.width;

                                    // The record lighting the room it is in.
                                    // The window-wide wash further up is
                                    // centered on the window, so the brightest
                                    // part of a sleeve's color lands over a
                                    // column of text and is spent by the time
                                    // it reaches the sleeve that produced it.
                                    // A color taken from a picture should
                                    // come from where the picture is.
                                    Rectangle {
                                        width: parent.width * 1.9;
                                        height: self.width;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        background: @radial-gradient(circle,
                                            root.cover-tint.with-alpha(0.30) 0%,
                                            root.cover-tint.with-alpha(0.09) 40%,
                                            transparent 68%);
                                        opacity: root.has-tint ? 1.0 : 0.0;
                                        animate opacity { duration: Theme.ambient; easing: ease-out; }
                                    }

                                    Artwork {
                                        source: root.cover;
                                        corner: Theme.radius-art-large;
                                        width: 100%;
                                        height: 100%;

                                        // A record on a table has a shadow
                                        // under it. Without one the sleeve is a
                                        // colored square printed on the
                                        // backdrop rather than an object in
                                        // front of it — which is most of why
                                        // this screen read flat while the
                                        // frosting behind it was working
                                        // perfectly.
                                        drop-shadow-blur: 34px;
                                        drop-shadow-offset-y: 16px;
                                        drop-shadow-color: #000000a6;
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: Theme.tight;
                            padding-bottom: Theme.room;

                            Text {
                                text: root.current.title == ""
                                    ? "Nothing playing"
                                    : root.current.title;
                                font-size: Theme.display-size;
                                font-weight: 600;
                                color: Theme.text;
                                horizontal-alignment: center;
                                overflow: elide;
                            }

                            Text {
                                text: root.current.album == ""
                                    ? root.current.artist
                                    : root.current.artist + " • " + root.current.album;
                                font-size: Theme.title-size;
                                color: Theme.dim;
                                horizontal-alignment: center;
                                overflow: elide;
                            }

                            if root.quality != "": HorizontalLayout {
                                alignment: center;
                                padding-top: Theme.tight;

                                Rectangle {
                                    height: 18px;
                                    width: grade.preferred-width + 14px;
                                    border-radius: 4px;
                                    background: Theme.raised;
                                    border-width: 1px;
                                    border-color: Theme.border;

                                    grade := Text {
                                        text: root.quality;
                                        font-size: Theme.micro-size;
                                        font-weight: 700;
                                        letter-spacing: 0.5px;
                                        color: Theme.faint;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.now-playing-info(); }
                                    }
                                }
                            }

                            // Under the badge rather than beside it: the badge
                            // is a token to be read across a room, and this is
                            // a sentence to be read up close. Only where the
                            // player has said something the badge does not
                            // already carry on its own.
                            if root.stream-format != "" && root.stream-format != root.quality:
                                HorizontalLayout {
                                    alignment: center;
                                    padding-top: Theme.tight;

                                    Text {
                                        text: root.stream-format;
                                        font-size: Theme.small-size;
                                        color: Theme.faint;
                                        horizontal-alignment: center;
                                        overflow: elide;
                                    }
                                }

                            // What the service offers for this track: a rating
                            // it will learn from, a way to buy it. Only ever
                            // what the player listed with a URL, so a source
                            // that offers nothing shows nothing rather than a
                            // row of dead buttons.
                            if root.track-actions.length > 0: HorizontalLayout {
                                alignment: center;
                                spacing: Theme.tight;
                                padding-top: Theme.gap;

                                for action in root.track-actions: PillButton {
                                    label: action.label;
                                    // Filled while it is set, which is what
                                    // `state` on a toggle means — the player
                                    // says whether this track is already loved,
                                    // and the button has to show it rather than
                                    // look like a fresh one every time.
                                    primary: action.on;
                                    clicked => { root.track-action(action.name); }
                                }
                            }
                        }
                    }
                    }
                }

                // Inside the pane, like Now Playing beside it, and not a
                // column of the row those two sit in. As a sibling of the
                // browse pane it was fine while an `if` kept it out of the
                // tree, but once it was always present to carry a fade it
                // claimed a share of the row for good — the pane and an
                // invisible overlay splitting the width between them, which
                // is why the middle of the window stopped halfway.
                customise-fade := Rectangle {
                    opacity: root.customising ? 1.0 : 0.0;
                    visible: self.opacity > 0.0;

                    animate opacity {
                        duration: Theme.settle;
                        easing: ease-out;
                    }

                    // Takes the pointer while it is up. Neither fade declared
                    // an input item, so presses and the wheel went straight
                    // through to the browse rows underneath — a menu opening
                    // for a row nobody could see, and scrolling asking the
                    // player for more of a list that was not on screen. The
                    // scroll handler is separate from the touch area: a
                    // `TouchArea` alone does not stop a wheel.
                    TouchArea {
                        enabled: root.customising;
                        scroll-event(e) => { return accept; }
                    }

                    if customise-fade.visible: Rectangle {
                    background: Theme.bg;
                    clip: true;

                    VerticalLayout {
                        padding: Theme.pad;
                        spacing: Theme.pad;

                        HorizontalLayout {
                            spacing: Theme.gap;

                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    glyph: Icons.close;
                                    label: "Close";
                                    size: 30px;
                                    glyph-size: 16px;
                                    clicked => { root.browse-back(); }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;

                                Text {
                                    text: root.customise-title;
                                    font-size: Theme.heading-size;
                                    font-weight: 600;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                PillButton {
                                    label: "SAVE";
                                    primary: true;
                                    clicked => { root.customise-save(); }
                                }
                            }
                        }

                        Text {
                            text: "Drag the sections into the order you want them on this screen. "
                                + "Sections the player pins in place are not listed.";
                            font-size: Theme.small-size;
                            color: Theme.dim;
                            wrap: word-wrap;
                        }

                        order-list := ListView {
                            accessible-role: list;
                            accessible-item-count: root.customise-rows.length;
                            vertical-stretch: 1;

                            property <length> row-height: 58px;
                            // Where a drag started and where it would land. Both
                            // -1 when nothing is being dragged.
                            property <int> from-row: -1;
                            property <int> to-row: -1;
                            property <bool> dragging: self.from-row >= 0;

                            for section-name[i] in root.customise-rows: VerticalLayout {
                                place := Rectangle {
                                    height: order-list.row-height;

                                    // The same shuffle the queue does: everything
                                    // between the grabbed row and the drop steps
                                    // aside so the gap opens where it will land.
                                    property <length> lift: order-list.from-row == i
                                        ? (order-list.to-row - order-list.from-row) * order-list.row-height
                                        : (order-list.dragging
                                            && i > order-list.from-row
                                            && i <= order-list.to-row
                                            ? -order-list.row-height
                                            : (order-list.dragging
                                                && i < order-list.from-row
                                                && i >= order-list.to-row
                                                ? order-list.row-height
                                                : 0px));

                                    CustomiseRow {
                                        label: section-name;
                                        accessible-item-index: i;
                                        lifted: order-list.from-row == i;
                                        y: place.lift;
                                        lift: place.lift;
                                        drag-moved(offset) => {
                                            if (order-list.from-row < 0) {
                                                order-list.from-row = i;
                                            }
                                            order-list.to-row = Math.clamp(
                                                order-list.from-row
                                                    + Math.round(offset / order-list.row-height),
                                                0, root.customise-rows.length - 1);
                                        }
                                        drag-done => {
                                            if (order-list.to-row != order-list.from-row) {
                                                root.customise-move(order-list.from-row, order-list.to-row);
                                            }
                                            order-list.from-row = -1;
                                            order-list.to-row = -1;
                                        }
                                        drag-cancelled => {
                                            order-list.from-row = -1;
                                            order-list.to-row = -1;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    }
                }

            }

            // Rearranging the sections of a screen.
            //
            // Over the pane rather than instead of it, the same as Now Playing:
            // what is being rearranged is the screen underneath, and losing the
            // sidebar to edit it would be disorienting.
            // Faded like Now Playing, and for the same reason — these two are
            // siblings covering the same pane, and only one of them arriving
            // gently was the odd thing.
            // The queue, with the record it is playing behind it. Hidden by
            // the button beside the volume: on a narrow window it is a third
            // of the width spent on a list you may not be using.
            // Slid rather than switched. Already clipped, which is what makes
            // this work: the contents keep their own width while the column
            // narrows past them, instead of reflowing on every frame.
            queue-col := Rectangle {
                width: root.queue-shown ? 330px : 0px;
                background: Theme.glass;
                clip: true;

                animate width {
                    duration: Theme.settle;
                    easing: ease-in-out;
                }

                // Gated on the flag and not on the animated width. Reading
                // the width back is what emptied this column: the layout is
                // what actually sizes a child, so the binding read here is not
                // the width the column ends up with, and the contents never
                // appeared at all — a 330px strip of nothing beside a browse
                // screen squeezed into what was left.
                //
                // The cost is that the closing slide has nothing in it. That
                // is a fifth of a second of empty column against a queue that
                // does not draw.
                if root.queue-shown: Rectangle {

                Rectangle { x: 0; width: 1px; background: Theme.border; }

                // The same frosted copy the expanded view uses, faded further:
                // this column has a list of track names over it.
                Image {
                    source: root.cover-blur;
                    // Qualified: inside this component `cover` is the window's
                    // own artwork property, which shadows the enum value.
                    image-fit: ImageFit.cover;
                    width: 100%;
                    height: 100%;
                    opacity: 0.38;
                }

                Rectangle {
                    // Heavy enough that the cover reads as color rather than
                    // as a picture — a legible sleeve behind a track list is
                    // just noise competing with the words on top of it.
                    background: @linear-gradient(180deg,
                        // Committing to the frosting rather than paying for it
                        // and hiding it. At 0.22 under a 0.78 scrim about one
                        // percent of the record survived to the top of this
                        // column and under a tenth of one percent to the
                        // bottom — a full-column image redrawn on every track
                        // change to deliver nothing anyone could see. The
                        // color now reaches the top, where the list is
                        // sparse, and the scrim still closes over the bottom,
                        // where the rows are dense and have to stay legible.
                        Theme.backdrop-bottom.with-alpha(0.62) 0%,
                        Theme.backdrop-bottom.with-alpha(0.80) 55%,
                        Theme.backdrop-bottom.with-alpha(0.90) 100%);
                }

                pane := VerticalLayout {
                    padding: Theme.gap;
                    padding-top: Theme.room;
                    spacing: Theme.gap;

                    // Edit mode never leaves the app. The player's Edit button
                    // is a deep link to /edit-queue, which the official
                    // controller intercepts before its own router and turns
                    // into a local flag; no request goes out. This is that flag.
                    property <bool> editing: false;
                    // Which button, if any, is waiting on an answer, and which
                    // is waiting on a name.
                    property <int> asking: -1;
                    property <int> naming: -1;
                    // The button being asked about, kept whole rather than
                    // looked up again by position. The buttons are drawn from
                    // two models — three across, the rest below — and the
                    // index from the second was being read against the first,
                    // so a confirmation raised from the lower row showed a
                    // blank question and confirmed whatever was first in the
                    // top row instead. Which is Save, on every document
                    // captured.
                    property <QueueButton> asked;

                    // Where a drag started and where it would land, both as
                    // rows of the model. A row's height is a constant because
                    // the drag turns a pointer offset into a number of rows by
                    // dividing by it — which is also why the captions come off
                    // while one is running.
                    property <length> row-height: 52px;
                    property <int> from-row: -1;
                    property <int> to-row: -1;
                    property <bool> dragging: self.from-row >= 0;

                    // What a queue button does here. Three of the four never
                    // reach the player from this call: Edit is a flag, Clear
                    // wants asking first, and Save wants a name.
                    function press(button: QueueButton, at: int) {
                        if (button.mode == 1) {
                            self.editing = true;
                        } else if (button.mode == 2) {
                            self.asked = button;
                            self.asking = at;
                        } else if (button.mode == 3) {
                            self.naming = at;
                        } else {
                            root.queue-button(button.index);
                        }
                    }

                    HorizontalLayout {
                        padding-left: Theme.gap;

                        Text {
                            text: "Play Queue";
                            font-size: Theme.title-size;
                            font-weight: 600;
                            color: Theme.text;
                        }

                        Rectangle { horizontal-stretch: 1; }

                        Text {
                            text: root.queue-line;
                            font-size: Theme.small-size;
                            color: Theme.faint;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }

                    // A queue with nothing in it is the most ordinary empty
                    // state in the app — a speaker that has just been switched
                    // on has one — and it was drawn as a column of nothing
                    // under a heading that said "Queue".
                    if root.queue.length == 0: EmptyState {
                        vertical-stretch: 1;
                        glyph: Icons.queue;
                        headline: "Nothing queued";
                        // Three ways to arrive at an empty queue, and only one
                        // of them is answered by "go pick a track". Pointing at
                        // the library when there is no player to play it on is
                        // an instruction that cannot be followed.
                        detail: root.has-selection && root.current.reachable
                            ? "Pick something from Home or the library and it will play here."
                            : (root.devices.length > 0
                                ? "Pick a player that is responding and its queue will appear here."
                                : "Once a player answers on the network, its queue will appear here.");
                    }

                    if root.queue.length > 0: queue-list := ListView {
                        // The size of the set belongs on the container, not on
                        // the rows: AccessKit reads it from the list and hands
                        // it down, which is why a count set on the row landed
                        // on the row's own caption instead. The rows carry only
                        // their index.
                        accessible-role: list;
                        accessible-item-count: root.queue.length;
                        vertical-stretch: 1;

                        // The queue arrives five hundred tracks at a time. The
                        // same lookahead as the browse list, and the same
                        // reason: asked for before the end is reached, so the
                        // list grows under the scroll rather than stopping
                        // dead at it. The backend drops a second ask while one
                        // is already out, and a page that arrives for a queue
                        // that has since been replaced.
                        changed viewport-y => {
                            if (self.viewport-height + self.viewport-y - self.height < 900px) {
                                root.queue-more();
                            }
                        }

                        // And on the list's own height, not only on scrolling
                        // it. A page that does not fill the pane leaves
                        // nothing to scroll, so a scroll-only trigger can
                        // never fire again and the rest of the queue is
                        // stranded — which is what happens to every queue
                        // whose first window is shorter than the pane.
                        // Growing the viewport re-asks, so the pages chain
                        // until there is either something to scroll or
                        // nothing left to fetch.
                        changed viewport-height => {
                            if (self.viewport-height + self.viewport-y - self.height < 900px) {
                                root.queue-more();
                            }
                        }

                        for track[i] in root.queue: VerticalLayout {
                            // `i` is the row's place in the list; `track.id` is
                            // its place in the player's queue. Anything said to
                            // the player goes through `id`, anything that is
                            // geometry goes through `i`.
                            // Which row has a band stays an `if` — otherwise
                            // every row would carry two of them and grow by
                            // their height. Whether it is *drawn* during a
                            // drag is `visible`, because an `if` takes it out
                            // of the layout, and removing 26px from above the
                            // grabbed row moves that row after `pressed-y` was
                            // captured. Every drag carried the difference as
                            // bias and landed a row further than it was
                            // dropped; left in the layout and merely not
                            // drawn, the arithmetic that divides the offset by
                            // a constant row height is true again.
                            if root.queue-cursor >= 0 && i == root.queue-cursor:
                                QueueBand {
                                    label: "CURRENTLY PLAYING";
                                    visible: !pane.dragging && !pane.editing;
                                }

                            // Guarded on the cursor too: at -1 the test below
                            // read `i == 0` and put UP NEXT over the first row
                            // of a queue with nothing playing.
                            if root.queue-cursor >= 0 && i == root.queue-cursor + 1:
                                QueueBand {
                                    label: "UP NEXT";
                                    visible: !pane.dragging && !pane.editing;
                                }

                            // The row sits in a slot of its own so that a drag
                            // can move it: a layout owns its children's `y`,
                            // and this Rectangle does not.
                            slot := Rectangle {
                                height: pane.row-height;

                                // Everything between the grabbed row and where
                                // it would land steps aside by one row, so the
                                // gap opens where the drop will go.
                                property <length> lift: pane.from-row == i
                                    ? (pane.to-row - pane.from-row) * pane.row-height
                                    : (pane.dragging
                                        && i > pane.from-row
                                        && i <= pane.to-row
                                        ? -pane.row-height
                                        : (pane.dragging
                                            && i < pane.from-row
                                            && i >= pane.to-row
                                            ? pane.row-height
                                            : 0px));

                                TrackRow {
                                track: track;
                                accessible-item-index: i;
                                editing: pane.editing;
                                spent: root.queue-cursor >= 0 && i < root.queue-cursor;
                                lifted: pane.from-row == i;
                                y: slot.lift;
                                lift: slot.lift;
                                play => { root.play-track(root.current.id, track.id); }
                                open-menu(y, right) => {
                                    root.queue-menu-y = y;
                                    root.queue-menu-right = right;
                                    root.queue-menu(track.id, y);
                                }
                                remove => { root.queue-remove(track.id); }
                                drag-moved(offset) => {
                                    if (pane.from-row < 0) {
                                        pane.from-row = i;
                                    }
                                    pane.to-row = Math.clamp(
                                        pane.from-row + Math.round(offset / pane.row-height),
                                        0, root.queue.length - 1);
                                }
                                drag-done => {
                                    if (pane.to-row != pane.from-row) {
                                        root.queue-reorder(pane.from-row, pane.to-row);
                                    }
                                    pane.from-row = -1;
                                    pane.to-row = -1;
                                }
                                drag-cancelled => {
                                    pane.from-row = -1;
                                    pane.to-row = -1;
                                }
                                }
                            }
                        }
                    }

                    // Asking before clearing. The player writes the question
                    // itself; this app only puts it on the screen.
                    if pane.asking >= 0: VerticalLayout {
                        spacing: Theme.gap;

                        Text {
                            text: pane.asked.question;
                            font-size: Theme.small-size;
                            color: Theme.dim;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            alignment: center;
                            spacing: Theme.gap;

                            PillButton {
                                label: pane.asked.label;
                                primary: true;
                                clicked => {
                                    root.queue-button(pane.asked.index);
                                    pane.asking = -1;
                                }
                            }

                            PillButton {
                                label: "Cancel";
                                clicked => { pane.asking = -1; }
                            }
                        }
                    }

                    // Naming a playlist. The player's save endpoint wants a
                    // name and nothing else.
                    if pane.naming >= 0: VerticalLayout {
                        spacing: Theme.gap;

                        name-field := SearchField {
                            prompt: "Name for this playlist";
                            accepted(text) => {
                                root.queue-save(text);
                                pane.naming = -1;
                                self.text = "";
                            }
                        }

                        HorizontalLayout {
                            spacing: Theme.gap;

                            PillButton {
                                label: "Cancel";
                                clicked => {
                                    pane.naming = -1;
                                    name-field.text = "";
                                }
                            }

                            PillButton {
                                label: "Save";
                                primary: true;
                                clicked => {
                                    root.queue-save(name-field.text);
                                    pane.naming = -1;
                                    name-field.text = "";
                                }
                            }
                        }
                    }

                    // The buttons are the player's, drawn in whatever order and
                    // number it sends them. Edit is the exception it asks for:
                    // its action is a route into the client, not a request.
                    if pane.editing: HorizontalLayout {
                        PillButton {
                            label: "Done";
                            primary: true;
                            clicked => { pane.editing = false; }
                        }
                    }

                    // Three to a line, which is what fits across a 330px
                    // column and what the official controller draws: Save,
                    // Edit and Clear together, and anything the player adds
                    // after them — Queue Builder Mode — on its own line under.
                    if !pane.editing && pane.asking < 0 && pane.naming < 0
                        && root.queue-buttons.length > 0: HorizontalLayout {
                        spacing: Theme.tight;
                        alignment: center;

                        for button[b] in root.queue-buttons: PillButton {
                            label: button.label;
                            glyph: button.glyph;
                            primary: button.highlight;
                            clicked => { pane.press(button, b); }
                        }
                    }

                    if !pane.editing && pane.asking < 0 && pane.naming < 0
                        && root.queue-buttons-below.length > 0: HorizontalLayout {
                        spacing: Theme.tight;
                        alignment: center;
                        padding-top: Theme.tight;

                        for button[b] in root.queue-buttons-below: PillButton {
                            label: button.label;
                            glyph: button.glyph;
                            primary: button.highlight;
                            // Its own place in the player's list, which
                            // `press` needs for the ask-first and name-it
                            // flows.
                            clicked => { pane.press(button, root.queue-buttons.length + b); }
                        }
                    }
                }
            }
            }
            }

        // Transport, across the whole width, the way the official controller
        // has it: what is playing on the left, the controls in the middle, and
        // which player you are driving on the right.
        Rectangle {
            height: 88px;
            background: Theme.glass-raised;
            clip: true;

            Rectangle {
                background: @linear-gradient(90deg,
                    root.cover-tint.with-alpha(0.14) 0%,
                    transparent 60%);
                opacity: root.has-tint ? 1.0 : 0.0;
                animate opacity { duration: Theme.ambient; easing: ease-out; }
            }

            Rectangle {
                y: 0;
                height: 1px;
                background: Theme.rim;
                opacity: 0.5;
            }

            VerticalLayout {
                // The progress line runs the full width along the top edge,
                // where it reads as the state of the whole window rather than
                // as one more control in a row of them.
                Scrubber {
                    label: "Position in the track";
                    enabled: root.current.reachable && root.seekable && root.duration > 0;
                    value: root.position / Math.max(root.duration, 1);
                    glide: 1s;
                    height: 12px;
                    seek(fraction) => {
                        root.seek(root.current.id, Math.round(fraction * root.duration));
                    }
                }

                HorizontalLayout {
                    padding-left: Theme.pad;
                    padding-right: Theme.pad;
                    padding-top: Theme.tight;
                    padding-bottom: Theme.gap;
                    spacing: Theme.pad;

                    // What is playing.
                    HorizontalLayout {
                        spacing: Theme.pad;
                        width: 268px;

                        VerticalLayout {
                            alignment: center;

                            Rectangle {
                                width: 52px;
                                height: 52px;

                                Artwork {
                                    source: root.cover;
                                    corner: Theme.radius-art;
                                    width: 52px;
                                    height: 52px;
                                }

                                // The record, large. Where the official
                                // controller puts the same gesture.
                                TouchArea {
                                    // The cover in the transport is a control:
                                    // pressing it is how Now Playing opens,
                                    // which nothing else in the bar says.
                                    accessible-role: button;
                                    accessible-label: root.now-playing
                                        ? "Close Now Playing"
                                        : "Open Now Playing";
                                    accessible-action-default => {
                                        root.toggle-now-playing();
                                    }
                                    clicked => { root.toggle-now-playing(); }
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            horizontal-stretch: 1;
                            min-width: 0px;

                            Text {
                                text: !root.has-selection
                                    ? "No player selected"
                                    : (root.current.title == "" ? "Nothing playing" : root.current.title);
                                font-size: Theme.title-size;
                                font-weight: 600;
                                color: Theme.text;
                                overflow: elide;
                            }

                            HorizontalLayout {
                                spacing: Theme.gap;
                                alignment: start;

                                Text {
                                    text: root.current.artist;
                                    font-size: Theme.small-size;
                                    color: Theme.dim;
                                    overflow: elide;
                                    visible: root.current.artist != "";
                                }

                                if root.quality != "": VerticalLayout {
                                    alignment: center;

                                    Rectangle {
                                        height: 16px;
                                        width: format.preferred-width + 11px;
                                        border-radius: 4px;
                                        background: Theme.raised;
                                        border-width: 1px;
                                        border-color: Theme.border;

                                        format := Text {
                                            text: root.quality;
                                            font-size: Theme.micro-size;
                                            font-weight: 700;
                                            letter-spacing: 0.4px;
                                            color: Theme.faint;
                                            vertical-alignment: center;
                                            horizontal-alignment: center;
                                        }

                                        TouchArea {
                                            accessible-role: button;
                                            accessible-label: "Technical details for this stream";
                                            accessible-action-default => {
                                                root.now-playing-info();
                                            }
                                            mouse-cursor: pointer;
                                            clicked => { root.now-playing-info(); }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // The controls.
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;

                        // The play button is taller than the four around it,
                        // so it decides the height of the row and the others
                        // each need centering against it.
                        HorizontalLayout {
                            alignment: center;
                            spacing: Theme.gap;

                            VerticalLayout {
                                alignment: center;

                                IconButton {
                                    glyph: Icons.shuffle;
                                    label: root.shuffle ? "Shuffle, on" : "Shuffle, off";
                                    active: root.shuffle;
                                    enabled: root.has-selection && root.current.reachable;
                                    clicked => { root.toggle-shuffle(root.current.id); }
                                }
                            }

                            VerticalLayout {
                                alignment: center;

                                IconButton {
                                    glyph: Icons.previous;
                                    label: "Previous track";
                                    enabled: root.has-selection && root.current.reachable;
                                    clicked => { root.back(root.current.id); }
                                }
                            }

                            IconButton {
                                glyph: root.current.playing ? Icons.pause : Icons.play;
                                label: root.current.playing ? "Pause" : "Play";
                                primary: true;
                                size: 44px;
                                glyph-size: 19px;
                                enabled: root.has-selection && root.current.reachable;
                                clicked => { root.toggle(root.current.id); }
                            }

                            VerticalLayout {
                                alignment: center;

                                IconButton {
                                    glyph: Icons.next;
                                    label: "Next track";
                                    enabled: root.has-selection && root.current.reachable;
                                    clicked => { root.skip(root.current.id); }
                                }
                            }

                            VerticalLayout {
                                alignment: center;

                                IconButton {
                                    glyph: root.repeat == 1 ? Icons.repeat-one : Icons.repeat;
                                    // Three states, so the name has to carry
                                    // which one it is in: a glyph that has
                                    // changed says nothing to anyone reading.
                                    label: root.repeat == 0
                                        ? "Repeat all"
                                        : (root.repeat == 1 ? "Repeat one" : "Repeat off");
                                    active: root.repeat != 2;
                                    enabled: root.has-selection && root.current.reachable;
                                    clicked => { root.cycle-repeat(root.current.id); }
                                }
                            }
                        }

                        HorizontalLayout {
                            alignment: center;
                            // 4px, not 8: sixteen pixels of air was holding
                            // apart two halves of one reading.
                            spacing: Theme.tight;
                            padding-top: 2px;

                            Text {
                                text: root.duration > 0 ? root.position-text : "";
                                font-size: Theme.small-size;
                                // The number that moves is the brighter of the
                                // two; the total it is measured against sits back.
                                color: Theme.dim;
                                // The total is fixed for the length of a track
                                // and never shorter than the position, so it
                                // sizes the box both numbers sit in. Geist's
                                // figures are proportional and unusually so —
                                // its "1" is 42% narrower than its "0" — so
                                // without a fixed box this whole group slid
                                // sideways on every tick, all through every
                                // track, in the one bar that is always on
                                // screen. 0:59 to 1:00 alone moved it 1.8px.
                                width: total.preferred-width;
                                horizontal-alignment: right;
                            }

                            Text {
                                text: root.duration > 0 ? "/" : "";
                                font-size: Theme.small-size;
                                color: Theme.faint;
                            }

                            total := Text {
                                text: root.duration > 0 ? root.duration-text : "";
                                font-size: Theme.small-size;
                                color: Theme.faint;
                            }
                        }
                    }

                    // Which player, and how loud.
                    HorizontalLayout {
                        spacing: Theme.gap;
                        width: 420px;

                        Rectangle { horizontal-stretch: 1; }

                        // Which player, and everything about the others.
                        //
                        // The players hang off this pill rather than sitting
                        // pinned open in the sidebar: on a one-speaker system a
                        // permanent list of one is furniture, and this is where
                        // the official controller keeps its picker too.
                        VerticalLayout {
                            alignment: center;

                            Rectangle {
                                height: 32px;
                                width: name.preferred-width + 62px;
                                border-radius: self.height / 2;
                                background: pick.pressed
                                    ? Theme.pressed
                                    : (pick.has-hover ? Theme.glass-raised : Theme.raised);
                                border-width: 1px;
                                border-color: Theme.border;
                                animate background { duration: Theme.quick; easing: ease-out; }

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 6px;
                                    padding-left: 11px;
                                    padding-right: 9px;

                                    VerticalLayout {
                                        alignment: center;

                                        Icon {
                                            glyph: root.current.in-group ? Icons.grouped : Icons.player;
                                            width: 14px;
                                            height: 14px;
                                            tint: Theme.dim;
                                        }
                                    }

                                    name := Text {
                                        text: root.has-selection ? root.current.name : "No player";
                                        font-size: Theme.small-size;
                                        color: Theme.text;
                                        vertical-alignment: center;
                                    }

                                    VerticalLayout {
                                        alignment: center;

                                        Icon {
                                            glyph: Icons.expand;
                                            width: 13px;
                                            height: 13px;
                                            tint: Theme.faint;
                                        }
                                    }
                                }

                                pick := TouchArea {
                                    // Named after the player it is showing, so
                                    // the pill says which one is being
                                    // controlled as well as offering the swap.
                                    accessible-role: button;
                                    accessible-label: "Player: " + root.current.name;
                                    accessible-action-default => { players.show(); }
                                    clicked => { players.show(); }
                                }

                                players := PopupWindow {
                                    // Opens upward: it hangs off a control that
                                    // sits on the bottom edge of the window.
                                    x: -24px;
                                    y: -1 * self.height - 10px;
                                    width: 340px;
                                    // Height is deliberately absent. It used to
                                    // be `devices.length * 132px + 108px`, and
                                    // 108px did not cover the header, the two
                                    // bulk buttons and the address field that
                                    // sit around the list — so the fixed parts
                                    // were clipped by the popup that was meant
                                    // to hold them. With no player at all there
                                    // was no list to absorb the shortfall and
                                    // the buttons were cut in half.
                                    //
                                    // Sizing the list instead lets the popup
                                    // take its own preferred height, so the
                                    // chrome is measured rather than guessed
                                    // and cannot fall out of step with it again.
                                    // Measured: 140px of chrome, not 108px.
                                    close-policy: PopupClosePolicy.close-on-click-outside;

                                    Rectangle {
                                        background: Theme.surface;
                                        border-radius: Theme.radius;
                                        border-width: 1px;
                                        border-color: Theme.border-strong;
                                        clip: true;

                                        VerticalLayout {
                                            padding: Theme.gap;
                                            spacing: Theme.tight;

                                            HorizontalLayout {
                                                padding-left: Theme.gap;

                                                VerticalLayout {
                                                    alignment: center;
                                                    SectionLabel { text: "PLAYERS"; }
                                                }

                                                Rectangle { horizontal-stretch: 1; }

                                                VerticalLayout {
                                                    alignment: center;

                                                    Text {
                                                        text: root.players-line;
                                                        font-size: Theme.micro-size;
                                                        color: Theme.faint;
                                                        vertical-alignment: center;
                                                    }
                                                }

                                                IconButton {
                                                    glyph: Icons.rescan;
                                                    label: "Look for players again";
                                                    size: 26px;
                                                    glyph-size: 13px;
                                                    clicked => { root.rescan(); }
                                                }
                                            }

                                            // Two and a half cards: the half is
                                            // the affordance, since a list cut on
                                            // a card boundary looks complete when
                                            // it is not. 330px of list under the
                                            // 140px of chrome measured above puts
                                            // the whole popup at the same 470px
                                            // it was meant to stop at.
                                            ListView {
                                                height: min(root.devices.length * 132px, 330px);
                                                accessible-role: list;
                                                accessible-item-count: root.devices.length;

                                                for device[i] in root.devices: DeviceCard {
                                                    device: device;
                                                    accessible-item-index: i;
                                                    cover: root.device-covers[i];
                                                    selected: i == root.selected;
                                                    picked => {
                                                        root.selected = i;
                                                        root.select(device.id);
                                                        players.close();
                                                    }
                                                    volume-changed(v) => { root.set-volume(device.id, v); }
                                                    toggle-mute => { root.toggle-mute(device.id); }
                                                    toggle-group => { root.toggle-group(device.id); }
                                                }
                                            }

                                            // Acting on every player at once,
                                            // which is the one thing the list
                                            // above cannot express: each card
                                            // speaks only for its own player.
                                            HorizontalLayout {
                                                spacing: Theme.tight;
                                                padding-top: Theme.tight;
                                                padding-bottom: Theme.tight;

                                                WideButton {
                                                    glyph: Icons.group;
                                                    label: "GROUP ALL";
                                                    clicked => {
                                                        root.group-all();
                                                        players.close();
                                                    }
                                                }

                                                WideButton {
                                                    glyph: Icons.pause;
                                                    label: "PAUSE ALL";
                                                    clicked => {
                                                        root.pause-all();
                                                        players.close();
                                                    }
                                                }
                                            }

                                            // For a player discovery cannot
                                            // reach: asleep at startup, on
                                            // another subnet, or behind
                                            // something that eats broadcast.
                                            LineEdit {
                                                placeholder-text: "Add a player by address";
                                                font-size: Theme.small-size;
                                                accepted(text) => {
                                                    root.add-player(text);
                                                    self.text = "";
                                                    players.close();
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            width: 208px;

                            Level {
                                value: root.current.volume;
                                muted: root.current.muted;
                                enabled: root.current.reachable;
                                changed(v) => { root.set-volume(root.current.id, v); }
                                toggle-mute => { root.toggle-mute(root.current.id); }
                            }
                        }

                        // Past the volume rather than before it: the queue is
                        // the pane on that side of the window, so the control
                        // that hides it belongs on the same side.
                        VerticalLayout {
                            alignment: center;
                            padding-left: Theme.gap;

                            IconButton {
                                glyph: Icons.queue;
                                label: root.queue-shown ? "Hide the play queue" : "Show the play queue";
                                size: 34px;
                                glyph-size: 17px;
                                tint: root.queue-shown ? Theme.text : Theme.dim;
                                active: root.queue-shown;
                                clicked => { root.queue-shown = !root.queue-shown; }
                            }
                        }

                    }
                }
            }
        }
    }

    // The context menu for a queue row.
    //
    // Drawn over the window rather than pushed onto the browse screen, which
    // is where this used to go: the menu is about a track in the list on the
    // right, and answering it by replacing the page on the left meant the
    // press appeared to do nothing at all.
    //
    // Anchored to the row that opened it and then clamped, so a menu opened
    // against the last row in a full queue still sits on screen.
    // The same two-element shape as Now Playing, for the same two reasons: the
    // outer carries the fade and is always here, the contents stay behind an
    // `if` so a closed menu holds neither rows nor a hit target.
    menu-fade := Rectangle {
        opacity: root.queue-menu-open ? 1.0 : 0.0;
        visible: self.opacity > 0.0;

        animate opacity {
            duration: Theme.quick;
            easing: ease-out;
        }

        if menu-fade.visible: Rectangle {
        // Anything outside the panel dismisses it.
        //
        // Named, because for anyone stepping through the tree this is the only
        // way out: nothing else closes the menu, and an unnamed hit target
        // covering the window is a dead end rather than a dismissal.
        TouchArea {
            accessible-role: button;
            accessible-label: "Close this menu";
            accessible-action-default => { root.queue-menu-open = false; }
            clicked => { root.queue-menu-open = false; }
        }

        Rectangle {
            x: Math.clamp(
                root.queue-menu-right - self.width,
                Theme.room,
                Math.max(Theme.room, parent.width - self.width - Theme.room));
            // Rises the last few pixels into place rather than appearing at
            // rest, which is what makes it read as coming from the row.
            y: Math.clamp(root.queue-menu-y + 34px,
                Theme.room,
                Math.max(Theme.room, parent.height - self.height - 96px))
                + (root.queue-menu-open ? 0px : 10px);

            animate y {
                duration: Theme.quick;
                easing: ease-out;
            }
            width: 320px;
            height: header.preferred-height + rows.preferred-height + 2 * Theme.gap;
            border-radius: Theme.radius;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 28px;
            drop-shadow-color: #0000008c;
            clip: true;

            VerticalLayout {
                padding: Theme.gap;
                spacing: Theme.tight;

                header := HorizontalLayout {
                    padding-left: Theme.tight;
                    padding-bottom: Theme.tight;
                    spacing: Theme.gap;

                    // Only where the menu came with one. A browse row's menu
                    // often has no artwork at all, and a placeholder note
                    // beside the title is worse than the title on its own.
                    if root.queue-menu-cover.width > 0: Artwork {
                        source: root.queue-menu-cover;
                        corner: Theme.radius-small;
                        width: 44px;
                        height: 44px;
                    }

                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        min-width: 0px;

                        Text {
                            text: root.queue-menu-title;
                            font-size: Theme.body-size;
                            font-weight: 600;
                            color: Theme.text;
                            overflow: elide;
                        }

                        if root.queue-menu-subtitle != "": Text {
                            text: root.queue-menu-subtitle;
                            font-size: Theme.small-size;
                            color: Theme.dim;
                            overflow: elide;
                        }
                    }
                }

                rows := VerticalLayout {
                    for entry[i] in root.queue-menu-rows: Rectangle {
                        // The rows of the context menu, which are the whole of
                        // what it offers. Unnamed they were fourteen anonymous
                        // hit targets over a track nobody could identify.
                        accessible-role: list-item;
                        accessible-label: entry.label;
                        accessible-item-index: i;
                        accessible-action-default => {
                            root.queue-menu-open = false;
                            root.queue-menu-activate(entry.index);
                        }
                        height: 44px;
                        border-radius: Theme.radius-small;
                        background: choose.has-hover ? Theme.hover : transparent;

                        choose := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.queue-menu-open = false;
                                root.queue-menu-activate(entry.index);
                            }
                        }

                        HorizontalLayout {
                            padding-left: Theme.tight;
                            padding-right: Theme.tight;
                            spacing: Theme.pad;

                            VerticalLayout {
                                alignment: center;
                                Icon {
                                    glyph: entry.glyph;
                                    tint: Theme.dim;
                                    width: 18px;
                                    height: 18px;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                min-width: 0px;

                                Text {
                                    accessible-role: none;
                                    text: entry.label;
                                    font-size: Theme.body-size;
                                    color: Theme.text;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }
        }
        }
    }

    // Whatever just happened, said once and then gone.
    //
    // Every `say` in the backend lands here. Without it they went nowhere at
    // all: the confirmations the player writes itself — "Added to Favourites"
    // — and the reason a settings write failed were both computed, published,
    // and then drawn by nothing.
    // Switching input stops the music, and the inputs sit in the sidebar
    // among things that do not — one row below Home, one above a service that
    // merely opens a screen. Easy to hit on the way somewhere else, and there
    // is no undo for a speaker that has stopped.
    //
    // Only raised while something is actually playing; the backend decides
    // that, and a silent speaker switches without being asked.
    // The player's own question, drawn the same way as the one above but with
    // nothing of ours in it: the title, the sentence and every button come off
    // the wire. Dismissing runs no action, which is what its `closeAction` of
    // type `nil` asks for.
    if root.dialog-open: Rectangle {
        background: Theme.scrim;

        // As on the queue's menu: the scrim is the way out, so it says so.
        TouchArea {
            accessible-role: button;
            accessible-label: "Dismiss";
            accessible-action-default => { root.dialog-press(-1); }
            clicked => { root.dialog-press(-1); }
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 400px;
            height: asked.preferred-height;
            border-radius: Theme.radius;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            // Its own, so a press inside the card does not reach the
            // dismissing area behind it.
            TouchArea {}

            asked := VerticalLayout {
                padding: Theme.room;
                spacing: Theme.gap;

                Text {
                    text: root.dialog-title;
                    font-size: Theme.title-size;
                    font-weight: 600;
                    color: Theme.text;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                if root.dialog-body != "": Text {
                    text: root.dialog-body;
                    font-size: Theme.body-size;
                    color: Theme.dim;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: Theme.gap;
                    padding-top: Theme.tight;

                    for button in root.dialog-buttons: PillButton {
                        label: button.label;
                        primary: button.destructive;
                        clicked => { root.dialog-press(button.index); }
                    }
                }
            }
        }
    }

    if root.update-notice != "": Rectangle {
        background: Theme.scrim;

        // Dismissable by clicking away, unlike the install question below:
        // this one is an offer, and ignoring an offer should be easy.
        TouchArea {
            clicked => {
                root.update-notice = "";
                root.answer-update-notice(false);
            }
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 400px;
            height: notice.preferred-height;
            border-radius: Theme.radius;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 32px;
            drop-shadow-color: #000000a6;

            TouchArea { }

            notice := VerticalLayout {
                padding: Theme.room;
                spacing: Theme.pad;

                Text {
                    text: "Update available for " + root.update-notice;
                    font-size: Theme.title-size;
                    font-weight: 600;
                    color: Theme.text;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                Text {
                    text: "The player has newer firmware waiting.";
                    font-size: Theme.small-size;
                    color: Theme.dim;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: Theme.gap;

                    PillButton {
                        label: "Show me";
                        primary: true;
                        clicked => {
                            root.update-notice = "";
                            root.answer-update-notice(true);
                        }
                    }

                    PillButton {
                        label: "Not now";
                        clicked => {
                            root.update-notice = "";
                            root.answer-update-notice(false);
                        }
                    }
                }
            }
        }
    }

    if root.confirm-upgrade != "": Rectangle {
        background: Theme.scrim;

        // No dismiss-by-scrim here, unlike the input question below. Answering
        // this one by clicking past it is not a thing to make easy.
        TouchArea { }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 420px;
            height: firmware.preferred-height;
            border-radius: Theme.radius;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 32px;
            drop-shadow-color: #000000a6;

            TouchArea { }

            firmware := VerticalLayout {
                padding: Theme.room;
                spacing: Theme.pad;

                Text {
                    text: "Update " + root.confirm-upgrade + "?";
                    font-size: Theme.title-size;
                    font-weight: 600;
                    color: Theme.text;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                Text {
                    text: "This installs new firmware and restarts the player. "
                        + "It takes a few minutes and cannot be stopped once it "
                        + "starts. Do not power the player off while it runs.";
                    font-size: Theme.small-size;
                    color: Theme.dim;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: Theme.gap;

                    PillButton {
                        label: "Update";
                        primary: true;
                        clicked => {
                            root.confirm-upgrade = "";
                            root.answer-upgrade(true);
                        }
                    }

                    PillButton {
                        label: "Not now";
                        clicked => {
                            root.confirm-upgrade = "";
                            root.answer-upgrade(false);
                        }
                    }
                }
            }
        }
    }

    if root.confirm-input != "": Rectangle {
        background: Theme.scrim;

        TouchArea {
            clicked => {
                root.confirm-input = "";
                root.answer-input(false);
            }
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 380px;
            height: ask.preferred-height;
            border-radius: Theme.radius;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 32px;
            drop-shadow-color: #000000a6;

            // Swallows presses that would otherwise reach the scrim behind and
            // dismiss the question by accident.
            TouchArea { }

            ask := VerticalLayout {
                padding: Theme.room;
                spacing: Theme.pad;

                Text {
                    text: "Switch to " + root.confirm-input + "?";
                    font-size: Theme.title-size;
                    font-weight: 600;
                    color: Theme.text;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                Text {
                    text: "This stops what is playing now.";
                    font-size: Theme.small-size;
                    color: Theme.dim;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: Theme.gap;

                    PillButton {
                        label: "Switch";
                        primary: true;
                        clicked => {
                            root.confirm-input = "";
                            root.answer-input(true);
                        }
                    }

                    PillButton {
                        label: "Cancel";
                        clicked => {
                            root.confirm-input = "";
                            root.answer-input(false);
                        }
                    }
                }
            }
        }
    }

    // What the indexing strip last said, for the same reason as `said` below.
    property <string> indexed;

    changed indexing => {
        if (root.indexing != "") {
            root.indexed = root.indexing;
        }
    }

    // The upgrade strip's words, held for the same reason as `indexed`: the
    // strip animates its own collapse, and a label bound straight through
    // would blank on the frame the upgrade ended and leave an empty box
    // shrinking. Composed here rather than in Rust so the two halves stay
    // separate properties — the player's name is also what the row badge and
    // the toasts use.
    property <string> upgrade-said;

    changed upgrading-stage => {
        if (root.upgrading-player != "") {
            root.upgrade-said = root.upgrading-player + " — " + root.upgrading-stage;
        }
    }

    // The last thing said, held past the moment it is cleared.
    //
    // The fade out needs words to fade: binding the label straight to
    // `status-line` emptied it the instant the timer fired, so the toast spent
    // its whole exit as a blank pill.
    property <string> said;

    changed status-line => {
        if (root.status-line != "") {
            root.said = root.status-line;
        }
    }

    toast := Rectangle {
        opacity: root.status-line != "" ? 1.0 : 0.0;
        visible: self.opacity > 0.0;

        animate opacity {
            duration: Theme.quick;
            easing: ease-out;
        }

        if toast.visible: Rectangle {
        x: (parent.width - self.width) / 2;
        // Clear of the transport bar, which is the one thing always at the
        // bottom of the window — and of the indexing strip above it, which is
        // not always there. Without the second term the two overlapped, and
        // the message a reindex produces is exactly the one that lands while
        // the strip is up.
        //
        // Animated on the same curve as the strip, so they move together
        // rather than the message jumping when indexing starts or stops.
        y: parent.height - 88px - (root.indexing != "" ? 52px : 0px)
            - (root.upgrading-player != "" ? 52px : 0px)
            - self.height - Theme.pad;

        animate y {
            duration: Theme.settle;
            easing: ease-out;
        }
        width: Math.min(line.preferred-width, parent.width - 2 * Theme.room);
        height: 38px;
        border-radius: self.height / 2;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 20px;
        drop-shadow-color: #00000059;

        line := HorizontalLayout {
            alignment: center;
            padding-left: Theme.room;
            padding-right: Theme.room;

            Text {
                text: root.said;
                font-size: Theme.small-size;
                color: Theme.text;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        Timer {
            interval: 4s;
            running: root.status-line != "";
            triggered => { root.status-line = ""; }
        }
        }
    }
}
